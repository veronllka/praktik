<Window x:Class="praktik.MaterialRequestRegistryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Реестр заявок на материалы"
        Height="800"
        Width="1400"
        MinHeight="680"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource GlassWindowStyle}">
    <Grid Style="{StaticResource GlassWindowRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource GlassToolbarStyle}">
            <StackPanel>
                <TextBlock Text="Фильтры"
                           Style="{StaticResource SubHeaderTextStyle}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Статус" Style="{StaticResource GlassFieldLabelStyle}"/>
                        <ComboBox x:Name="cbStatusFilter"
                                  ToolTip="Выберите статус заявки"
                                  SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="Все" IsSelected="True"/>
                            <ComboBoxItem Content="Отправлена" Tag="Submitted"/>
                            <ComboBoxItem Content="Согласована" Tag="Approved"/>
                            <ComboBoxItem Content="Отклонена" Tag="Rejected"/>
                            <ComboBoxItem Content="Выдана" Tag="Issued"/>
                            <ComboBoxItem Content="Доставлена" Tag="Delivered"/>
                            <ComboBoxItem Content="Закрыта" Tag="Closed"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Объект" Style="{StaticResource GlassFieldLabelStyle}"/>
                        <ComboBox x:Name="cbSiteFilter"
                                  ToolTip="Выберите объект для фильтра"
                                  SelectionChanged="Filter_Changed">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SiteName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="Бригада" Style="{StaticResource GlassFieldLabelStyle}"/>
                        <ComboBox x:Name="cbCrewFilter"
                                  ToolTip="Выберите бригаду для фильтра"
                                  SelectionChanged="Filter_Changed">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CrewName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                        <TextBlock Text="Требуется не раньше" Style="{StaticResource GlassFieldLabelStyle}"/>
                        <DatePicker x:Name="dpRequiredDateFilter"
                                    ToolTip="Показывать заявки с этой даты и позже"
                                    SelectedDateChanged="Filter_Changed"/>
                    </StackPanel>
                    <Button x:Name="btnResetFilter"
                            Grid.Column="4"
                            Content="Сбросить"
                            Click="BtnResetFilter_Click"
                            Style="{StaticResource AppOutlinedButton}"
                            VerticalAlignment="Bottom"
                            Margin="0,0,8,0"/>
                    <Button x:Name="btnAddRequest"
                            Grid.Column="5"
                            Content="Добавить заявку"
                            Click="BtnAddRequest_Click"
                            VerticalAlignment="Bottom"
                            Style="{StaticResource AppRaisedButton}"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource GlassDataGridHostStyle}">
            <Grid>
                <DataGrid x:Name="dgRequests"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionChanged="DgRequests_SelectionChanged"
                          MouseDoubleClick="DgRequests_MouseDoubleClick">
                    <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding RequestId}" Width="60" Visibility="Collapsed"/>
                    <DataGridTextColumn Header="Задача" Binding="{Binding TaskTitle}" Width="2*"/>
                    <DataGridTextColumn Header="Объект" Binding="{Binding SiteName}" Width="1.2*"/>
                    <DataGridTextColumn Header="Бригада" Binding="{Binding CrewName}" Width="1.2*"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding StatusDisplay}" Width="130"/>
                    <DataGridTextColumn Header="Требуется к" Binding="{Binding RequiredDateDisplay}" Width="130"/>
                    <DataGridTextColumn Header="Создана" Binding="{Binding CreatedAtDisplay}" Width="140"/>
                    <DataGridTextColumn Header="Позиций" Binding="{Binding ItemsCount}" Width="90"/>
                    <DataGridTemplateColumn Header="Индикатор" Width="230" MinWidth="230">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="4,2">
                                    <Border Background="{Binding IndicatorColor}"
                                            Padding="16,6"
                                            CornerRadius="10"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Width="160">
                                        <TextBlock Text="{Binding IndicatorText}"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   TextWrapping="NoWrap"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource AppDataGridCellStyle}">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </DataGridTemplateColumn.CellStyle>
                    </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="txtRequestsEmptyState"
                           Text="Нет заявок для отображения"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppMutedTextBrush}"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>

        <Border x:Name="detailsPanel"
                Grid.Row="2"
                Visibility="Collapsed"
                Style="{StaticResource GlassFooterBarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock x:Name="txtSelectedRequestInfo"
                               Text="Выберите заявку для просмотра деталей"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               Foreground="{DynamicResource AppMutedTextBrush}"/>
                    <DataGrid x:Name="dgRequestItems"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              MaxHeight="120"
                              Visibility="Collapsed">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Материал" Binding="{Binding Material.Name}" Width="*"/>
                            <DataGridTextColumn Header="Ед. изм." Binding="{Binding Material.Unit}" Width="80"/>
                            <DataGridTextColumn Header="Количество" Binding="{Binding Qty}" Width="100"/>
                            <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>

                <WrapPanel Grid.Column="1"
                           Orientation="Horizontal"
                           HorizontalAlignment="Right">
                    <Button x:Name="btnApprove"
                            Content="Согласовать"
                            Click="BtnApprove_Click"
                            Style="{StaticResource AppRaisedButton}"
                            Margin="0,0,8,8"
                            Width="150"/>
                    <Button x:Name="btnReject"
                            Content="Отклонить"
                            Click="BtnReject_Click"
                            Style="{StaticResource GlassDangerButtonStyle}"
                            Margin="0,0,8,8"
                            Width="150"/>
                    <Button x:Name="btnIssue"
                            Content="Отметить выдачу"
                            Click="BtnIssue_Click"
                            Style="{StaticResource AppRaisedButton}"
                            Margin="0,0,8,8"
                            Width="160"/>
                    <Button x:Name="btnDeliver"
                            Content="Отметить доставку"
                            Click="BtnDeliver_Click"
                            Style="{StaticResource AppRaisedButton}"
                            Margin="0,0,8,8"
                            Width="170"/>
                    <Button x:Name="btnClose"
                            Content="Закрыть заявку"
                            Click="BtnClose_Click"
                            Style="{StaticResource AppOutlinedButton}"
                            Margin="0,0,8,8"
                            Width="150"/>
                    <Button x:Name="btnEdit"
                            Content="Редактировать"
                            Click="BtnEdit_Click"
                            Style="{StaticResource AppOutlinedButton}"
                            Margin="0,0,8,8"
                            Width="150"/>
                    <Button x:Name="btnExport"
                            Content="Экспорт"
                            Click="BtnExport_Click"
                            Style="{StaticResource AppRaisedButton}"
                            Margin="0,0,0,8"
                            Width="130"/>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
