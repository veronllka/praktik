<Window x:Class="praktik.CrewMemberCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новый сотрудник"
        Height="380"
        Width="580"
        MinHeight="360"
        MinWidth="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource GlassWindowStyle}">
    <Grid Style="{StaticResource GlassWindowRootStyle}">
        <Border Style="{StaticResource GlassDialogCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                    <TextBlock Text="Добавление сотрудника"
                               Style="{StaticResource HeaderTextStyle}"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="Укажите ФИО и дату включения в бригаду."
                               Foreground="{DynamicResource AppMutedTextBrush}"
                               FontSize="13"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,0,0,14">
                    <TextBlock Text="ФИО сотрудника" Style="{StaticResource GlassFieldLabelStyle}"/>
                    <TextBox x:Name="txtFullName"
                             ToolTip="ФИО сотрудника"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,0,0,14">
                    <TextBlock Text="Дата включения" Style="{StaticResource GlassFieldLabelStyle}"/>
                    <DatePicker x:Name="dpJoinedAt"
                                ToolTip="Дата включения в бригаду"/>
                </StackPanel>

                <Border Grid.Row="3"
                        Background="{DynamicResource AppGlassSoftBrush}"
                        BorderBrush="{DynamicResource AppGlassBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14">
                    <TextBlock Text="Логин и пароль для сотрудника создаются автоматически."
                               Foreground="{DynamicResource AppMutedTextBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"/>
                </Border>

                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,18,0,0">
                    <Button Content="Отмена"
                            Width="132"
                            Margin="0,0,10,0"
                            Style="{StaticResource AppOutlinedButton}"
                            IsCancel="True"/>
                    <Button Content="Сохранить"
                            Width="132"
                            Style="{StaticResource AppRaisedButton}"
                            Click="BtnSave_Click"
                            IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
