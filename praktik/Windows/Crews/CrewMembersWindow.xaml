<Window x:Class="praktik.CrewMembersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Состав бригады"
        Height="640"
        Width="1000"
        MinHeight="540"
        MinWidth="880"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource GlassWindowStyle}">
    <Grid Style="{StaticResource GlassWindowRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="4,0,4,16">
            <TextBlock x:Name="txtTitle"
                       Text="Состав бригады"
                       Style="{StaticResource HeaderTextStyle}"
                       Margin="0,0,0,6"/>
            <TextBlock Text="Управление участниками и историей включения в бригаду."
                       FontSize="13"
                       Foreground="{DynamicResource AppMutedTextBrush}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource GlassToolbarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Дата включения" Style="{StaticResource GlassFieldLabelStyle}"/>
                    <DatePicker x:Name="dpJoinedAt"
                                ToolTip="Дата включения сотрудника в бригаду"
                                VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="btnCreateMember"
                        Grid.Column="2"
                        Content="Добавить сотрудника"
                        MinWidth="190"
                        Style="{StaticResource AppRaisedButton}"
                        Click="BtnAddMember_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource GlassDataGridHostStyle}">
            <Grid>
                <DataGrid x:Name="dgCrewMembers"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionChanged="DgCrewMembers_SelectionChanged"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Сотрудник" Binding="{Binding EmployeeName}" Width="2.6*"/>
                        <DataGridTextColumn Header="Дата включения" Binding="{Binding JoinedAtDisplay}" Width="1.2*"/>
                        <DataGridTextColumn Header="Дата выбытия" Binding="{Binding LeftAtDisplay}" Width="1.2*"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding MemberState}" Width="1*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="txtNoData"
                           Text="Подходящих участников не найдено"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="15"
                           Foreground="{DynamicResource AppMutedTextBrush}"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource GlassFooterBarStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Дата выбытия" Style="{StaticResource GlassFieldLabelStyle}"/>
                    <DatePicker x:Name="dpLeftAt"
                                ToolTip="Дата исключения сотрудника из бригады"
                                VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="btnRemoveMember"
                        Grid.Column="1"
                        Content="Исключить из бригады"
                        Margin="12,0,0,0"
                        MinWidth="190"
                        Style="{StaticResource GlassDangerButtonStyle}"
                        Click="BtnRemoveMember_Click"/>

                <CheckBox x:Name="chkShowHistory"
                          Grid.Column="2"
                          Content="Показывать историю (выбывшие)"
                          Margin="18,0,0,0"
                          VerticalAlignment="Center"
                          Checked="ChkShowHistory_Changed"
                          Unchecked="ChkShowHistory_Changed"/>

                <Button Grid.Column="3"
                        Content="Закрыть"
                        MinWidth="120"
                        Style="{StaticResource AppOutlinedButton}"
                        IsCancel="True"/>
            </Grid>
        </Border>
    </Grid>
</Window>
