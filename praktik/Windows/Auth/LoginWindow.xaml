<Window x:Class="praktik.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="Планировщик работ"
        Height="700"
        Width="560"
        MinHeight="560"
        MinWidth="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        FontFamily="{DynamicResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="LoginTextBrush" Color="#253044"/>
        <SolidColorBrush x:Key="LoginMutedBrush" Color="#74829B"/>
        <SolidColorBrush x:Key="LoginPlaceholderBrush" Color="#5D6B82"/>
        <SolidColorBrush x:Key="LoginLinkBrush" Color="#6D96F4"/>
        <SolidColorBrush x:Key="LoginInputBrush" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="LoginInputHoverBrush" Color="#34FFFFFF"/>
        <SolidColorBrush x:Key="LoginInputBorderBrush" Color="#82FFFFFF"/>

        <LinearGradientBrush x:Key="LoginSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#58EEF4FF" Offset="0"/>
            <GradientStop Color="#50E6EFFF" Offset="0.48"/>
            <GradientStop Color="#56E2DCF8" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="LoginAvatarBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#9090CCFF" Offset="0"/>
            <GradientStop Color="#6878EAFF" Offset="0.5"/>
            <GradientStop Color="#8860D8FF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="LoginPrimaryGradientBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#78A2F4" Offset="0"/>
            <GradientStop Color="#9588EA" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="LoginPrimaryHoverBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#6C97EC" Offset="0"/>
            <GradientStop Color="#8678DD" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#3F4656"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#38FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseTitleBarButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D9485C"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LoginPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="56"/>
            <Setter Property="Background" Value="{StaticResource LoginPrimaryGradientBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#5AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource LoginPrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="56"/>
            <Setter Property="Background" Value="#34FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource LoginTextBrush}"/>
            <Setter Property="BorderBrush" Value="#BFFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#52FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#24FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginFieldIconStyle" TargetType="TextBlock">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Opacity" Value="0.88"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LoginMaterialIconStyle" TargetType="{x:Type iconPacks:PackIconMaterial}">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Opacity" Value="0.88"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LoginFlatTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource LoginTextBrush}"/>
            <Setter Property="CaretBrush" Value="#6D96F4"/>
            <Setter Property="SelectionBrush" Value="#BBD0FF"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <Style x:Key="LoginFlatPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource LoginTextBrush}"/>
            <Setter Property="CaretBrush" Value="#6D96F4"/>
            <Setter Property="SelectionBrush" Value="#BBD0FF"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <Style x:Key="LoginPlaceholderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource LoginPlaceholderBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style x:Key="LoginCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource LoginTextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border x:Name="CheckMarkBox"
                                    Width="18"
                                    Height="18"
                                    CornerRadius="4"
                                    Background="#18FFFFFF"
                                    BorderBrush="#D6FFFFFF"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" x:Name="CheckGlyph"
                                                            Width="12"
                                                            Height="12"
                                                            Foreground="#6D96F4"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Opacity="0"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckMarkBox" Property="BorderBrush" Value="#FFFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMarkBox" Property="Background" Value="#DFFFFFFF"/>
                                <Setter TargetName="CheckGlyph" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="LoginPanel"
                Margin="0"
                Background="{StaticResource LoginSurfaceBrush}"
                BorderThickness="0"
                CornerRadius="14"
                MouseLeftButtonDown="LoginPanel_MouseLeftButtonDown">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.RowSpan="2"
                        CornerRadius="14"
                        Background="#08FFFFFF"
                        IsHitTestVisible="False"/>

                <Grid x:Name="TitleBar"
                      Grid.Row="0"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="18,0,0,0">
                        <iconPacks:PackIconMaterial Kind="AccountHardHat"
                                                    Width="18"
                                                    Height="18"
                                                    Foreground="#111827"
                                                    Opacity="0.9"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,12,0"/>
                        <TextBlock Text="Планировщик работ"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Foreground="#303747"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0">
                        <Button Click="BtnMinimize_Click"
                                Style="{StaticResource TitleBarButtonStyle}"
                                ToolTip="Свернуть">
                            <TextBlock Text="&#xE738;" FontFamily="Segoe MDL2 Assets"
                                                        Width="14"
                                                        Height="14"
                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button Click="BtnMaximize_Click"
                                Style="{StaticResource TitleBarButtonStyle}"
                                ToolTip="Развернуть">
                            <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets"
                                                        Width="13"
                                                        Height="13"
                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button Click="BtnClose_Click"
                                Style="{StaticResource CloseTitleBarButtonStyle}"
                                ToolTip="Закрыть">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                                        Width="15"
                                                        Height="15"
                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              Margin="40,4,40,16"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              PanningMode="None">
                    <StackPanel VerticalAlignment="Top"
                                Margin="0">
                        <Grid x:Name="AvatarGrid"
                              Width="104"
                              Height="104"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,8"
                              ClipToBounds="False"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="AvatarFloat" Y="0"/>
                            </Grid.RenderTransform>
                            <Grid.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <!-- Floating animation -->
                                            <DoubleAnimation Storyboard.TargetName="AvatarFloat"
                                                             Storyboard.TargetProperty="Y"
                                                             From="0" To="-8" Duration="0:0:2"
                                                             AutoReverse="True">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <!-- Outer ring pulse -->
                                            <DoubleAnimation Storyboard.TargetName="OuterRing"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.15" To="0.55" Duration="0:0:1.6"
                                                             AutoReverse="True">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <!-- Middle ring pulse (offset) -->
                                            <DoubleAnimation Storyboard.TargetName="MiddleRing"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.25" To="0.65" Duration="0:0:1.6"
                                                             BeginTime="0:0:0.4"
                                                             AutoReverse="True">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Grid.Triggers>

                            <!-- Outer glow ring -->
                            <Ellipse x:Name="OuterRing"
                                     Width="98" Height="98"
                                     Fill="Transparent"
                                     Stroke="#80A0D8FF"
                                     StrokeThickness="1.5"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Opacity="0.3">
                                <Ellipse.Effect>
                                    <BlurEffect Radius="3"/>
                                </Ellipse.Effect>
                            </Ellipse>

                            <!-- Middle ring -->
                            <Ellipse x:Name="MiddleRing"
                                     Width="84" Height="84"
                                     Fill="Transparent"
                                     Stroke="#A08EC8FF"
                                     StrokeThickness="1"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Opacity="0.4"/>

                            <!-- Main avatar circle -->
                            <Ellipse Width="72" Height="72"
                                     Fill="{StaticResource LoginAvatarBrush}"
                                     Stroke="#C0FFFFFF"
                                     StrokeThickness="1.5"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#5060B8"
                                                      BlurRadius="28"
                                                      ShadowDepth="4"
                                                      Opacity="0.45"/>
                                </Ellipse.Effect>
                            </Ellipse>

                            <iconPacks:PackIconMaterial Kind="AccountHardHat"
                                                        Width="32"
                                                        Height="32"
                                                        Foreground="White"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Opacity="0.94"/>
                        </Grid>

                        <TextBlock Text="Планировщик работ"
                                   HorizontalAlignment="Center"
                                   FontSize="25"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource LoginTextBrush}"
                                   TextAlignment="Center"
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="Войдите в систему, чтобы продолжить работу"
                                   HorizontalAlignment="Center"
                                   FontSize="15"
                                   Foreground="{StaticResource LoginMutedBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16"/>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Логин"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource LoginTextBrush}"
                                       Margin="2,0,0,7"/>
                            <Border Height="54"
                                    CornerRadius="14"
                                    BorderBrush="{StaticResource LoginInputBorderBrush}"
                                    BorderThickness="1"
                                    Background="{StaticResource LoginInputBrush}"
                                    Padding="20,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <iconPacks:PackIconMaterial Kind="AccountOutline"
                                                                Style="{StaticResource LoginMaterialIconStyle}"/>
                                    <Grid Grid.Column="1"
                                          Margin="16,0,0,0"
                                          VerticalAlignment="Center">
                                        <TextBox x:Name="txtUsername"
                                                 Style="{StaticResource LoginFlatTextBoxStyle}"
                                                 Height="36"
                                                 KeyDown="InputField_KeyDown"/>
                                        <TextBlock Text="Введите логин">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource LoginPlaceholderStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=txtUsername}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Пароль"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource LoginTextBrush}"
                                       Margin="2,0,0,7"/>
                            <Border Height="54"
                                    CornerRadius="14"
                                    BorderBrush="{StaticResource LoginInputBorderBrush}"
                                    BorderThickness="1"
                                    Background="{StaticResource LoginInputBrush}"
                                    Padding="20,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="42"/>
                                    </Grid.ColumnDefinitions>
                                    <iconPacks:PackIconMaterial Kind="LockOutline"
                                                                Style="{StaticResource LoginMaterialIconStyle}"/>
                                    <Grid Grid.Column="1"
                                          Margin="16,0,10,0"
                                          VerticalAlignment="Center">
                                        <PasswordBox x:Name="txtPassword"
                                                     Style="{StaticResource LoginFlatPasswordBoxStyle}"
                                                     Height="36"
                                                     KeyDown="InputField_KeyDown"
                                                     PasswordChanged="TxtPassword_PasswordChanged"
                                                     Visibility="Visible"/>
                                        <TextBox x:Name="txtPasswordVisible"
                                                 Style="{StaticResource LoginFlatTextBoxStyle}"
                                                 Height="36"
                                                 KeyDown="InputField_KeyDown"
                                                 TextChanged="TxtPasswordVisible_TextChanged"
                                                 Visibility="Collapsed"/>
                                        <TextBlock x:Name="PasswordPlaceholder"
                                                   Text="Введите пароль"
                                                   Style="{StaticResource LoginPlaceholderStyle}"/>
                                    </Grid>
                                    <Button x:Name="btnTogglePassword"
                                            Grid.Column="2"
                                            Width="36"
                                            Height="36"
                                            Click="BtnTogglePassword_Click"
                                            MouseEnter="BtnTogglePassword_MouseEnter"
                                            MouseLeave="BtnTogglePassword_MouseLeave"
                                            Style="{StaticResource LoginIconButtonStyle}"
                                            ToolTip="Показать пароль">
                                        <iconPacks:PackIconMaterial x:Name="IconPasswordEye"
                                                                    Kind="EyeOff"
                                                                    Width="18"
                                                                    Height="18"
                                                                    Foreground="{StaticResource LoginTextBrush}"
                                                                    Opacity="0.88"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    RenderTransformOrigin="0.5,0.5">
                                            <iconPacks:PackIconMaterial.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform x:Name="EyeScale" ScaleX="1" ScaleY="1"/>
                                                    <RotateTransform x:Name="EyeRotate" Angle="0"/>
                                                </TransformGroup>
                                            </iconPacks:PackIconMaterial.RenderTransform>
                                        </iconPacks:PackIconMaterial>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <Grid Margin="0,0,0,12">
                            <CheckBox Content="Запомнить меня"
                                      Style="{StaticResource LoginCheckBoxStyle}"
                                      HorizontalAlignment="Left"/>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Cursor="Hand">
                                <iconPacks:PackIconMaterial Kind="HelpCircleOutline"
                                                            Width="17"
                                                            Height="17"
                                                            Foreground="{StaticResource LoginLinkBrush}"
                                                            Opacity="0.9"
                                                            Margin="0,0,7,0"
                                                            VerticalAlignment="Center"/>
                                <TextBlock Text="Забыли пароль?"
                                           Foreground="{StaticResource LoginLinkBrush}"
                                           FontSize="14"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Button x:Name="btnLogin"
                                Content="Войти"
                                Click="BtnLogin_Click"
                                Style="{StaticResource LoginPrimaryButtonStyle}"
                                Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Height="1"
                                    Background="#70FFFFFF"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="или"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource LoginMutedBrush}"
                                       FontSize="14"
                                       FontWeight="Medium"/>
                            <Border Grid.Column="2"
                                    Height="1"
                                    Background="#70FFFFFF"
                                    VerticalAlignment="Center"/>
                        </Grid>

                        <Button Click="BtnRegister_Click"
                                Style="{StaticResource LoginSecondaryButtonStyle}"
                                Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="AccountPlusOutline"
                                                            Style="{StaticResource LoginMaterialIconStyle}"
                                                            Margin="0,0,12,0"/>
                                <TextBlock Text="Зарегистрируйтесь"
                                           Foreground="{StaticResource LoginTextBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <TextBlock x:Name="txtSuccess"
                                   Foreground="{DynamicResource AppSuccessBrush}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   TextAlignment="Center"
                                   MinHeight="16"/>
                        <TextBlock x:Name="txtError"
                                   Foreground="{DynamicResource AppDangerBrush}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   TextAlignment="Center"
                                   MinHeight="16"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
