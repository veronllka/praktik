<Window x:Class="praktik.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Регистрация пользователя"
        Width="560"
        Height="640"
        MinWidth="520"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        FontFamily="{DynamicResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="RegisterRoleComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="{StaticResource GlassTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#30FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#42FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RegisterRoleComboBoxStyle"
               TargetType="{x:Type ComboBox}"
               BasedOn="{StaticResource GlassComboBoxStyle}">
            <Setter Property="ItemContainerStyle" Value="{StaticResource RegisterRoleComboBoxItemStyle}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource GlassTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Padding="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent"
                                                CornerRadius="10">
                                            <Grid>
                                                <ContentPresenter Margin="0,0,28,0"
                                                                  HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center"/>
                                                <Path Data="M 4 7 L 8 11 L 12 7"
                                                      Width="12"
                                                      Height="12"
                                                      Stretch="Uniform"
                                                      Stroke="{StaticResource GlassMutedBrush}"
                                                      StrokeThickness="1.8"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,2,0"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"/>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Padding="6"
                                        CornerRadius="12"
                                        Background="#D8EEF4FF"
                                        BorderBrush="#9AFFFFFF"
                                        BorderThickness="1">
                                    <ScrollViewer CanContentScroll="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Border x:Name="RegisterPanel"
                Background="{StaticResource GlassSurfaceBrush}"
                CornerRadius="14"
                MouseLeftButtonDown="RegisterPanel_MouseLeftButtonDown">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.RowSpan="2"
                        CornerRadius="14"
                        Background="#08FFFFFF"
                        IsHitTestVisible="False"/>

                <Grid x:Name="TitleBar"
                      Grid.Row="0"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="18,0,0,0">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                                    Width="18"
                                                    Height="18"
                                                    Foreground="#111827"
                                                    Opacity="0.9"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Foreground="#303747"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0">
                        <Button Click="BtnMinimize_Click"
                                Style="{StaticResource GlassTitleBarButtonStyle}"
                                ToolTip="Свернуть">
                            <TextBlock Text="&#xE738;" FontFamily="Segoe MDL2 Assets"
                                                        Width="14"
                                                        Height="14"
                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button Click="BtnMaximize_Click"
                                Style="{StaticResource GlassTitleBarButtonStyle}"
                                ToolTip="Развернуть">
                            <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets"
                                                        Width="13"
                                                        Height="13"
                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button Click="BtnClose_Click"
                                Style="{StaticResource GlassCloseTitleBarButtonStyle}"
                                ToolTip="Закрыть">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                                        Width="15"
                                                        Height="15"
                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1"
                      Margin="40,0,40,18">
                    <StackPanel>
                        <Grid Width="132"
                              Height="62"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,6"
                              ClipToBounds="False">
                            <Ellipse Width="58"
                                     Height="58"
                                     Fill="{StaticResource GlassAvatarBrush}"
                                     Stroke="#B8FFFFFF"
                                     StrokeThickness="1"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#7E93BE"
                                                      BlurRadius="22"
                                                      ShadowDepth="6"
                                                      Opacity="0.22"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" x:Name="HeaderIcon"
                                                        Width="38"
                                                        Height="38"
                                                        FontSize="30"
                                                        TextAlignment="Center"
                                                        LineHeight="38"
                                                        LineStackingStrategy="BlockLineHeight"
                                                        Foreground="#111827"
                                                        Opacity="0.9"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock x:Name="txtHeaderTitle"
                                   Text="Регистрация пользователя"
                                   HorizontalAlignment="Center"
                                   FontSize="25"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource GlassTextBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,4"/>
                        <TextBlock x:Name="txtHeaderSubtitle"
                                   Text="Заполните данные новой учетной записи"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{StaticResource GlassMutedBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>

                        <StackPanel Margin="0,0,0,9">
                            <TextBlock Text="Логин"
                                       Style="{StaticResource GlassFieldLabelStyle}"
                                       Margin="2,0,0,5"/>
                            <Border Height="48"
                                    CornerRadius="14"
                                    BorderBrush="{StaticResource GlassInputBorderBrush}"
                                    BorderThickness="1"
                                    Background="{StaticResource GlassInputBrush}"
                                    Padding="16,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets"
                                                                Style="{StaticResource GlassFieldIconStyle}"/>
                                    <Grid Grid.Column="1"
                                          Margin="16,0,0,0"
                                          VerticalAlignment="Center">
                                        <TextBox x:Name="txtUsername"
                                                 Style="{StaticResource GlassFlatTextBoxStyle}"
                                                 Height="36"
                                                 KeyDown="InputField_KeyDown"/>
                                        <TextBlock Text="Введите логин">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource GlassPlaceholderStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=txtUsername}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,5">
                            <TextBlock Text="Пароль"
                                       Style="{StaticResource GlassFieldLabelStyle}"
                                       Margin="2,0,0,5"/>
                            <Border Height="48"
                                    CornerRadius="14"
                                    BorderBrush="{StaticResource GlassInputBorderBrush}"
                                    BorderThickness="1"
                                    Background="{StaticResource GlassInputBrush}"
                                    Padding="16,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="32"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                                                Style="{StaticResource GlassFieldIconStyle}"/>
                                    <Grid Grid.Column="1"
                                          Margin="16,0,10,0"
                                          VerticalAlignment="Center">
                                        <PasswordBox x:Name="txtPassword"
                                                     Style="{StaticResource GlassFlatPasswordBoxStyle}"
                                                     Height="36"
                                                     KeyDown="InputField_KeyDown"
                                                     PasswordChanged="TxtPassword_PasswordChanged"
                                                     Visibility="Visible"/>
                                        <TextBox x:Name="txtPasswordVisible"
                                                 Style="{StaticResource GlassFlatTextBoxStyle}"
                                                 Height="36"
                                                 KeyDown="InputField_KeyDown"
                                                 TextChanged="TxtPasswordVisible_TextChanged"
                                                 Visibility="Collapsed"/>
                                        <TextBlock x:Name="PasswordPlaceholder"
                                                   Text="Введите пароль"
                                                   Style="{StaticResource GlassPlaceholderStyle}"/>
                                    </Grid>
                                    <Button x:Name="btnTogglePassword"
                                            Grid.Column="2"
                                            Width="30"
                                            Height="30"
                                            Click="BtnTogglePassword_Click"
                                            Style="{StaticResource GlassIconButtonStyle}"
                                            ToolTip="Показать пароль">
                                        <iconPacks:PackIconMaterial x:Name="IconPasswordEye"
                                                                    Kind="EyeOff"
                                                                    Width="18"
                                                                    Height="18"
                                                                    Foreground="#111827"
                                                                    Opacity="0.88"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,5">
                            <TextBlock Text="Полное имя"
                                       Style="{StaticResource GlassFieldLabelStyle}"
                                       Margin="2,0,0,5"/>
                            <Border Height="48"
                                    CornerRadius="14"
                                    BorderBrush="{StaticResource GlassInputBorderBrush}"
                                    BorderThickness="1"
                                    Background="{StaticResource GlassInputBrush}"
                                    Padding="16,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets"
                                                                Style="{StaticResource GlassFieldIconStyle}"/>
                                    <Grid Grid.Column="1"
                                          Margin="16,0,0,0"
                                          VerticalAlignment="Center">
                                        <TextBox x:Name="txtFullName"
                                                 Style="{StaticResource GlassFlatTextBoxStyle}"
                                                 Height="36"
                                                 KeyDown="InputField_KeyDown"/>
                                        <TextBlock Text="Введите ФИО">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource GlassPlaceholderStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=txtFullName}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,5">
                            <TextBlock Text="Роль"
                                       Style="{StaticResource GlassFieldLabelStyle}"
                                       Margin="2,0,0,5"/>
                            <Border Height="48"
                                    CornerRadius="14"
                                    BorderBrush="{StaticResource GlassInputBorderBrush}"
                                    BorderThickness="1"
                                    Background="{StaticResource GlassInputBrush}"
                                    Padding="16,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"
                                                                Style="{StaticResource GlassFieldIconStyle}"/>
                                    <ComboBox x:Name="cbRoles"
                                              Grid.Column="1"
                                              Margin="16,0,0,0"
                                              Height="34"
                                              Style="{StaticResource RegisterRoleComboBoxStyle}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding RoleName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <TextBlock x:Name="txtRoleHint"
                                   Margin="2,0,2,0"
                                   Foreground="{StaticResource GlassMutedBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   MinHeight="16"/>

                        <TextBlock x:Name="txtError"
                                   Margin="0,0,0,0"
                                   Foreground="{DynamicResource AppDangerBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   MinHeight="16"/>

                        <Button x:Name="btnRegister"
                                Click="BtnRegister_Click"
                                MinWidth="210"
                                Style="{StaticResource GlassPrimaryButtonStyle}"
                                Height="50"
                                Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" x:Name="RegisterButtonIcon"
                                                            Width="22"
                                                            Height="22"
                                                            Foreground="White"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,12,0"/>
                                <TextBlock x:Name="RegisterButtonText"
                                           Text="Зарегистрироваться"
                                           Foreground="White"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnCancel"
                                Click="BtnCancel_Click"
                                Style="{StaticResource GlassSecondaryButtonStyle}"
                                Height="50"
                                IsCancel="True">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                                            Style="{StaticResource GlassFieldIconStyle}"
                                                            Margin="0,0,12,0"/>
                                <TextBlock Text="Отмена"
                                           Foreground="{StaticResource GlassTextBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
