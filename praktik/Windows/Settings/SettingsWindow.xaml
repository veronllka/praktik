<Window x:Class="praktik.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:appControls="clr-namespace:praktik.Controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="Настройки"
        Width="700"
        Height="860"
        MinWidth="560"
        MinHeight="620"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Style="{StaticResource GlassWindowStyle}">
    <Window.Resources>
        <SolidColorBrush x:Key="SettingsGlassRootBrush" Color="#24FFFFFF"/>
        <SolidColorBrush x:Key="SettingsGlassPanelBrush" Color="#46FFFFFF"/>
        <SolidColorBrush x:Key="SettingsGlassChromeBrush" Color="#30FFFFFF"/>
        <SolidColorBrush x:Key="AppSurfaceBrush" Color="#34FFFFFF"/>
        <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="#28FFFFFF"/>
        <SolidColorBrush x:Key="AppPanelBrush" Color="#24FFFFFF"/>
        <SolidColorBrush x:Key="AppNavigationBrush" Color="#30FFFFFF"/>
        <SolidColorBrush x:Key="AppInputBackgroundBrush" Color="#28FFFFFF"/>
        <SolidColorBrush x:Key="AppBorderBrush" Color="#86FFFFFF"/>
        <SolidColorBrush x:Key="AppGlassStrongBrush" Color="#36FFFFFF"/>

        <Style x:Key="SettingsCardBorderStyle" TargetType="Border" BasedOn="{StaticResource AppleCard}">
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Background" Value="{StaticResource SettingsGlassPanelBrush}"/>
            <Setter Property="BorderBrush" Value="#98FFFFFF"/>
        </Style>

        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppSubtleTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="AccentOptionStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="AccentBorder"
                                Width="160" Padding="14" CornerRadius="14"
                                BorderThickness="1.5"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                Background="{DynamicResource AppSurfaceAltBrush}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="AccentBorder" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
                                <Setter TargetName="AccentBorder" Property="Background" Value="{DynamicResource AppAccentSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="AccentBorder" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Row style for settings items with toggle -->
        <Style x:Key="SettingsRowStyle" TargetType="Border">
            <Setter Property="Padding" Value="0,10"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="SettingsRowLastStyle" TargetType="Border">
            <Setter Property="Padding" Value="10,0"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource SettingsGlassRootBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar"
              Grid.Row="0"
              Background="Transparent"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="18,0,0,0">
                <TextBlock Text="&#xE713;"
                           FontFamily="Segoe MDL2 Assets"
                           Width="18"
                           Height="18"
                           Foreground="{DynamicResource AppTextBrush}"
                           Margin="0,0,12,0"/>
                <TextBlock Text="Настройки"
                           FontSize="14"
                           FontWeight="Medium"
                           Foreground="{DynamicResource AppTextBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0">
                <Button Click="BtnMinimize_Click"
                        Style="{StaticResource GlassTitleBarButtonStyle}"
                        ToolTip="Свернуть">
                    <TextBlock Text="&#xE738;" FontFamily="Segoe MDL2 Assets"
                               Width="14"
                               Height="14"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <Button Click="BtnMaximize_Click"
                        Style="{StaticResource GlassTitleBarButtonStyle}"
                        ToolTip="Развернуть">
                    <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets"
                               Width="13"
                               Height="13"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <Button Click="BtnClose_Click"
                        Style="{StaticResource GlassCloseTitleBarButtonStyle}"
                        ToolTip="Закрыть">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                               Width="15"
                               Height="15"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Apple-style header -->
        <Border Grid.Row="1"
                Background="{StaticResource SettingsGlassChromeBrush}"
                Padding="24,20">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="2" Opacity="0.2" Direction="270"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Настройки"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource AppTextBrush}"/>
                <TextBlock Text="Смена пароля, внешний вид, анимации и производительность."
                           Margin="0,6,0,0" FontSize="13"
                           Foreground="{DynamicResource AppMutedTextBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,8">
                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="9"
                                    Background="{DynamicResource AppAccentSoftBrush}"
                                    BorderBrush="{DynamicResource AppAccentBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="AccountOutline"
                                                             Width="17" Height="17"
                                                             Foreground="{DynamicResource AppAccentBrush}"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Текущий пользователь"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Padding="14"
                                    CornerRadius="12"
                                    Background="{DynamicResource AppSurfaceBrush}"
                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Имя"
                                               Foreground="{DynamicResource AppTextBrush}"/>
                                    <TextBlock x:Name="txtCurrentFullName"
                                               Margin="0,6,0,0"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Padding="14"
                                    CornerRadius="12"
                                    Background="{DynamicResource AppSurfaceBrush}"
                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Логин"
                                               Foreground="{DynamicResource AppTextBrush}"/>
                                    <TextBlock x:Name="txtCurrentLogin"
                                               Margin="0,6,0,0"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4"
                                    Padding="14"
                                    CornerRadius="12"
                                    Background="{DynamicResource AppSurfaceBrush}"
                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Роль"
                                               Foreground="{DynamicResource AppTextBrush}"/>
                                    <TextBlock x:Name="txtCurrentRole"
                                               Margin="0,6,0,0"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="9"
                                    Background="{DynamicResource AppAccentSoftBrush}"
                                    BorderBrush="{DynamicResource AppAccentBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="Palette"
                                                             Width="17" Height="17"
                                                             Foreground="{DynamicResource AppAccentBrush}"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Внешний вид"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="Стиль интерфейса"
                                       FontWeight="SemiBold"/>
                            <WrapPanel Margin="0,12,0,0">
                                <RadioButton x:Name="rbStyleLiquid"
                                             GroupName="UiStyleGroup"
                                             Checked="AppearanceOption_Checked"
                                             Style="{StaticResource AccentOptionStyle}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                            <iconPacks:PackIconMaterial Kind="WaterOutline"
                                                                         Width="20" Height="20"
                                                                         Foreground="#58C8EEFF"/>
                                            <iconPacks:PackIconMaterial Kind="BlurRadial"
                                                                         Width="20" Height="20"
                                                                         Margin="8,0,0,0"
                                                                         Foreground="#56B8DCF8"/>
                                        </StackPanel>
                                        <TextBlock Text="Liquid glass"
                                                   Margin="0,10,0,0"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="как авторизация"
                                                   Margin="0,4,0,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource AppMutedTextBrush}"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="rbStyleClassic"
                                             GroupName="UiStyleGroup"
                                             Checked="AppearanceOption_Checked"
                                             Style="{StaticResource AccentOptionStyle}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                            <iconPacks:PackIconMaterial Kind="ViewGridOutline"
                                                                         Width="20" Height="20"
                                                                         Foreground="{DynamicResource AppMutedTextBrush}"/>
                                            <iconPacks:PackIconMaterial Kind="FormatListBulleted"
                                                                         Width="20" Height="20"
                                                                         Margin="8,0,0,0"
                                                                         Foreground="{DynamicResource AppSubtleTextBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="Классический"
                                                   Margin="0,10,0,0"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="плотный и строгий"
                                                   Margin="0,4,0,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource AppMutedTextBrush}"/>
                                    </StackPanel>
                                </RadioButton>
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="4">
                            <TextBlock Text="Тема приложения"
                                       FontWeight="SemiBold"/>
                            <Border Margin="0,12,0,0"
                                    Style="{StaticResource AppleSegmentedRoot}"
                                    HorizontalAlignment="Left"
                                    MinWidth="280">
                                <UniformGrid Rows="1" Columns="2">
                                    <RadioButton x:Name="rbLightTheme"
                                                 GroupName="BaseThemeGroup"
                                                 Style="{StaticResource AppleSegmentedItem}"
                                                 Checked="BaseTheme_Checked">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="4,0">
                                            <iconPacks:PackIconMaterial Kind="WeatherSunny"
                                                                         Width="17" Height="17"
                                                                         Margin="0,0,7,0"
                                                                         VerticalAlignment="Center"/>
                                            <TextBlock Text="Светлая" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="rbDarkTheme"
                                                 GroupName="BaseThemeGroup"
                                                 Style="{StaticResource AppleSegmentedItem}"
                                                 Checked="BaseTheme_Checked">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="4,0">
                                            <iconPacks:PackIconMaterial Kind="WeatherNight"
                                                                         Width="17" Height="17"
                                                                         Margin="0,0,7,0"
                                                                         VerticalAlignment="Center"/>
                                            <TextBlock Text="Тёмная" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                </UniformGrid>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="6">
                            <TextBlock Text="Цветовая гамма"
                                       FontWeight="SemiBold"/>
                            <WrapPanel Margin="0,12,0,0">
                                <RadioButton x:Name="rbAccentBrown"
                                             GroupName="AccentPaletteGroup"
                                             Tag="Brown"
                                             Checked="AccentOption_Checked"
                                             Style="{StaticResource AccentOptionStyle}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="20" Height="20" Fill="#6965F2"/>
                                            <Ellipse Width="20" Height="20" Fill="#DAD9FF" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="Фиолетовый"
                                                   Margin="0,12,0,0"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="rbAccentPink"
                                             GroupName="AccentPaletteGroup"
                                             Tag="Pink"
                                             Checked="AccentOption_Checked"
                                             Style="{StaticResource AccentOptionStyle}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="20" Height="20" Fill="#EC407A"/>
                                            <Ellipse Width="20" Height="20" Fill="#F8BBD0" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="Розовый"
                                                   Margin="0,12,0,0"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="rbAccentLightBlue"
                                             GroupName="AccentPaletteGroup"
                                             Tag="LightBlue"
                                             Checked="AccentOption_Checked"
                                             Style="{StaticResource AccentOptionStyle}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="20" Height="20" Fill="#03A9F4"/>
                                            <Ellipse Width="20" Height="20" Fill="#80DEEA" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="Голубой"
                                                   Margin="0,12,0,0"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </RadioButton>
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="8">
                            <TextBlock Text="Шрифт интерфейса"
                                       FontWeight="SemiBold"/>
                            <ComboBox x:Name="cbFontFamily"
                                      Margin="0,10,0,0"
                                      MinWidth="260"
                                      HorizontalAlignment="Left"
                                      SelectionChanged="FontFamily_SelectionChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Row="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Прозрачность стекла"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="txtGlassOpacityValue"
                                           Grid.Column="1"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppAccentBrush}"/>
                            </Grid>
                            <Slider x:Name="sldGlassOpacity"
                                    Margin="0,10,0,0"
                                    Minimum="25"
                                    Maximum="92"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="GlassOpacity_ValueChanged"/>
                        </StackPanel>

                        <TextBlock x:Name="txtAppearanceError"
                                   Grid.Row="12"
                                   Foreground="{DynamicResource AppDangerBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="9"
                                    Background="{DynamicResource AppAccentSoftBrush}"
                                    BorderBrush="{DynamicResource AppAccentBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="LockOutline"
                                                             Width="17" Height="17"
                                                             Foreground="{DynamicResource AppAccentBrush}"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Смена пароля"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="Новый пароль"
                                       FontWeight="SemiBold"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>

                                <PasswordBox x:Name="txtNewPassword"
                                             Height="36"
                                             Padding="10,6"
                                             PasswordChanged="PasswordFields_Changed"/>
                                <TextBlock x:Name="iconNewPasswordStatus"
                                           Text="&#xE91F;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Grid.Column="1"
                                           Width="22"
                                           Height="22"
                                           FontSize="16"
                                           Margin="10,0,0,0"
                                           Foreground="{DynamicResource AppSubtleTextBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="txtNewPasswordHint"
                                       Margin="0,8,0,0"
                                       Foreground="{DynamicResource AppTextBrush}"
                                       Text="Оставьте поле пустым, если пароль менять не нужно."
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4">
                            <TextBlock Text="Подтверждение пароля"
                                       FontWeight="SemiBold"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>

                                <PasswordBox x:Name="txtConfirmPassword"
                                             Height="36"
                                             Padding="10,6"
                                             PasswordChanged="PasswordFields_Changed"/>
                                <TextBlock x:Name="iconConfirmPasswordStatus"
                                           Text="&#xE91F;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Grid.Column="1"
                                           Width="22"
                                           Height="22"
                                           FontSize="16"
                                           Margin="10,0,0,0"
                                           Foreground="{DynamicResource AppSubtleTextBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="txtConfirmPasswordHint"
                                       Margin="0,8,0,0"
                                       Foreground="{DynamicResource AppTextBrush}"
                                       Text="Повторите новый пароль для проверки совпадения."
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <TextBlock x:Name="txtPasswordError"
                                   Grid.Row="6"
                                   Foreground="{DynamicResource AppDangerBrush}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <!-- ═══ ANIMATION & PERFORMANCE PANEL ═════════════════════ -->
                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <StackPanel>
                        <!-- Header row -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="10"
                                    Background="{DynamicResource AppAccentSoftBrush}"
                                    BorderBrush="{DynamicResource AppAccentBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="Flash"
                                                             Width="19" Height="19"
                                                             Foreground="{DynamicResource AppAccentBrush}"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Анимации и производительность"
                                           FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Интеллектуальная оптимизация: анимации адаптируются к нагрузке ЦП, ОЗУ и заряду."
                                           FontSize="12" Margin="0,3,0,0"
                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border Grid.Column="2" x:Name="badgeLevel"
                                    Style="{StaticResource AppleBadge}"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="dotAnimStatus"
                                             Style="{StaticResource StatusDotGreen}"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="txtAnimStatusBadge"
                                               Text="Полные"
                                               FontSize="11" FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource AppAccentBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Performance Mode Segmented Control -->
                        <TextBlock Text="Режим производительности"
                                   FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="«Авто» — умная адаптация. «Всегда» — держит полную плавность. «Упрощённые» — сокращает длительность. «Выключено» — мгновенные переходы."
                                   FontSize="11" Foreground="{DynamicResource AppMutedTextBrush}"
                                   Margin="0,0,0,10" TextWrapping="Wrap"/>
                        <Border Style="{StaticResource AppleSegmentedRoot}" HorizontalAlignment="Stretch">
                            <UniformGrid Rows="1" Columns="4">
                                <RadioButton x:Name="segModeAuto"
                                             GroupName="PerfMode"
                                             Style="{StaticResource AppleSegmentedItem}"
                                             Checked="PerformanceMode_Changed"
                                             Tag="Auto">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <iconPacks:PackIconMaterial Kind="AutoFix"
                                                                     Width="15" Height="15"
                                                                     Margin="0,0,6,0"
                                                                     VerticalAlignment="Center"/>
                                        <TextBlock Text="Авто" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="segModeAlways"
                                             GroupName="PerfMode"
                                             Style="{StaticResource AppleSegmentedItem}"
                                             Checked="PerformanceMode_Changed"
                                             Tag="AlwaysOn"
                                             Content="Всегда"/>
                                <RadioButton x:Name="segModeReduced"
                                             GroupName="PerfMode"
                                             Style="{StaticResource AppleSegmentedItem}"
                                             Checked="PerformanceMode_Changed"
                                             Tag="Reduced"
                                             Content="Упрощённые"/>
                                <RadioButton x:Name="segModeOff"
                                             GroupName="PerfMode"
                                             Style="{StaticResource AppleSegmentedItem}"
                                             Checked="PerformanceMode_Changed"
                                             Tag="Off"
                                             Content="Выключено"/>
                            </UniformGrid>
                        </Border>

                        <!-- Live telemetry cards -->
                        <Grid Margin="0,16,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource AppleStatsCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <appControls:AnimatedCpuGauge x:Name="gaugeCpu"
                                                                  Width="54" Height="54"
                                                                  Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="ЦП" FontSize="11"
                                                   Foreground="{DynamicResource AppSubtleTextBrush}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="txtLiveCpu" Text="—%"
                                                   FontSize="16" FontWeight="Bold"
                                                   Foreground="{DynamicResource AppTextBrush}"/>
                                        <TextBlock x:Name="txtCpuHint" Text="в норме"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource AppSubtleTextBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource AppleStatsCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="ОЗУ" FontSize="11"
                                                   Foreground="{DynamicResource AppSubtleTextBrush}"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock x:Name="txtLiveRam" Text="—%"
                                               FontSize="20" FontWeight="Bold"
                                               Foreground="{DynamicResource AppTextBrush}"/>
                                    <ProgressBar x:Name="barRam"
                                                 Minimum="0" Maximum="100" Value="0"
                                                 Height="4" Margin="0,6,0,0"
                                                 Foreground="{DynamicResource AppAccentBrush}"
                                                 Background="{DynamicResource AppBorderBrush}"
                                                 BorderThickness="0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Style="{StaticResource AppleStatsCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <appControls:AnimatedBatteryIcon x:Name="iconBattery"
                                                                     Width="36" Height="20"
                                                                     Margin="0,0,10,0"
                                                                     VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Батарея" FontSize="11"
                                                   Foreground="{DynamicResource AppSubtleTextBrush}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="txtLiveBattery" Text="AC"
                                                   FontSize="16" FontWeight="Bold"
                                                   Foreground="{DynamicResource AppTextBrush}"/>
                                        <TextBlock x:Name="txtBatteryHint" Text="от сети"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource AppSubtleTextBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <TextBlock Text="Тригеры автоматической оптимизации"
                                   FontWeight="SemiBold" Margin="0,18,0,10"/>

                        <!-- Master toggle -->
                        <Border Style="{StaticResource SettingsRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Разрешить анимации" FontWeight="Medium"/>
                                    <TextBlock Text="Общий выключатель: перекрывает все настройки ниже."
                                               FontSize="12" Foreground="{DynamicResource AppMutedTextBrush}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="chkAnimationsEnabled"
                                          Grid.Column="1"
                                          Style="{StaticResource AppleToggleSwitch}"
                                          VerticalAlignment="Center"
                                          Checked="AnimationSettings_Changed"
                                          Unchecked="AnimationSettings_Changed"/>
                            </Grid>
                        </Border>

                        <!-- CPU auto-disable -->
                        <Border Style="{StaticResource SettingsRowStyle}" x:Name="pnlCpuSettings">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Реагировать на нагрузку ЦП"
                                                   FontWeight="Medium"/>
                                        <TextBlock Text="Сокращает анимации при 70% порога, отключает выше."
                                                   FontSize="12" Foreground="{DynamicResource AppMutedTextBrush}"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="chkAutoDisableCpu"
                                              Grid.Column="1"
                                              Style="{StaticResource AppleToggleSwitch}"
                                              VerticalAlignment="Center"
                                              Checked="AnimationSettings_Changed"
                                              Unchecked="AnimationSettings_Changed"/>
                                </Grid>
                                <Grid x:Name="pnlCpuThreshold" Margin="0,4,0,0">
                                    <StackPanel>
                                        <TextBlock FontSize="12" Foreground="{DynamicResource AppSubtleTextBrush}"
                                                   Margin="0,0,0,6">
                                            <Run Text="Критический порог ЦП: "/>
                                            <Run x:Name="runCpuThreshold" Text="80"/>
                                            <Run Text="%"/>
                                        </TextBlock>
                                        <Border Style="{StaticResource AppleStepperRoot}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="btnCpuThresholdDown"
                                                        Content="-"
                                                        Style="{StaticResource AppleStepperButton}"
                                                        Click="BtnCpuThresholdDown_Click"/>
                                                <Border Grid.Column="1"
                                                        Margin="8,0"
                                                        Background="{DynamicResource AppSurfaceBrush}"
                                                        CornerRadius="11"
                                                        Padding="10,6">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock x:Name="txtCpuThresholdValue"
                                                                   Text="80%"
                                                                   FontSize="18"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Text="CPU"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AppSubtleTextBrush}"
                                                                   HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <Button x:Name="btnCpuThresholdUp"
                                                        Grid.Column="2"
                                                        Content="+"
                                                        Style="{StaticResource AppleStepperButton}"
                                                        Click="BtnCpuThresholdUp_Click"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- RAM auto-disable -->
                        <Border Style="{StaticResource SettingsRowStyle}" x:Name="pnlRamSettings">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Реагировать на нагрузку ОЗУ"
                                                   FontWeight="Medium"/>
                                        <TextBlock Text="Отключает анимации при высоком расходе памяти."
                                                   FontSize="12" Foreground="{DynamicResource AppMutedTextBrush}"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="chkAutoDisableRam"
                                              Grid.Column="1"
                                              Style="{StaticResource AppleToggleSwitch}"
                                              VerticalAlignment="Center"
                                              Checked="AnimationSettings_Changed"
                                              Unchecked="AnimationSettings_Changed"/>
                                </Grid>
                                <Grid x:Name="pnlRamThreshold" Margin="0,4,0,0">
                                    <StackPanel>
                                        <TextBlock FontSize="12" Foreground="{DynamicResource AppSubtleTextBrush}"
                                                   Margin="0,0,0,6">
                                            <Run Text="Критический порог ОЗУ: "/>
                                            <Run x:Name="runRamThreshold" Text="85"/>
                                            <Run Text="%"/>
                                        </TextBlock>
                                        <Border Style="{StaticResource AppleStepperRoot}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="btnRamThresholdDown"
                                                        Content="-"
                                                        Style="{StaticResource AppleStepperButton}"
                                                        Click="BtnRamThresholdDown_Click"/>
                                                <Border Grid.Column="1"
                                                        Margin="8,0"
                                                        Background="{DynamicResource AppSurfaceBrush}"
                                                        CornerRadius="11"
                                                        Padding="10,6">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock x:Name="txtRamThresholdValue"
                                                                   Text="85%"
                                                                   FontSize="18"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Text="RAM"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AppSubtleTextBrush}"
                                                                   HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <Button x:Name="btnRamThresholdUp"
                                                        Grid.Column="2"
                                                        Content="+"
                                                        Style="{StaticResource AppleStepperButton}"
                                                        Click="BtnRamThresholdUp_Click"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Battery auto-disable -->
                        <Border x:Name="pnlBatterySettings" Padding="0,10,0,4">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Экономить заряд батареи"
                                                   FontWeight="Medium"/>
                                        <TextBlock Text="Упрощает анимации при работе от аккумулятора."
                                                   FontSize="12" Foreground="{DynamicResource AppMutedTextBrush}"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="chkAutoDisableBattery"
                                              Grid.Column="1"
                                              Style="{StaticResource AppleToggleSwitch}"
                                              VerticalAlignment="Center"
                                              Checked="AnimationSettings_Changed"
                                              Unchecked="AnimationSettings_Changed"/>
                                </Grid>
                                <Grid x:Name="pnlBatteryThreshold">
                                    <StackPanel>
                                        <TextBlock FontSize="12" Foreground="{DynamicResource AppSubtleTextBrush}"
                                                   Margin="0,0,0,6">
                                            <Run Text="Критический порог заряда: "/>
                                            <Run x:Name="runBatteryThreshold" Text="20"/>
                                            <Run Text="%"/>
                                        </TextBlock>
                                        <Border Style="{StaticResource AppleStepperRoot}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="btnBatteryThresholdDown"
                                                        Content="-"
                                                        Style="{StaticResource AppleStepperButton}"
                                                        Click="BtnBatteryThresholdDown_Click"/>
                                                <Border Grid.Column="1"
                                                        Margin="8,0"
                                                        Background="{DynamicResource AppSurfaceBrush}"
                                                        CornerRadius="11"
                                                        Padding="10,6">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock x:Name="txtBatteryThresholdValue"
                                                                   Text="20%"
                                                                   FontSize="18"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Battery"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AppSubtleTextBrush}"
                                                                   HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <Button x:Name="btnBatteryThresholdUp"
                                                        Grid.Column="2"
                                                        Content="+"
                                                        Style="{StaticResource AppleStepperButton}"
                                                        Click="BtnBatteryThresholdUp_Click"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Live status + preview -->
                        <Border Background="{DynamicResource AppSurfaceAltBrush}"
                                CornerRadius="12" Padding="14,12" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="txtAnimStatus"
                                               Text="Анимации включены — нормальная работа"
                                               FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="txtAnimReason"
                                               Text=""
                                               FontSize="11"
                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            Grid.Column="1" VerticalAlignment="Center">
                                    <appControls:AnimatedRefreshIcon x:Name="iconPreviewRefresh"
                                                                      Width="22" Height="22"
                                                                      Margin="0,0,10,0"
                                                                      IsBusy="False"/>
                                    <appControls:AnimatedBellIcon x:Name="iconPreviewBell"
                                                                   Width="22" Height="22"
                                                                   Margin="0,0,10,0"/>
                                    <Button x:Name="btnPreviewAnim"
                                            Click="BtnPreview_Click"
                                            Style="{StaticResource AppleGhostButton}"
                                            Padding="14,6"
                                            FontSize="11"
                                            Content="Проверить"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3"
                Padding="20,14"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource AppBorderBrush}"
                Background="{StaticResource SettingsGlassChromeBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена"
                        Width="110" Height="38" Margin="0,0,10,0"
                        Style="{StaticResource AppleGhostButton}"
                        Click="BtnCancel_Click"/>
                <Button x:Name="btnSave"
                        Content="Сохранить изменения"
                        Width="210" Height="38"
                        Style="{StaticResource ApplePrimaryButton}"
                        Click="BtnSave_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
