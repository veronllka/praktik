<Window x:Class="praktik.TaskViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Информация о задаче" Height="700" Width="600" WindowStartupLocation="CenterScreen"
        Style="{StaticResource GlassWindowStyle}">
    <Grid Style="{StaticResource GlassWindowRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource GlassToolbarStyle}">
            <StackPanel>
                <TextBlock Text="НАРЯД-ЗАДАЧА" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource AppAccentBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>
                <TextBlock x:Name="txtTitle" 
                           FontSize="18" 
                           FontWeight="SemiBold" 
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource AppTextBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,25">
                <TextBlock x:Name="txtTaskId" 
                           FontSize="12" 
                           Foreground="{DynamicResource AppSubtleTextBrush}" 
                           Margin="0,0,0,20"
                           HorizontalAlignment="Right"/>

                <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,15" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="ОБЪЕКТ" 
                                   FontWeight="Bold" 
                                   FontSize="13" 
                                   Margin="0,0,0,8" 
                                   Foreground="{DynamicResource AppMutedTextBrush}"/>
                        <TextBlock x:Name="txtSite" 
                                   FontSize="15" 
                                   TextWrapping="Wrap" 
                                   Foreground="{DynamicResource AppTextBrush}"
                                   LineHeight="22"/>
                    </StackPanel>
                </Border>

                <Border x:Name="pnlPrintJournal"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="0,15,0,15"
                        Margin="0,0,0,20"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="ЖУРНАЛ ПЕЧАТИ"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Margin="0,0,0,12"
                                   Foreground="{DynamicResource AppMutedTextBrush}"/>
                        <TextBlock Text="Последняя печать"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Margin="0,0,0,6"
                                   Foreground="{DynamicResource AppMutedTextBrush}"/>
                        <TextBlock x:Name="txtLastPrintedAt"
                                   FontSize="14"
                                   Foreground="{DynamicResource AppTextBrush}"
                                   Margin="0,0,0,14"/>
                        <TextBlock Text="История печати"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Margin="0,0,0,8"
                                   Foreground="{DynamicResource AppMutedTextBrush}"/>
                        <TextBlock x:Name="txtPrintHistoryEmpty"
                                   Text="Печать по задаче еще не выполнялась"
                                   FontSize="13"
                                   Foreground="{DynamicResource AppSubtleTextBrush}"
                                   Margin="0,0,0,8"/>
                        <ItemsControl x:Name="icPrintHistory">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource AppBorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,0,0,10"
                                            Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock FontSize="14" Foreground="{DynamicResource AppTextBrush}">
                                                <Run Text="{Binding PrintedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/>
                                                <Run Text=" | "/>
                                                <Run Text="{Binding DisplayPrintedByName}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding DisplayTemplateName}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource AppSubtleTextBrush}"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,15" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="БРИГАДА" 
                                   FontWeight="Bold" 
                                   FontSize="13" 
                                   Margin="0,0,0,8" 
                                   Foreground="{DynamicResource AppMutedTextBrush}"/>
                        <TextBlock x:Name="txtCrew" 
                                   FontSize="15" 
                                   TextWrapping="Wrap" 
                                   Foreground="{DynamicResource AppTextBrush}"
                                   Margin="0,0,0,8"/>
                        <TextBlock x:Name="txtBrigadier" 
                                   FontSize="14" 
                                   TextWrapping="Wrap" 
                                   Foreground="{DynamicResource AppSubtleTextBrush}"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,15" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="ПЕРИОД ВЫПОЛНЕНИЯ" 
                                   FontWeight="Bold" 
                                   FontSize="13" 
                                   Margin="0,0,0,8" 
                                   Foreground="{DynamicResource AppMutedTextBrush}"/>
                        <TextBlock x:Name="txtPeriod" 
                                   FontSize="15" 
                                   Foreground="{DynamicResource AppTextBrush}"/>
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="ПРИОРИТЕТ" 
                                       FontWeight="Bold" 
                                       FontSize="13" 
                                       Margin="0,0,0,8" 
                                       Foreground="{DynamicResource AppMutedTextBrush}"/>
                            <TextBlock x:Name="txtPriority" 
                                       FontSize="15" 
                                       Foreground="{DynamicResource AppTextBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="СТАТУС" 
                                       FontWeight="Bold" 
                                       FontSize="13" 
                                       Margin="0,0,0,8" 
                                       Foreground="{DynamicResource AppMutedTextBrush}"/>
                            <TextBlock x:Name="txtStatus" 
                                       FontSize="15" 
                                       Foreground="{DynamicResource AppTextBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,15" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="ДАТА ПОСЛЕДНЕЙ ПЕЧАТИ"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Margin="0,0,0,8"
                                   Foreground="{DynamicResource AppMutedTextBrush}"/>
                        <TextBlock x:Name="txtLastPrintedSummary"
                                   FontSize="15"
                                   Foreground="{DynamicResource AppTextBrush}"/>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="pnlProgress" Visibility="Collapsed" Margin="0,0,0,20">
                    <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="ПОСЛЕДНИЙ ПРОГРЕСС" 
                                       FontWeight="Bold" 
                                       FontSize="13" 
                                       Margin="0,0,0,8" 
                                       Foreground="{DynamicResource AppMutedTextBrush}"/>
                            <TextBlock x:Name="txtProgress" 
                                       FontSize="15" 
                                       Margin="0,0,0,15" 
                                       Foreground="{DynamicResource AppTextBrush}"/>
                            <TextBlock Text="КОММЕНТАРИЙ" 
                                       FontWeight="Bold" 
                                       FontSize="13" 
                                       Margin="0,0,0,8" 
                                       Foreground="{DynamicResource AppMutedTextBrush}"/>
                            <TextBlock x:Name="txtComment" 
                                       FontSize="15" 
                                       TextWrapping="Wrap" 
                                       Foreground="{DynamicResource AppTextBrush}"
                                       LineHeight="22"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="ОПИСАНИЕ" 
                                   FontWeight="Bold" 
                                   FontSize="13" 
                                   Margin="0,0,0,8" 
                                   Foreground="{DynamicResource AppMutedTextBrush}"/>
                        <TextBlock x:Name="txtDescription" 
                                   FontSize="15" 
                                   TextWrapping="Wrap" 
                                   Foreground="{DynamicResource AppTextBrush}"
                                   LineHeight="22"/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,15" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="ЗАМЕТКИ" 
                                   FontWeight="Bold" 
                                   FontSize="13" 
                                   Margin="0,0,0,12" 
                                   Foreground="{DynamicResource AppMutedTextBrush}"/>
                        
                        <Border x:Name="pnlAddNote" 
                                BorderBrush="{DynamicResource AppBorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="18"
                                Padding="12"
                                Background="{DynamicResource AppSurfaceAltBrush}"
                                Margin="0,0,0,15">
                            <StackPanel>
                                <TextBox x:Name="txtNewNote" 
                                         FontSize="14" 
                                         Padding="8"
                                         MinHeight="60"
                                         MaxHeight="120"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         Background="{DynamicResource AppSurfaceBrush}"
                                         BorderBrush="{DynamicResource AppBorderBrush}"
                                         BorderThickness="1"
                                         Foreground="{DynamicResource AppTextBrush}"
                                         TextChanged="TxtNewNote_TextChanged"
                                         Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                                    <TextBlock Text="Прогресс, %"
                                               FontSize="13"
                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <TextBox x:Name="txtProgressPercent"
                                             Width="90"
                                             Height="32"
                                             FontSize="14"
                                             Padding="8,0"
                                             MaxLength="3"
                                             VerticalContentAlignment="Center"
                                             Background="{DynamicResource AppGlassSoftBrush}"
                                             BorderBrush="{DynamicResource AppGlassBorderBrush}"
                                             BorderThickness="1"
                                             PreviewTextInput="ProgressTextBox_PreviewTextInput"
                                             DataObject.Pasting="ProgressTextBox_Pasting"/>
                                    <TextBlock Text="Необязательно"
                                               FontSize="12"
                                   Foreground="{DynamicResource AppSubtleTextBrush}"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0"/>
                                </StackPanel>
                                <Border BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="10"
                                        Background="{DynamicResource AppGlassSoftBrush}"
                                        Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="txtSelectedAttachment"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="1"
                                                Content="Прикрепить файл"
                                                Click="BtnAttachFile_Click"
                                                Style="{StaticResource ModernOutlinedButtonStyle}"
                                                Margin="12,0,0,0"
                                                Padding="10,4"/>
                                        <Button x:Name="btnRemoveAttachment"
                                                Grid.Column="2"
                                                Content="Удалить"
                                                Click="BtnRemoveAttachment_Click"
                                                Style="{StaticResource GlassDangerButtonStyle}"
                                                Margin="8,0,0,0"
                                                Padding="10,4"
                                                Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Сохранить" 
                                            x:Name="btnSaveNote"
                                            Click="BtnSaveNote_Click"
                                            Width="120" 
                                            Height="35"
                                            FontSize="14"
                                            FontWeight="Medium"
                                            Margin="0,0,10,0"
                                            Style="{StaticResource ModernButtonStyle}"
                                            IsEnabled="False"/>
                                    <Button Content="Отмена" 
                                            x:Name="btnCancelNote"
                                            Click="BtnCancelNote_Click"
                                            Width="100" 
                                            Height="35"
                                            FontSize="14"
                                            FontWeight="Medium"
                                            Style="{StaticResource ModernOutlinedButtonStyle}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <ItemsControl x:Name="icNotes" Margin="0,0,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource AppBorderBrush}" 
                                            BorderThickness="0,0,0,1" 
                                            Padding="0,0,0,10"
                                            Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ReportText}" 
                                                       FontSize="14" 
                                                       TextWrapping="Wrap" 
                                                       Foreground="{DynamicResource AppTextBrush}"
                                                       LineHeight="20"
                                                       Margin="0,0,0,8"/>
                                            <TextBlock FontSize="12" Foreground="{DynamicResource AppSubtleTextBrush}">
                                                <Run Text="{Binding ReportedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/>
                                                <Run Text=" | "/>
                                                <Run Text="{Binding ReporterName}"/>
                                            </TextBlock>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <TextBlock Text="{Binding AttachmentFileName}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AppMutedTextBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasAttachment}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Button Content="Открыть вложение"
                                                        Click="BtnOpenAttachment_Click"
                                                        Margin="12,0,0,0"
                                                        Padding="10,3">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource AppAttachmentButtonStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasAttachment}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource GlassFooterBarStyle}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Показать QR-код" 
                        x:Name="btnShowQR"
                        Click="BtnShowQR_Click"
                        Width="180" 
                        Height="40"
                        FontSize="14"
                        FontWeight="Medium"
                        Margin="0,0,15,0"
                        Style="{StaticResource ModernButtonStyle}"/>
                
                <Button Content="Закрыть" 
                        Click="BtnClose_Click" 
                        Width="120" 
                        Height="40"
                        FontSize="14"
                        FontWeight="Medium"
                        Style="{StaticResource ModernOutlinedButtonStyle}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

