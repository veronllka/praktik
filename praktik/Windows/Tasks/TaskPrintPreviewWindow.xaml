<Window x:Class="praktik.TaskPrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Предпросмотр печати задачи" Height="720" Width="700" WindowStartupLocation="CenterScreen"
        Style="{StaticResource GlassWindowStyle}">
    <Grid Style="{StaticResource GlassWindowRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="20">
            <Border x:Name="PrintContent" Style="{StaticResource GlassPrintPaperStyle}">
                <StackPanel>
                    <TextBlock Text="НАРЯД-ЗАДАЧА"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppSubtleTextBrush}"
                               TextAlignment="Center"
                               Margin="0,0,0,6"/>
                    <TextBlock x:Name="txtTitle" FontSize="20" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <TextBlock x:Name="txtTaskMeta"
                               FontSize="11"
                               Foreground="{DynamicResource AppSubtleTextBrush}"
                               TextAlignment="Center"
                               Margin="0,0,0,18"/>
                    
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Объект:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppSubtleTextBrush}"/>
                        <TextBlock x:Name="txtSite" FontSize="14" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Бригада:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppSubtleTextBrush}"/>
                        <TextBlock x:Name="txtCrew" FontSize="14" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="txtBrigadier" FontSize="12" Foreground="{DynamicResource AppSubtleTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Период выполнения:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppSubtleTextBrush}"/>
                        <TextBlock x:Name="txtPeriod" FontSize="14" Margin="0,2,0,0"/>
                        <TextBlock x:Name="txtScheduleStatus" FontSize="12" Foreground="{DynamicResource AppSubtleTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Приоритет:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppSubtleTextBrush}"/>
                            <TextBlock x:Name="txtPriority" FontSize="14" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Статус:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppSubtleTextBrush}"/>
                            <TextBlock x:Name="txtStatus" FontSize="14" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Описание работ:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppSubtleTextBrush}"/>
                        <TextBlock x:Name="txtDescription" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" LineHeight="18"/>
                    </StackPanel>

                    <StackPanel x:Name="pnlMaterials" Margin="0,0,0,15">
                        <TextBlock Text="Материалы по заявкам:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppSubtleTextBrush}"/>
                        <TextBlock x:Name="txtMaterials" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" LineHeight="18"/>
                    </StackPanel>

                    <Border BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <TextBlock Text="Контроль выполнения" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppSubtleTextBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="☐ Работы выполнены в полном объёме" FontSize="12" Margin="0,0,0,5" TextWrapping="Wrap"/>
                                <TextBlock Text="☐ Замечаний по качеству нет" FontSize="12" Margin="0,0,0,5" TextWrapping="Wrap"/>
                                <TextBlock Text="☐ Материалы и инструмент возвращены" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Подписи" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppSubtleTextBrush}" Margin="0,0,0,8"/>
                                <TextBlock Text="Бригадир: __________________" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBlock Text="Диспетчер: ________________" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBlock Text="Дата закрытия: ____________" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel x:Name="pnlProgress" Margin="0,0,0,15" Visibility="Collapsed">
                        <TextBlock Text="Последний прогресс:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppSubtleTextBrush}"/>
                        <TextBlock x:Name="txtProgress" FontSize="14" Margin="0,2,0,5"/>
                        <TextBlock Text="Комментарий:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppSubtleTextBrush}" Margin="0,5,0,0"/>
                        <TextBlock x:Name="txtComment" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,10,0,0">
                        <StackPanel>
                            <TextBlock x:Name="txtPrintDate" FontSize="10" Foreground="#999999" TextAlignment="Right"/>
                            <TextBlock x:Name="txtPrintedBy" FontSize="10" Foreground="#999999" TextAlignment="Right" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Border Grid.Row="1" Style="{StaticResource GlassFooterBarStyle}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Печать"
                        Click="BtnPrint_Click"
                        Width="120"
                        Margin="0,0,10,0"
                        Style="{StaticResource AppRaisedButton}"/>
                <Button Content="Отмена"
                        Click="BtnCancel_Click"
                        Width="120"
                        Style="{StaticResource AppOutlinedButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>


