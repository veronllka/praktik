<Window x:Class="praktik.TaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:praktik"
        mc:Ignorable="d"
        Title="Задача" Height="640" Width="740" WindowStartupLocation="CenterScreen"
        Style="{StaticResource GlassWindowStyle}">
    <Grid Style="{StaticResource GlassWindowRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Margin="0,0,0,14">
            <TabItem Header="Основная информация">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,14,14,8">

                        <!-- Название и описание -->
                        <Border Margin="0,0,0,12"
                                Padding="20"
                                Background="{DynamicResource GlassCardBrush}"
                                BorderBrush="{DynamicResource GlassShellBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="18">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.10" Color="#7B91B2"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Название задачи *" Style="{StaticResource GlassFieldLabelStyle}"/>
                                <TextBox x:Name="txtTitle"
                                         ToolTip="Введите название задачи"
                                         Margin="0,0,0,16"/>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Описание"
                                               Style="{StaticResource GlassFieldLabelStyle}"
                                               VerticalAlignment="Center"
                                               Margin="2,0,0,0"/>
                                    <Button x:Name="btnGenerateDescription"
                                            Grid.Column="1"
                                            Content="AI-описание"
                                            Click="BtnGenerateDescription_Click"
                                            Padding="12,4"
                                            MinWidth="150"/>
                                </Grid>
                                <TextBox x:Name="txtDescription"
                                         ToolTip="Опишите, что нужно выполнить. Можно оставить пустым."
                                         Margin="0,0,0,8"
                                         Height="70"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"/>
                                <TextBlock x:Name="txtAiHint"
                                           Text="Генерация описания через LM Studio по названию задачи."
                                           Foreground="{DynamicResource AppSubtleTextBrush}"
                                           FontSize="11"/>
                            </StackPanel>
                        </Border>

                        <!-- Даты -->
                        <Border Margin="0,0,0,12"
                                Padding="20"
                                Background="{DynamicResource GlassCardBrush}"
                                BorderBrush="{DynamicResource GlassShellBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="18">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.10" Color="#7B91B2"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Дата начала *" Style="{StaticResource GlassFieldLabelStyle}"/>
                                    <DatePicker x:Name="dpStartDate"
                                                ToolTip="Укажите дату начала работ"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                    <TextBlock Text="Дата окончания *" Style="{StaticResource GlassFieldLabelStyle}"/>
                                    <DatePicker x:Name="dpEndDate"
                                                ToolTip="Укажите срок выполнения задачи"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Объект, бригада, приоритет -->
                        <Border Padding="20"
                                Background="{DynamicResource GlassCardBrush}"
                                BorderBrush="{DynamicResource GlassShellBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="18">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.10" Color="#7B91B2"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Объект *" Style="{StaticResource GlassFieldLabelStyle}"/>
                                    <ComboBox x:Name="cbSites"
                                              ToolTip="Выберите объект, где выполняются работы">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding SiteName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="Бригада *" Style="{StaticResource GlassFieldLabelStyle}"/>
                                    <ComboBox x:Name="cbCrews"
                                              ToolTip="Выберите ответственную бригаду">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding CrewName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                    <TextBlock Text="Приоритет *" Style="{StaticResource GlassFieldLabelStyle}"/>
                                    <ComboBox x:Name="cbPriorities"
                                              ToolTip="Выберите приоритет задачи">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding PriorityName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Материалы">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border x:Name="borderAwaitMTS"
                            Grid.Row="0"
                            Background="{DynamicResource AppWarningBrush}"
                            Padding="10,8"
                            Margin="0,0,0,10"
                            CornerRadius="14"
                            Visibility="Collapsed">
                        <TextBlock Text="Ожидание МТС"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AppNavigationBrush}"/>
                    </Border>

                    <Border Grid.Row="1"
                            Margin="0,0,0,12"
                            Background="{DynamicResource GlassCardBrush}"
                            BorderBrush="{DynamicResource GlassShellBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="18"
                            ClipToBounds="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.10" Color="#7B91B2"/>
                        </Border.Effect>
                        <DataGrid x:Name="dgMaterialRequests"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionChanged="DgMaterialRequests_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Статус" Binding="{Binding StatusDisplay}" Width="120"/>
                                <DataGridTextColumn Header="Требуется к" Binding="{Binding RequiredDateDisplay}" Width="120"/>
                                <DataGridTextColumn Header="Создана" Binding="{Binding CreatedAtDisplay}" Width="130"/>
                                <DataGridTextColumn Header="Позиций" Binding="{Binding ItemsCount}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnNewRequest"
                                Content="Новая заявка"
                                Click="BtnNewRequest_Click"
                                Margin="0,0,8,0"
                                Width="140"
                                Style="{StaticResource AppRaisedButton}"/>
                        <Button x:Name="btnEditRequest"
                                Content="Редактировать"
                                Click="BtnEditRequest_Click"
                                Margin="0,0,8,0"
                                Width="150"
                                Style="{StaticResource AppOutlinedButton}"/>
                        <Button x:Name="btnViewRequestHistory"
                                Content="История"
                                Click="BtnViewRequestHistory_Click"
                                Width="100"
                                Style="{StaticResource AppOutlinedButton}"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="События" x:Name="tabEvents">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Последние события" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                            
                            <Border BorderBrush="{DynamicResource AppBorderBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="14"
                                    Padding="10"
                                    Background="{DynamicResource AppSurfaceAltBrush}"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Добавить отчет по задаче" 
                                               FontSize="12" 
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppTextBrush}"
                                               Margin="0,0,0,8"/>
                                    <TextBox x:Name="txtEventComment"
                                             ToolTip="Введите комментарий к отчету"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             FontSize="12"
                                             Background="{DynamicResource AppInputBackgroundBrush}"
                                             BorderBrush="{DynamicResource AppBorderBrush}"
                                             Padding="8"
                                             MinHeight="50"
                                             MaxHeight="100"
                                             VerticalScrollBarVisibility="Auto"
                                             Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="Прогресс, %"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource AppTextBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>
                                        <TextBox x:Name="txtEventProgressPercent"
                                                 ToolTip="Введите прогресс от 0 до 100"
                                                 Grid.Column="1"
                                                 Height="32"
                                                 FontSize="12"
                                                 Padding="8,0"
                                                 MaxLength="3"
                                                 VerticalContentAlignment="Center"
                                                 Background="{DynamicResource AppInputBackgroundBrush}"
                                                 BorderBrush="{DynamicResource AppBorderBrush}"
                                                 BorderThickness="1"
                                                 PreviewTextInput="ProgressTextBox_PreviewTextInput"
                                                 DataObject.Pasting="ProgressTextBox_Pasting"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="Необязательно"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource AppSubtleTextBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,0,0"/>
                                        <Button Grid.Column="3"
                                                Content="Добавить отчет" 
                                                x:Name="btnAddEventComment"
                                                Click="BtnAddEventComment_Click"
                                                Width="130" 
                                                Height="32"
                                                HorizontalAlignment="Left"
                                                Margin="10,0,0,0"
                                                Padding="8,0"
                                                FontSize="12"/>
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="txtEventAttachment"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="1"
                                                Content="Прикрепить файл"
                                            Click="BtnAttachEventFile_Click"
                                            Style="{StaticResource ModernOutlinedButtonStyle}"
                                                Padding="10,4"
                                                Margin="12,0,0,0"/>
                                        <Button x:Name="btnRemoveEventAttachment"
                                                Grid.Column="2"
                                                Content="Удалить"
                                            Click="BtnRemoveEventAttachment_Click"
                                            Style="{StaticResource GlassDangerButtonStyle}"
                                                Padding="10,4"
                                                Margin="8,0,0,0"
                                                Visibility="Collapsed"/>
                                    </Grid>
                                    <TextBlock Text="Файл будет сохранен после кнопки «Добавить отчет» и появится ниже в списке вложений."
                                               FontSize="11"
                                               Foreground="{DynamicResource AppSubtleTextBrush}"
                                               Margin="0,6,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            
                            <StackPanel x:Name="pnlQuickNote" Visibility="Collapsed" Margin="0,5,0,0">
                                <TextBox x:Name="txtQuickNote" 
                                        Width="350" 
                                        Height="32" 
                                        Margin="0,0,0,8"
                                        TextChanged="TxtQuickNote_TextChanged"
                                        KeyDown="TxtQuickNote_KeyDown"
                                        VerticalContentAlignment="Center"
                                        FontSize="13"
                                        Padding="8,0">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="ToolTip" Value="Введите короткую пометку"/>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Прогресс, %"
                                               FontSize="12"
                                               Foreground="{DynamicResource AppTextBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <TextBox x:Name="txtQuickNoteProgressPercent"
                                             ToolTip="Введите прогресс от 0 до 100"
                                             Width="70"
                                             Height="32"
                                             Margin="0,0,12,0"
                                             FontSize="12"
                                             Padding="8,0"
                                             MaxLength="3"
                                             VerticalContentAlignment="Center"
                                             TextChanged="TxtQuickNoteProgressPercent_TextChanged"
                                             PreviewTextInput="ProgressTextBox_PreviewTextInput"
                                             DataObject.Pasting="ProgressTextBox_Pasting"/>
                                    <TextBlock Text="Необязательно"
                                               FontSize="11"
                                               Foreground="{DynamicResource AppSubtleTextBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"/>
                                    <Button x:Name="btnSaveNote" 
                                           Content="Сохранить" 
                                           Click="BtnSaveNote_Click" 
                                           Width="100" 
                                           Height="32"
                                           Margin="0,0,8,0"
                                           IsEnabled="False"
                                           Padding="8,0"
                                           FontSize="13"/>
                                    <Button x:Name="btnCancelNote" 
                                           Content="Отмена" 
                                           Click="BtnCancelNote_Click" 
                                           Width="90" 
                                           Height="32"
                                           Padding="8,0"
                                           FontSize="13"/>
                                </StackPanel>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="txtQuickNoteAttachment"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="1"
                                            Content="Прикрепить файл"
                                            Click="BtnAttachQuickNoteFile_Click"
                                            Style="{StaticResource ModernOutlinedButtonStyle}"
                                            Padding="10,4"
                                            Margin="12,0,0,0"/>
                                    <Button x:Name="btnRemoveQuickNoteAttachment"
                                            Grid.Column="2"
                                            Content="Удалить"
                                            Click="BtnRemoveQuickNoteAttachment_Click"
                                            Style="{StaticResource GlassDangerButtonStyle}"
                                            Padding="10,4"
                                            Margin="8,0,0,0"
                                            Visibility="Collapsed"/>
                                </Grid>
                            </StackPanel>
                            <Button x:Name="btnAddQuickNote" 
                                   Content="+ заметка" 
                                   Click="BtnAddQuickNote_Click" 
                                   MinWidth="130" 
                                   Padding="10,0"
                                   Height="30"
                                   HorizontalAlignment="Left"
                                   Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Background="{DynamicResource AppSurfaceAltBrush}"
                                Padding="10"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Вложения задачи"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Foreground="{DynamicResource AppTextBrush}"
                                           Margin="0,0,0,8"/>
                                <TextBlock x:Name="txtNoTaskAttachments"
                                           Text="Пока нет сохраненных вложений."
                                           FontSize="12"
                                           Foreground="{DynamicResource AppSubtleTextBrush}"/>
                                <ItemsControl x:Name="icTaskAttachments">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource AppBorderBrush}"
                                                    BorderThickness="0,1,0,0"
                                                    Padding="0,8,0,0"
                                                    Margin="0,8,0,0">
                                                <DockPanel LastChildFill="False">
                                                    <StackPanel DockPanel.Dock="Left" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding FileName}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AppTextBrush}"/>
                                                        <TextBlock Text="{Binding MetaText}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource AppSubtleTextBrush}"
                                                                   Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Button DockPanel.Dock="Right"
                                                            Content="Открыть"
                                                            Click="BtnOpenTaskAttachmentFromList_Click"
                                                            Style="{StaticResource AppAttachmentButtonStyle}"
                                                            Padding="10,3"
                                                            VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <ListBox x:Name="lbEvents"
                                Grid.Row="1"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="0,8,0,8" Margin="0,0,0,5">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" FontSize="13"/>
                                            <TextBlock Text="{Binding TimeInfo}" FontSize="11" Foreground="{DynamicResource AppSubtleTextBrush}" Margin="0,4,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding AttachmentFileName}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AppMutedTextBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasAttachment}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Button Content="Открыть вложение"
                                                        Click="BtnOpenEventAttachment_Click"
                                                        Margin="12,0,0,0"
                                                        Padding="10,3">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource AppAttachmentButtonStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasAttachment}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" Style="{StaticResource GlassFooterBarStyle}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnPrint"
                        Content="Печать"
                        Click="BtnPrint_Click"
                        Width="110"
                        Margin="0,0,12,0"
                        Visibility="Collapsed"
                        Style="{StaticResource AppOutlinedButton}"/>
                <Button x:Name="btnSave"
                        Content="Сохранить"
                        Click="BtnSave_Click"
                        Width="120"
                        Margin="0,0,12,0"
                        Style="{StaticResource ModernButtonStyle}"/>
                <Button x:Name="btnCancel"
                        Content="Отмена"
                        Click="BtnCancel_Click"
                        Width="110"
                        Style="{StaticResource ModernOutlinedButtonStyle}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
