<Window x:Class="praktik.TaskQRCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="QR-код задачи" Height="650" Width="550" 
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource GlassWindowStyle}">
    <Grid Style="{StaticResource GlassWindowRootStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Style="{StaticResource GlassToolbarStyle}">
            <StackPanel>
                <TextBlock Text="QR-КОД ЗАДАЧИ" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource AppAccentBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>
                <TextBlock x:Name="txtTitle" 
                           FontSize="16" 
                           FontWeight="SemiBold" 
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource AppTextBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Основное содержимое -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,25" HorizontalAlignment="Center">
                
                <!-- QR-код -->
                <Border BorderBrush="{DynamicResource AppBorderBrush}" 
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="20"
                        Background="{DynamicResource AppSurfaceBrush}"
                        Margin="0,0,0,25">
                    <StackPanel HorizontalAlignment="Center">
                        <Image x:Name="imgQRCode"
                               Width="280"
                               Height="280"
                               Stretch="Uniform"
                               Margin="0,0,0,15"/>
                        <TextBlock Text="Отсканируйте для быстрого доступа к задаче"
                                   FontSize="12"
                                   Foreground="{DynamicResource AppSubtleTextBrush}"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Информация о задаче -->
                <Border BorderBrush="{DynamicResource AppBorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="18"
                        Padding="20"
                        Background="{DynamicResource AppSurfaceAltBrush}"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="ИНФОРМАЦИЯ О ЗАДАЧЕ" 
                                   FontWeight="Bold" 
                                   FontSize="13" 
                                   Margin="0,0,0,15" 
                                   Foreground="{DynamicResource AppMutedTextBrush}"/>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ID задачи:" FontSize="13" Foreground="{DynamicResource AppMutedTextBrush}"/>
                            <TextBlock x:Name="txtTaskId" Grid.Column="1" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Объект:" FontSize="13" Foreground="{DynamicResource AppMutedTextBrush}"/>
                            <TextBlock x:Name="txtSite" Grid.Column="1" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource AppTextBrush}"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Бригада:" FontSize="13" Foreground="{DynamicResource AppMutedTextBrush}"/>
                            <TextBlock x:Name="txtCrew" Grid.Column="1" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource AppTextBrush}"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Приоритет:" FontSize="13" Foreground="{DynamicResource AppMutedTextBrush}"/>
                            <TextBlock x:Name="txtPriority" Grid.Column="1" FontSize="13" Foreground="{DynamicResource AppTextBrush}"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Период:" FontSize="13" Foreground="{DynamicResource AppMutedTextBrush}"/>
                            <TextBlock x:Name="txtPeriod" Grid.Column="1" FontSize="13" Foreground="{DynamicResource AppTextBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Текстовые данные QR-кода -->
                <Border BorderBrush="{DynamicResource AppBorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="18"
                        Padding="15"
                        Background="{DynamicResource AppSurfaceBrush}">
                    <StackPanel>
                        <TextBlock Text="Данные QR-кода (для копирования)" 
                                   FontSize="11" 
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                   Margin="0,0,0,8"/>
                        <TextBox x:Name="txtQRData"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 FontSize="10"
                                 FontFamily="Consolas"
                                 Background="{DynamicResource AppGlassSoftBrush}"
                                 BorderBrush="{DynamicResource AppGlassBorderBrush}"
                                 Padding="8"
                                 MaxHeight="80"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки -->
        <Border Grid.Row="2" Style="{StaticResource GlassFooterBarStyle}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Сохранить как изображение" 
                        x:Name="btnSaveImage"
                        Click="BtnSaveImage_Click"
                        Width="220" 
                        Height="40"
                        FontSize="14"
                        FontWeight="Medium"
                        Margin="0,0,15,0"
                        Style="{StaticResource ModernButtonStyle}"/>
                
                <Button Content="Закрыть" 
                        Click="BtnClose_Click" 
                        Width="120" 
                        Height="40"
                        FontSize="14"
                        FontWeight="Medium"
                        Style="{StaticResource ModernOutlinedButtonStyle}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

