<Window x:Class="praktik.QuickNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Быстрая заметка"
        Height="260"
        Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Style="{StaticResource GlassWindowStyle}">
    <Grid Style="{StaticResource GlassWindowRootStyle}">
        <Border Style="{StaticResource GlassDialogCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Короткая пометка"
                           Style="{StaticResource GlassFieldLabelStyle}"/>

                <TextBox x:Name="txtNote"
                         Grid.Row="1"
                         Height="40"
                         TextChanged="TxtNote_TextChanged"
                         KeyDown="TxtNote_KeyDown"
                         VerticalContentAlignment="Center"
                         Margin="0,0,0,16"/>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,0,18">
                    <TextBlock Text="Прогресс, %"
                               FontSize="13"
                               Foreground="{DynamicResource AppMutedTextBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBox x:Name="txtProgressPercent"
                             Width="90"
                             Height="36"
                             FontSize="14"
                             Padding="10,0"
                             MaxLength="3"
                             VerticalContentAlignment="Center"
                             PreviewTextInput="ProgressTextBox_PreviewTextInput"
                             DataObject.Pasting="ProgressTextBox_Pasting"/>
                    <TextBlock Text="Необязательно"
                               FontSize="12"
                               Foreground="{DynamicResource AppSubtleTextBrush}"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="btnSave"
                            Content="Сохранить"
                            Click="BtnSave_Click"
                            Style="{StaticResource AppRaisedButton}"
                            Width="120"
                            Margin="0,0,10,0"
                            IsEnabled="False"/>
                    <Button x:Name="btnCancel"
                            Content="Отмена"
                            Click="BtnCancel_Click"
                            Style="{StaticResource AppOutlinedButton}"
                            Width="110"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
