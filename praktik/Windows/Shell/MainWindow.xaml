                    <Border Style="{StaticResource ModernCardStyle}" Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Margin="16">
                            <WrapPanel>
                                <Button Click="BtnDailyPlanPrevDay_Click"
                                        Style="{StaticResource AppOutlinedButton}"
                                        Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M 12 4 L 6 10 L 12 16"
                                              Width="16"
                                              Height="16"
                                              Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Margin="0,0,8,0"
                                              VerticalAlignment="Center"/>
                                        <TextBlock Text="Пред." VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <DatePicker x:Name="dpDailyPlanDate"
                                            SelectedDateChanged="DpDailyPlanDate_SelectedDateChanged"
                                            Width="160" Margin="0,0,8,8"/>
                                <Button Content="Сегодня"
                                        Click="BtnDailyPlanToday_Click"
                                        Style="{StaticResource AppOutlinedButton}"
                                        Margin="0,0,8,8"/>
                                <Button Click="BtnDailyPlanNextDay_Click"
                                        Style="{StaticResource AppOutlinedButton}"
                                        Margin="0,0,24,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="След." VerticalAlignment="Center"/>
                                        <Path Data="M 6 4 L 12 10 L 6 16"
                                              Width="16"
                                              Height="16"
                                              Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Border x:Name="bdDailyPlanStatus" CornerRadius="14" Padding="12,4"
                                        Background="{DynamicResource AppPanelBrush}"
                                        VerticalAlignment="Center" Margin="0,0,0,8">
                                    <TextBlock x:Name="txtDailyPlanStatus" Text="Нет плана"
                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Border>
                            </WrapPanel>
                            <TextBlock x:Name="txtDailyPlanInfo"
                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                       FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Основная область: левая панель задач + правая панель плана -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ЛЕВАЯ: доступные задачи -->
                        <Grid Grid.Column="0" Margin="0,0,8,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource ModernCardStyle}" Grid.Row="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Margin="16,16,16,8">
                                        <TextBlock Text="Доступные задачи"
                                                   Style="{StaticResource SubHeaderTextStyle}"/>
                                        <TextBlock Text="Нажмите «Выбрать» на задаче, чтобы добавить её в план."
                                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                                   FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                                  Margin="8,0,8,8">
                                        <StackPanel>
                                            <TextBlock x:Name="txtNoAvailableTasks"
                                                       Text="На выбранную дату задач нет."
                                                       Margin="8,8,0,0"
                                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                                       Visibility="Collapsed"/>
                                            <ItemsControl x:Name="icAvailablePlanTasks">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource ModernCardStyle}" Margin="0,0,0,8" Padding="12">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>

                                                                <TextBlock Grid.Row="0"
                                                                           Text="{Binding Title}"
                                                                           FontWeight="SemiBold"
                                                                           FontSize="14"
                                                                           TextWrapping="Wrap"
                                                                           Foreground="{DynamicResource AppTextBrush}"/>

                                                                <WrapPanel Grid.Row="1" Margin="0,6,0,0">
                                                                    <Border Background="{DynamicResource AppPanelBrush}"
                                                                            CornerRadius="8" Padding="8,3" Margin="0,0,6,4">
                                                                        <TextBlock Text="{Binding SiteName}" FontSize="11"/>
                                                                    </Border>
                                                                    <Border Background="{DynamicResource AppPanelBrush}"
                                                                            CornerRadius="8" Padding="8,3" Margin="0,0,6,4">
                                                                        <TextBlock Text="{Binding PriorityName}" FontSize="11"/>
                                                                    </Border>
                                                                    <Border Background="{DynamicResource AppPanelBrush}"
                                                                            CornerRadius="8" Padding="8,3" Margin="0,0,6,4">
                                                                        <TextBlock Text="{Binding StatusName}" FontSize="11"/>
                                                                    </Border>
                                                                    <Border Background="{DynamicResource AppPanelBrush}"
                                                                            CornerRadius="8" Padding="8,3" Margin="0,0,0,4">
                                                                        <TextBlock Text="{Binding DateRange}" FontSize="11"/>
                                                                    </Border>
                                                                </WrapPanel>

                                                                <Border Grid.Row="2"
                                                                        Background="{DynamicResource AppPanelBrush}"
                                                                        CornerRadius="14"
                                                                        Padding="8,4"
                                                                        Margin="0,4,0,0"
                                                                        Visibility="{Binding MaterialWarningVisibility}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Path Data="M 8 2 L 15 14 L 1 14 Z M 8 6 L 8 9 M 8 12 L 8 12.2"
                                                                              Width="14"
                                                                              Height="14"
                                                                              Stretch="Uniform"
                                                                              Stroke="{DynamicResource AppWarningBrush}"
                                                                              StrokeThickness="1.8"
                                                                              StrokeStartLineCap="Round"
                                                                              StrokeEndLineCap="Round"
                                                                              StrokeLineJoin="Round"
                                                                              Fill="Transparent"
                                                                              VerticalAlignment="Center"
                                                                              Margin="0,0,6,0"/>
                                                                        <TextBlock Text="Материалы не готовы"
                                                                                   Foreground="{DynamicResource AppWarningBrush}"
                                                                                   FontSize="11"/>
                                                                    </StackPanel>
                                                                </Border>

                                                                <Grid Grid.Row="3" Margin="0,8,0,0">
                                                                    <Button Tag="{Binding TaskId}"
                                                                            Click="BtnSelectPlanTask_Click"
                                                                            Style="{StaticResource AppOutlinedButton}"
                                                                            Height="28" FontSize="12"
                                                                            HorizontalAlignment="Left"
                                                                            Visibility="{Binding NotInPlanVisibility}">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="Выбрать" VerticalAlignment="Center"/>
                                                                            <Path Data="M 6 4 L 12 10 L 6 16"
                                                                                  Width="14"
                                                                                  Height="14"
                                                                                  Stretch="Uniform"
                                                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                                  StrokeThickness="2"
                                                                                  StrokeStartLineCap="Round"
                                                                                  StrokeEndLineCap="Round"
                                                                                  StrokeLineJoin="Round"
                                                                                  Margin="6,0,0,0"
                                                                                  VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </Button>
                                                                    <StackPanel Orientation="Horizontal"
                                                                                Visibility="{Binding InPlanVisibility}"
                                                                                VerticalAlignment="Center">
                                                                        <Path Data="M 4 9 L 8 13 L 15 5"
                                                                              Width="16" Height="16"
                                                                              Stretch="Uniform"
                                                                              Stroke="Green"
                                                                              StrokeThickness="2"
                                                                              StrokeStartLineCap="Round"
                                                                              StrokeEndLineCap="Round"
                                                                              StrokeLineJoin="Round"
                                                                              VerticalAlignment="Center"/>
                                                                        <TextBlock Text="В плане"
                                                                                   Foreground="Green"
                                                                                   Margin="4,0"
                                                                                   VerticalAlignment="Center"
                                                                                   FontWeight="SemiBold"
                                                                                   FontSize="12"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- Панель добавления задачи в план -->
                            <Border Style="{StaticResource ModernCardStyle}" Grid.Row="1"
                                                 x:Name="pnlAddToPlan"
                                                 Visibility="Collapsed"
                                                 Margin="0,8,0,0">
                                <StackPanel Margin="16">
                                    <TextBlock Text="Добавить в план"
                                               Style="{StaticResource SubHeaderTextStyle}"
                                               Margin="0,0,0,8"/>
                                    <TextBlock x:Name="txtAddToPlanTaskName"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,12"
                                               Foreground="{DynamicResource AppTextBrush}"/>
                                    <ComboBox x:Name="cbPlanCrewSelect"
                                              Margin="0,0,0,12">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding CrewName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBox x:Name="txtPlanItemNote"
                                             Margin="0,0,0,12"/>
                                    <CheckBox x:Name="chkPlanItemMaterials"
                                              Content="Материалы готовы"
                                              IsChecked="True"
                                              Margin="0,0,0,12"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="btnConfirmAddToPlan"
                                                Content="ДОБАВИТЬ"
                                                Click="BtnConfirmAddToPlan_Click"
                                                Style="{StaticResource AppRaisedButton}"
                                                Margin="0,0,8,0"/>
                                        <Button Content="ОТМЕНА"
                                                Click="BtnCancelAddToPlan_Click"
                                                Style="{StaticResource AppOutlinedButton}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ПРАВАЯ: план бригад -->
                        <Border Style="{StaticResource ModernCardStyle}" Grid.Column="1" Margin="8,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Text="План бригад на день"
                                           Style="{StaticResource SubHeaderTextStyle}"
                                           Margin="16,16,16,8"/>
                                <ScrollViewer Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              Margin="12,0,12,12">
                                    <StackPanel>
                                        <TextBlock x:Name="txtNoPlanItems"
                                                   Text="Добавьте задачи из левой панели, чтобы сформировать план."
                                                   HorizontalAlignment="Center"
                                                   Margin="24"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                                   Visibility="Visible"/>
                                        <ItemsControl x:Name="icDailyPlanCrews">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,16"
                                                            BorderBrush="{DynamicResource AppBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8">
                                                        <StackPanel>
                                                            <!-- Заголовок бригады -->
                                                            <Border Background="{DynamicResource AppAccentBrush}"
                                                                    CornerRadius="7,7,0,0"
                                                                    Padding="16,10">
                                                                <TextBlock Text="{Binding CrewName}"
                                                                           FontWeight="Bold"
                                                                           Foreground="White"
                                                                           FontSize="14"/>
                                                            </Border>
                                                            <!-- Задачи бригады -->
                                                            <ItemsControl ItemsSource="{Binding Items}"
                                                                          Margin="8,8,8,8">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Margin="0,0,0,6"
                                                                                Background="{DynamicResource AppSurfaceBrush}"
                                                                                CornerRadius="14"
                                                                                Padding="10,8">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="32"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="150"/>
                                                                                    <ColumnDefinition Width="32"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>

                                                                                <TextBlock Grid.Column="0"
                                                                                           Text="{Binding SortOrderText}"
                                                                                           FontWeight="Bold"
                                                                                           FontSize="14"
                                                                                           Foreground="{DynamicResource AppAccentBrush}"
                                                                                           VerticalAlignment="Center"
                                                                                           HorizontalAlignment="Center"/>

                                                                                <StackPanel Grid.Column="1" Margin="6,0">
                                                                                    <TextBlock Text="{Binding Title}"
                                                                                               FontWeight="SemiBold"
                                                                                               FontSize="13"
                                                                                               TextWrapping="Wrap"/>
                                                                                    <TextBlock Text="{Binding SiteName}"
                                                                                               FontSize="11"
                                                                                               Foreground="{DynamicResource AppMutedTextBrush}"/>
                                                                                </StackPanel>

                                                                                <TextBox Grid.Column="2"
                                                                                         Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                         FontSize="11"
                                                                                         Margin="4,0"
                                                                                         VerticalAlignment="Center"/>

                                                                                <CheckBox Grid.Column="3"
                                                                                          IsChecked="{Binding MaterialsReady, Mode=TwoWay}"
                                                                                          ToolTip="Материалы готовы"
                                                                                          VerticalAlignment="Center"
                                                                                          HorizontalAlignment="Center"/>

                                                                                <StackPanel Grid.Column="4"
                                                                                            Orientation="Horizontal"
                                                                                            VerticalAlignment="Center">
                                                                                    <Button Tag="{Binding}"
                                                                                            Click="BtnPlanItemMoveUp_Click"
                                                                                            Style="{StaticResource AppTextButton}"
                                                                                            Width="28" Height="28"
                                                                                            Padding="0" MinWidth="0"
                                                                                            ToolTip="Поднять">
                                                                                        <Path Data="M 4 11 L 10 5 L 16 11"
                                                                                              Width="16"
                                                                                              Height="16"
                                                                                              Stretch="Uniform"
                                                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                                              StrokeThickness="2"
                                                                                              StrokeStartLineCap="Round"
                                                                                              StrokeEndLineCap="Round"
                                                                                              StrokeLineJoin="Round"/>
                                                                                    </Button>
                                                                                    <Button Tag="{Binding}"
                                                                                            Click="BtnPlanItemMoveDown_Click"
                                                                                            Style="{StaticResource AppTextButton}"
                                                                                            Width="28" Height="28"
                                                                                            Padding="0" MinWidth="0"
                                                                                            ToolTip="Опустить">
                                                                                        <Path Data="M 4 5 L 10 11 L 16 5"
                                                                                              Width="16"
                                                                                              Height="16"
                                                                                              Stretch="Uniform"
                                                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                                              StrokeThickness="2"
                                                                                              StrokeStartLineCap="Round"
                                                                                              StrokeEndLineCap="Round"
                                                                                              StrokeLineJoin="Round"/>
                                                                                    </Button>
                                                                                    <Button Tag="{Binding}"
                                                                                            Click="BtnPlanItemRemove_Click"
                                                                                            Style="{StaticResource AppTextButton}"
                                                                                            Width="28" Height="28"
                                                                                            Padding="0" MinWidth="0"
                                                                                            Foreground="#E53935"
                                                                                            ToolTip="Удалить">
                                                                                        <Path Data="M 5 5 L 15 15 M 15 5 L 5 15"
                                                                                              Width="16"
                                                                                              Height="16"
                                                                                              Stretch="Uniform"
                                                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                                              StrokeThickness="2"
                                                                                              StrokeStartLineCap="Round"
                                                                                              StrokeEndLineCap="Round"/>
                                                                                    </Button>
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Нижняя панель: сохранить / утвердить -->
                    <Border Style="{StaticResource ModernCardStyle}" Grid.Row="2" Margin="0,12,0,0">
                        <StackPanel Margin="16" Orientation="Horizontal">
                            <Button x:Name="btnSaveDailyPlan"
                                    Content="СОХРАНИТЬ ЧЕРНОВИК"
                                    Click="BtnSaveDailyPlan_Click"
                                    Style="{StaticResource AppRaisedButton}"
                                    Margin="0,0,12,0"/>
                            <Button x:Name="btnApproveDailyPlan"
                                    Content="УТВЕРДИТЬ ПЛАН"
                                    Click="BtnApproveDailyPlan_Click"
                                    Style="{StaticResource AppOutlinedButton}"
                                    Margin="0,0,24,0"/>
                            <TextBlock x:Name="txtDailyPlanSaveStatus"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                       FontSize="12"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <!-- ===== КОНЕЦ ПЛАНА НА ДЕНЬ ===== -->

            </Grid>
        </DockPanel>
    </Grid>
</UserControl>

