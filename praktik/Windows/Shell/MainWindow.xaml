                                       Click="BtnMREdit_Click" Style="{StaticResource AppOutlinedButton}"
                                       Margin="0,0,0,8" Width="200" Height="40"/>
                                <Button x:Name="btnMRExport" Content="Экспорт"
                                       Click="BtnMRExport_Click" Style="{StaticResource AppRaisedButton}"
                                       Width="200" Height="40"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

