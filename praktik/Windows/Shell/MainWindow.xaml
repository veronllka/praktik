                                            <DataTemplate>
                                                <TextBlock Text="{Binding SiteName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                    <TextBlock Text="Бригада"
                                               FontSize="11" FontWeight="Medium"
                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                               Margin="0,0,0,4"/>
                                    <ComboBox x:Name="cbMRCrewFilter"
                                              SelectionChanged="MRFilter_Changed">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding CrewName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                    <TextBlock Text="Требуется к (от)"
