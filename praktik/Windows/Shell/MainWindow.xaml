<UserControl x:Class="praktik.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:praktik"
        xmlns:appControls="clr-namespace:praktik.Controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Background="{DynamicResource ShellWindowBackgroundBrush}"
        SizeChanged="MainWindow_SizeChanged">
    <UserControl.Resources>
        <LinearGradientBrush x:Key="ShellWindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#56EEF4FF" Offset="0"/>
            <GradientStop Color="#48DDEBFF" Offset="0.5"/>
            <GradientStop Color="#4ADFD8F8" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ShellPanelSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#78F7FBFF" Offset="0"/>
            <GradientStop Color="#62EAF2FF" Offset="0.52"/>
            <GradientStop Color="#5EE6E0FA" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ShellHeroWashBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#46FFFFFF" Offset="0"/>
            <GradientStop Color="#22DCE8FF" Offset="0.58"/>
            <GradientStop Color="#30E5DBFF" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="ShellMaterialIconStyle" TargetType="{x:Type iconPacks:PackIconMaterial}">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ShellNavIconTileStyle" TargetType="{x:Type Border}">
            <Setter Property="Width" Value="31"/>
            <Setter Property="Height" Value="31"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="#B8FFFFFF"/>
            <Setter Property="BorderBrush" Value="#74FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ShellRoundActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource GlassIconButtonStyle}">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="MinWidth" Value="46"/>
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="Background" Value="#68FFFFFF"/>
            <Setter Property="BorderBrush" Value="#9EFFFFFF"/>
        </Style>

        <Style x:Key="ShellStatIconStyle" TargetType="{x:Type iconPacks:PackIconMaterial}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="AppRootGrid">
        <Grid IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="360" Height="360"
                     Fill="{DynamicResource AppAmbientCircleAltBrush}"
                     Opacity="0.55"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Bottom"
                     Margin="-130,0,0,-150"/>
            <Ellipse Width="420" Height="420"
                     Fill="{DynamicResource AppAmbientCircleBrush}"
                     Opacity="0.5"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     Margin="0,-180,-170,0"/>
            <Path Data="M 0 560 C 260 470 470 650 710 520 C 910 410 1090 455 1400 350 L 1400 800 L 0 800 Z"
                  Fill="{DynamicResource AppWaveBrush}"
                  Opacity="0.18"
                  Stretch="Fill"/>
        </Grid>

        <!-- Backdrop overlay for drawers -->
        <Border x:Name="DrawerOverlay" Background="#80000000" Panel.ZIndex="100" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" MouseDown="DrawerOverlay_MouseDown"/>

        <Border x:Name="LeftDrawerPanel"
                Width="226"
                HorizontalAlignment="Left"
                Panel.ZIndex="1"
                Margin="14,14,0,14"
                CornerRadius="28"
                Background="{StaticResource ShellPanelSurfaceBrush}"
                BorderBrush="{StaticResource GlassShellBorderBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000"
                                  BlurRadius="34"
                                  ShadowDepth="12"
                                  Direction="0"
                                  Opacity="0.13"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="LeftDrawerTranslate" X="0"/>
            </Border.RenderTransform>
            <DockPanel MinWidth="220" Background="Transparent" LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="18,18,18,18">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44"
                                Height="44"
                                CornerRadius="14"
                                Background="{StaticResource GlassPrimaryGradientBrush}"
                                BorderBrush="#70FFFFFF"
                                BorderThickness="1"
                                Margin="0,0,12,0">
                            <iconPacks:PackIconMaterial Kind="AccountGroup"
                                                        Width="24"
                                                        Height="24"
                                                        Foreground="White"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Практик"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextBrush}"/>
                            <TextBlock Text="Планировщик"
                                       FontSize="11"
                                       Foreground="{DynamicResource AppMutedTextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Bottom"
                        Margin="16,0,16,16"
                        Padding="8"
                        CornerRadius="20"
                        Background="#52FFFFFF"
                        BorderBrush="#86FFFFFF"
                        BorderThickness="1">
                    <Button x:Name="BtnCollapseNav"
                            MinWidth="0"
                            Width="Auto"
                            Height="38"
                            Padding="10,0"
                            HorizontalAlignment="Stretch"
                            Click="BtnCollapseNav_Click"
                            Style="{StaticResource GlassIconButtonStyle}"
                            ToolTip="Свернуть панель">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="ChevronLeft"
                                                        Width="18"
                                                        Height="18"
                                                        Foreground="{DynamicResource AppMutedTextBrush}"
                                                        VerticalAlignment="Center"/>
                            <TextBlock Text="Свернуть"
                                       Margin="8,0,0,0"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Border>

                <ListBox x:Name="NavigationListBox"
                         SelectionChanged="NavigationListBox_SelectionChanged"
                         ItemContainerStyle="{StaticResource GlassNavigationListBoxItemStyle}"
                         Margin="12,0,12,10"
                         Padding="0"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBoxItem x:Name="DashboardMenuItem">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource ShellNavIconTileStyle}">
                                <iconPacks:PackIconMaterial Kind="Home" Style="{StaticResource ShellMaterialIconStyle}"/>
                            </Border>
                            <TextBlock Text="Главная" Margin="12,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="TasksMenuItem">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource ShellNavIconTileStyle}">
                                <iconPacks:PackIconMaterial Kind="ClipboardText" Style="{StaticResource ShellMaterialIconStyle}"/>
                            </Border>
                            <TextBlock Text="Задачи" Margin="12,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="CrewsMenuItem">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource ShellNavIconTileStyle}">
                                <iconPacks:PackIconMaterial Kind="AccountGroup" Style="{StaticResource ShellMaterialIconStyle}"/>
                            </Border>
                            <TextBlock Text="Бригады" Margin="12,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="ReportsMenuItem">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource ShellNavIconTileStyle}">
                                <iconPacks:PackIconMaterial Kind="ChartBar" Style="{StaticResource ShellMaterialIconStyle}"/>
                            </Border>
                            <TextBlock Text="Отчёты" Margin="12,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="CalendarMenuItem">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource ShellNavIconTileStyle}">
                                <iconPacks:PackIconMaterial Kind="Calendar" Style="{StaticResource ShellMaterialIconStyle}"/>
                            </Border>
                            <TextBlock Text="Календарь" Margin="12,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="SitesMenuItem">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource ShellNavIconTileStyle}">
                                <iconPacks:PackIconMaterial Kind="MapMarker" Style="{StaticResource ShellMaterialIconStyle}"/>
                            </Border>
                            <TextBlock Text="Стройплощадки" Margin="12,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="MaterialRequestsMenuItem">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource ShellNavIconTileStyle}">
                                <iconPacks:PackIconMaterial Kind="ViewGridOutline" Style="{StaticResource ShellMaterialIconStyle}"/>
                            </Border>
                            <TextBlock Text="Материалы" Margin="12,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="DailyPlanMenuItem">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource ShellNavIconTileStyle}">
                                <iconPacks:PackIconMaterial Kind="CalendarCheck" Style="{StaticResource ShellMaterialIconStyle}"/>
                            </Border>
                            <TextBlock Text="План на день" Margin="12,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="RolesMenuItem">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource ShellNavIconTileStyle}">
                                <iconPacks:PackIconMaterial Kind="LockOutline" Style="{StaticResource ShellMaterialIconStyle}"/>
                            </Border>
                            <TextBlock Text="Роли и доступ" Margin="12,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="AppearanceSettingsMenuItem">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource ShellNavIconTileStyle}">
                                <iconPacks:PackIconMaterial Kind="Palette" Style="{StaticResource ShellMaterialIconStyle}"/>
                            </Border>
                            <TextBlock Text="Оформление" Margin="12,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Collapsed Navigation Strip (shown when sidebar is collapsed) -->
        <Border x:Name="CollapsedNavStrip"
                Width="70"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Panel.ZIndex="2"
                Visibility="Collapsed"
                Margin="14,14,0,14"
                CornerRadius="26"
                Background="{StaticResource ShellPanelSurfaceBrush}"
                BorderBrush="{StaticResource GlassShellBorderBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="10" Direction="0" Opacity="0.13"/>
            </Border.Effect>
            <Grid>
                <Border Width="42"
                        Height="42"
                        CornerRadius="15"
                        Background="{StaticResource GlassPrimaryGradientBrush}"
                        BorderBrush="#70FFFFFF"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,18,0,0">
                    <iconPacks:PackIconMaterial Kind="AccountGroup"
                                                Width="22"
                                                Height="22"
                                                Foreground="White"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                </Border>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="14" Background="#66FFFFFF" BorderBrush="#80FFFFFF" BorderThickness="1" Margin="0,0,0,12">
                        <iconPacks:PackIconMaterial Kind="Home" Style="{StaticResource ShellMaterialIconStyle}"/>
                    </Border>
                    <Border Width="38" Height="38" CornerRadius="14" Background="#46FFFFFF" BorderBrush="#70FFFFFF" BorderThickness="1" Margin="0,0,0,12">
                        <iconPacks:PackIconMaterial Kind="ClipboardText" Style="{StaticResource ShellMaterialIconStyle}"/>
                    </Border>
                    <Border Width="38" Height="38" CornerRadius="14" Background="#46FFFFFF" BorderBrush="#70FFFFFF" BorderThickness="1">
                        <iconPacks:PackIconMaterial Kind="ChartBar" Style="{StaticResource ShellMaterialIconStyle}"/>
                    </Border>
                </StackPanel>

                <Button Click="BtnCollapseNav_Click"
                        Style="{StaticResource GlassIconButtonStyle}"
                        Width="44"
                        Height="44"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,16"
                        ToolTip="Развернуть панель">
                    <iconPacks:PackIconMaterial Kind="ChevronRight"
                                                Width="20"
                                                Height="20"
                                                Foreground="{DynamicResource AppMutedTextBrush}"/>
                </Button>
            </Grid>
        </Border>

        <!-- Right Drawer Panel -->
        <Border x:Name="RightDrawerPanel" Width="350" HorizontalAlignment="Right" Panel.ZIndex="101" Background="{DynamicResource AppGlassStrongBrush}" Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect Color="#000000"
                                  BlurRadius="28"
                                  ShadowDepth="10"
                                  Direction="180"
                                  Opacity="0.14"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="RightDrawerTranslate" X="0"/>
            </Border.RenderTransform>
            <DockPanel Width="350" Margin="16">
                <TextBlock Text="Справка по функциям" Style="{StaticResource HeaderTextStyle}" DockPanel.Dock="Top"/>
                <Button x:Name="btnCloseHelp" Content="ЗАКРЫТЬ"
                      Click="BtnCloseHelp_Click"
                      Style="{StaticResource AppRaisedButton}"
                      Margin="0,16,0,0"
                      DockPanel.Dock="Bottom"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,16">
                    <StackPanel x:Name="HelpContent">
                        <Expander x:Name="HelpHomeExpander" Header="Главная" IsExpanded="False" Margin="0,0,0,8">
                            <TextBlock TextWrapping="Wrap">
                                Главная страница приложения, показывающая общую статистику:<LineBreak/>
                                • Общее количество задач<LineBreak/>
                                • Количество завершенных задач<LineBreak/>
                                • Количество просроченных задач<LineBreak/>
                                • Количество активных бригад<LineBreak/>
                                • Последние отчеты по задачам
                            </TextBlock>
                        </Expander>

                        <Expander x:Name="HelpSitesExpander" Header="Стройплощадки" IsExpanded="False" Margin="0,0,0,8">
                            <TextBlock TextWrapping="Wrap">
                                Управление объектами строительства:<LineBreak/>
                                • Просмотр списка стройплощадок<LineBreak/>
                                • Добавление новых объектов<LineBreak/>
                                • Редактирование существующих объектов<LineBreak/>
                                • Удаление объектов
                            </TextBlock>
                        </Expander>

                        <Expander x:Name="HelpCrewsExpander" Header="Бригады" IsExpanded="False" Margin="0,0,0,8">
                            <TextBlock TextWrapping="Wrap">
                                Управление строительными бригадами:<LineBreak/>
                                • Просмотр списка бригад<LineBreak/>
                                • Добавление новых бригад<LineBreak/>
                                • Назначение бригадира<LineBreak/>
                                • Редактирование информации о бригаде<LineBreak/>
                                • Удаление бригады
                            </TextBlock>
                        </Expander>

                        <Expander x:Name="HelpTasksExpander" Header="Задачи" IsExpanded="False" Margin="0,0,0,8">
                            <TextBlock TextWrapping="Wrap">
                                Управление задачами для бригад:<LineBreak/>
                                • Просмотр списка всех задач<LineBreak/>
                                • Фильтрация задач по объекту и бригаде<LineBreak/>
                                • Добавление новых задач<LineBreak/>
                                • Редактирование задач<LineBreak/>
                                • Изменение статуса задачи<LineBreak/>
                                • Удаление задач<LineBreak/><LineBreak/>

                                Кнопка "Сбросить фильтр" очищает все примененные фильтры и показывает все задачи.
                            </TextBlock>
                        </Expander>

                        <Expander x:Name="HelpCalendarExpander" Header="Календарь" IsExpanded="False" Margin="0,0,0,8">
                            <TextBlock TextWrapping="Wrap">
                                Календарный вид задач:<LineBreak/>
                                • Выбор даты для просмотра задач<LineBreak/>
                                • Фильтрация задач по объекту и бригаде<LineBreak/>
                                • Просмотр задач на выбранную дату<LineBreak/>
                                • Визуальное представление графика работ
                            </TextBlock>
                        </Expander>

                        <Expander x:Name="HelpReportsExpander" Header="Отчеты" IsExpanded="False" Margin="0,0,0,8">
                            <TextBlock TextWrapping="Wrap">
                                Формирование и экспорт отчетов:<LineBreak/>
                                • Отчет "Задачи по объектам" - статистика задач в разрезе объектов<LineBreak/>
                                • Отчет "Выполнение по бригадам" - статистика выполнения задач бригадами<LineBreak/>
                                • Отчет "Просроченные задачи" - список просроченных задач<LineBreak/><LineBreak/>

                                Экспорт отчетов:<LineBreak/>
                                • CSV - экспорт в формате с разделителями для Excel<LineBreak/>
                                • Excel - экспорт в табличный формат<LineBreak/>
                                • PDF - экспорт в текстовый формат<LineBreak/><LineBreak/>

                                При экспорте сохраняется текущий выбранный тип отчета.
                            </TextBlock>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <DockPanel x:Name="ShellDockPanel" Margin="240,0,0,0">
            <Border DockPanel.Dock="Top"
                    Background="#5EFFFFFF"
                    BorderBrush="{StaticResource GlassShellBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="26"
                    Height="74"
                    Margin="16,14,14,0"
                    Padding="20,0,18,0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000"
                                      BlurRadius="28"
                                      ShadowDepth="10"
                                      Direction="270"
                                      Opacity="0.09"/>
                </Border.Effect>
                <DockPanel>
                    <ToggleButton x:Name="MenuToggleButton"
                                  Visibility="Collapsed"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Padding="8"
                                  ToolTip="Меню"
                                  VerticalAlignment="Center">
                        <appControls:AnimatedHamburgerIcon x:Name="HamburgerIcon"
                                                            IsOpen="{Binding IsChecked, ElementName=MenuToggleButton}"/>
                    </ToggleButton>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Width="34"
                                Height="34"
                                MinWidth="34"
                                MinHeight="34"
                                Padding="0"
                                Margin="0,0,22,0"
                                Style="{StaticResource ShellRoundActionButtonStyle}">
                            <Path Data="M 13 4 L 7 10 L 13 16"
                                  Width="16"
                                  Height="16"
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource AppTextBrush}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                        </Button>
                        <TextBlock x:Name="PageTitle"
                                   Text="Планировщик работ бригад"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextBrush}"
                                   VerticalAlignment="Center"/>
                        <appControls:AnimatedSpinner x:Name="LoadingSpinner"
                                                      Margin="10,0,0,0"
                                                      Width="18" Height="18"
                                                      Visibility="Collapsed"
                                                      VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Border Background="#64FFFFFF"
                                CornerRadius="22"
                                BorderBrush="{StaticResource GlassShellBorderBrush}"
                                BorderThickness="1"
                                Margin="0,0,16,0"
                                Padding="13,8">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="AccountOutline"
                                                            Width="18"
                                                            Height="18"
                                                            Foreground="{DynamicResource AppAccentBrush}"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,9,0"/>
                                <TextBlock x:Name="UserInfo" Text="Загрузка..."
                                           FontSize="12" FontWeight="Medium"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource AppTextBrush}"
                                           Margin="0,0,6,0"/>
                                <Button x:Name="LogoutBtn"
                                        Background="Transparent" BorderThickness="0"
                                        Padding="0" Height="18" Width="18"
                                        ToolTip="Выйти из аккаунта"
                                        Cursor="Hand">
                                    <iconPacks:PackIconMaterial Kind="Logout"
                                                                Width="15"
                                                                Height="15"
                                                                Foreground="{DynamicResource AppMutedTextBrush}"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Button Width="44"
                                Height="44"
                                MinWidth="44"
                                MinHeight="44"
                                Padding="0"
                                Margin="0,0,10,0"
                                Style="{StaticResource ShellRoundActionButtonStyle}">
                            <iconPacks:PackIconMaterial Kind="Bell"
                                                        Width="18"
                                                        Height="18"
                                                        Foreground="{DynamicResource AppMutedTextBrush}"/>
                        </Button>

                        <Button x:Name="btnOpenSettings"
                                ToolTip="Оформление: стиль, шрифт, стекло"
                                Width="44"
                                Height="44"
                                MinWidth="44"
                                MinHeight="44"
                                Padding="0"
                                Margin="0,0,10,0"
                                Click="BtnOpenSettings_Click"
                                Style="{StaticResource ShellRoundActionButtonStyle}">
                            <iconPacks:PackIconMaterial Kind="Palette"
                                                        Width="18"
                                                        Height="18"
                                                        Foreground="{DynamicResource AppMutedTextBrush}"/>
                        </Button>

                        <Button x:Name="btnQuickThemeToggle"
                                ToolTip="Тема"
                                Width="44"
                                Height="44"
                                MinWidth="44"
                                MinHeight="44"
                                Padding="0"
                                Margin="0,0,10,0"
                                Click="BtnQuickThemeToggle_Click"
                                Style="{StaticResource ShellRoundActionButtonStyle}">
                            <TextBlock x:Name="QuickThemeToggleIcon"
                                       Text="&#xE706;"
                                       FontFamily="Segoe MDL2 Assets"
                                       Width="18"
                                       Height="18"
                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>

                        <Button x:Name="btnScanQR"
                                ToolTip="Сканировать QR-код"
                                Width="44"
                                Height="44"
                                MinWidth="44"
                                MinHeight="44"
                                Padding="0"
                                Margin="0,0,10,0"
                                Click="BtnScanQR_Click"
                                Style="{StaticResource ShellRoundActionButtonStyle}">
                            <iconPacks:PackIconMaterial Kind="QrcodeScan"
                                                        Width="18"
                                                        Height="18"
                                                        Foreground="{DynamicResource AppMutedTextBrush}"/>
                        </Button>

                        <ToggleButton x:Name="HelpButton"
                                      Visibility="Collapsed"
                                      Padding="8" Background="Transparent" BorderThickness="0"
                                      ToolTip="Справка" Margin="0,0,8,0">
                            <appControls:AnimatedSparkleIcon AccentBrush="{DynamicResource AppTextBrush}"
                                                              Width="18"
                                                              Height="18"/>
                        </ToggleButton>

                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid x:Name="MainContent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="43*"/>
                    <ColumnDefinition Width="1357*"/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="DashboardContent" Visibility="Visible" Grid.ColumnSpan="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="34,30,34,20">
                            <Border CornerRadius="30"
                                    Background="{StaticResource ShellHeroWashBrush}"
                                    BorderBrush="{StaticResource GlassShellBorderBrush}"
                                    BorderThickness="1"
                                    Padding="28,24"
                                    Margin="0,0,0,24"
                                    ClipToBounds="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="DashboardGreeting"
                                                   Text="Добро пожаловать!"
                                                   FontSize="26"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppTextBrush}"
                                                   Margin="0,0,0,8"/>
                                        <TextBlock Text="Обзор задач, бригад и последних отчётов в едином рабочем пространстве"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource AppMutedTextBrush}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Width="72"
                                            Height="72"
                                            CornerRadius="24"
                                            Background="{StaticResource GlassPrimaryGradientBrush}"
                                            BorderBrush="#70FFFFFF"
                                            BorderThickness="1"
                                            Margin="28,0,0,0">
                                        <iconPacks:PackIconMaterial Kind="ViewDashboard"
                                                                    Width="34"
                                                                    Height="34"
                                                                    Foreground="White"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"/>
                                    </Border>
                                    <Ellipse Width="220"
                                             Height="220"
                                             Fill="{DynamicResource AppAmbientCircleBrush}"
                                             Opacity="0.26"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Top"
                                             Margin="0,-108,-82,0"/>
                                </Grid>
                            </Border>

                            <WrapPanel x:Name="DashboardStatsPanel"
                                       Margin="-8,0,-8,24"
                                       SizeChanged="DashboardStatsPanel_SizeChanged">
                                <Border x:Name="TotalTasksCard" Style="{StaticResource ModernCardStyle}" Height="142" MinWidth="250" ClipToBounds="True" Background="#6AFFFFFF" BorderBrush="#A8FFFFFF" CornerRadius="28">
                                    <Grid>
                                        <Path Data="M 0 35 C 78 58 142 18 230 35 L 230 82 L 0 82 Z"
                                              Fill="#BFDCE8FF"
                                              Opacity="0.46"
                                              Height="62"
                                              VerticalAlignment="Bottom"
                                              Stretch="Fill"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                            <Border Width="62" Height="62" CornerRadius="21" Background="#DDE3EAFF" BorderBrush="{StaticResource GlassShellBorderBrush}" BorderThickness="1" Margin="0,0,26,0">
                                                <iconPacks:PackIconMaterial Kind="ClipboardText" Style="{StaticResource ShellStatIconStyle}"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="TotalTasksCount"
                                                           Text="0"
                                                           FontSize="30"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AppTextBrush}"/>
                                                <TextBlock Text="Всего задач"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource AppMutedTextBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border x:Name="CompletedTasksCard" Style="{StaticResource ModernCardStyle}" Height="142" MinWidth="250" ClipToBounds="True" Background="#6AFFFFFF" BorderBrush="#A8FFFFFF" CornerRadius="28">
                                    <Grid>
                                        <Path Data="M 0 40 C 72 55 133 45 230 22 L 230 82 L 0 82 Z"
                                              Fill="#BAEAF8ED"
                                              Opacity="0.48"
                                              Height="62"
                                              VerticalAlignment="Bottom"
                                              Stretch="Fill"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                            <Border Width="62" Height="62" CornerRadius="21" Background="#D8F7E3" BorderBrush="{StaticResource GlassShellBorderBrush}" BorderThickness="1" Margin="0,0,26,0">
                                                <iconPacks:PackIconMaterial Kind="Check"
                                                                            Width="31"
                                                                            Height="31"
                                                                            Foreground="{DynamicResource AppSuccessBrush}"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="CompletedTasksCount"
                                                           Text="0"
                                                           FontSize="30"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AppTextBrush}"/>
                                                <TextBlock Text="Завершено"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource AppMutedTextBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border x:Name="OverdueTasksCard" Style="{StaticResource ModernCardStyle}" Height="142" MinWidth="250" ClipToBounds="True" Background="#6AFFFFFF" BorderBrush="#A8FFFFFF" CornerRadius="28">
                                    <Grid>
                                        <Path Data="M 0 32 C 65 62 145 52 230 18 L 230 82 L 0 82 Z"
                                              Fill="#C8FFF2D8"
                                              Opacity="0.48"
                                              Height="62"
                                              VerticalAlignment="Bottom"
                                              Stretch="Fill"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                            <Border Width="62" Height="62" CornerRadius="21" Background="#FFF0D2" BorderBrush="{StaticResource GlassShellBorderBrush}" BorderThickness="1" Margin="0,0,26,0">
                                                <iconPacks:PackIconMaterial Kind="AlertCircle"
                                                                            Width="31"
                                                                            Height="31"
                                                                            Foreground="{DynamicResource AppWarningBrush}"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="OverdueTasksCount"
                                                           Text="0"
                                                           FontSize="30"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AppTextBrush}"/>
                                                <TextBlock Text="Просрочено"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource AppMutedTextBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border x:Name="ActiveCrewsCard" Style="{StaticResource ModernCardStyle}" Height="142" MinWidth="250" ClipToBounds="True" Background="#6AFFFFFF" BorderBrush="#A8FFFFFF" CornerRadius="28">
                                    <Grid>
                                        <Path Data="M 0 30 C 70 55 150 45 230 30 L 230 82 L 0 82 Z"
                                              Fill="#BFE8F0FF"
                                              Opacity="0.48"
                                              Height="62"
                                              VerticalAlignment="Bottom"
                                              Stretch="Fill"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                            <Border Width="62" Height="62" CornerRadius="21" Background="#DCEBFF" BorderBrush="{StaticResource GlassShellBorderBrush}" BorderThickness="1" Margin="0,0,26,0">
                                                <iconPacks:PackIconMaterial Kind="AccountGroup" Style="{StaticResource ShellStatIconStyle}"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="ActiveCrewsCount"
                                                           Text="0"
                                                           FontSize="30"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AppTextBrush}"/>
                                                <TextBlock Text="Активных бригад"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource AppMutedTextBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </WrapPanel>

                            <Border Style="{StaticResource ModernCardStyle}" Margin="0,0,0,0" Padding="0" Background="#64FFFFFF" BorderBrush="#A8FFFFFF" CornerRadius="30">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" Margin="24,22,24,18">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <Border Width="38" Height="38" CornerRadius="14" Background="{DynamicResource AppAccentSoftBrush}" Margin="0,0,14,0">
                                                <iconPacks:PackIconMaterial Kind="FileDocumentOutline"
                                                                            Width="20"
                                                                            Height="20"
                                                                            Foreground="{DynamicResource AppAccentBrush}"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Последние отчёты"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppTextBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button HorizontalAlignment="Right"
                                                MinHeight="38"
                                                Padding="18,0"
                                                Background="#70FFFFFF"
                                                BorderBrush="{StaticResource GlassShellBorderBrush}"
                                                Style="{StaticResource AppOutlinedButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Все отчёты"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource AppTextBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"/>
                                                <iconPacks:PackIconMaterial Kind="ChevronRight"
                                                                            Width="14"
                                                                            Height="14"
                                                                            Foreground="{DynamicResource AppMutedTextBrush}"
                                                                            VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <Grid Margin="24,0,24,24" MinHeight="228">
                                        <DataGrid x:Name="RecentReportsGrid"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  IsReadOnly="True"
                                                  HeadersVisibility="Column"
                                                  MinHeight="228">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Задача" Binding="{Binding TaskTitle}" Width="*"/>
                                                <DataGridTextColumn Header="Автор" Binding="{Binding ReporterName}" Width="220"/>
                                                <DataGridTextColumn Header="Дата" Binding="{Binding ReportedAt, StringFormat=dd.MM.yyyy HH:mm}" Width="210"/>
                                                <DataGridTextColumn Header="Комментарий" Binding="{Binding ReportText}" Width="*"/>
                                                <DataGridTemplateColumn Header="Вложение" Width="170" MinWidth="170">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="Открыть"
                                                                    Click="BtnOpenTaskReportAttachment_Click"
                                                                    HorizontalAlignment="Center">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource AppAttachmentButtonStyle}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasAttachment}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <StackPanel x:Name="RecentReportsEmptyState"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Visibility="Collapsed">
                                            <Border Width="86" Height="64" CornerRadius="22" Background="#68FFFFFF" BorderBrush="{StaticResource GlassShellBorderBrush}" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,18">
                                                <iconPacks:PackIconMaterial Kind="FileDocumentOutline"
                                                                            Width="34"
                                                                            Height="34"
                                                                            Foreground="{DynamicResource AppAccentBrush}"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Нет отчётов"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppTextBrush}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,0,0,8"/>
                                            <TextBlock Text="Здесь будут отображаться последние отчёты"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="SitesContent" Visibility="Collapsed" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="350"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource ModernCardStyle}" Grid.Column="0">
                        <StackPanel>
                            <TextBlock Text="Стройплощадки" Style="{StaticResource SubHeaderTextStyle}"/>
                            <DataGrid x:Name="dgSites" AutoGenerateColumns="False" IsReadOnly="True"
                                    SelectionChanged="DgSites_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Название" Binding="{Binding SiteName}" Width="*"/>
                                    <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ModernCardStyle}" Grid.Column="1">
                        <StackPanel>
                            <TextBlock Text="Управление стройплощадкой" Style="{StaticResource SubHeaderTextStyle}"/>

                            <TextBox x:Name="txtSiteName"
                                   Margin="0,0,0,16"/>

                            <TextBox x:Name="txtSiteAddress"
                                   Margin="0,0,0,24"/>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button x:Name="btnAddSite" Content="ДОБАВИТЬ"
                                          Click="BtnAddSite_Click"
                                          Style="{StaticResource AppRaisedButton}"
                                          Width="110"
                                          Margin="0,0,8,0"/>
                                    <Button x:Name="btnUpdateSite" Content="ОБНОВИТЬ"
                                          Click="BtnUpdateSite_Click"
                                          Style="{StaticResource AppOutlinedButton}"
                                          Width="110"/>
                                </StackPanel>
                                <Button x:Name="btnDeleteSite" Content="УДАЛИТЬ"
                                      Click="BtnDeleteSite_Click"
                                      Width="110"
                                      HorizontalAlignment="Left"
                                      Style="{StaticResource GlassDangerButtonStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="CrewsContent" Visibility="Collapsed" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="350"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource ModernCardStyle}" Grid.Column="0">
                        <StackPanel>
                            <TextBlock Text="Бригады" Style="{StaticResource SubHeaderTextStyle}"/>
                            <DataGrid x:Name="dgCrews" AutoGenerateColumns="False" IsReadOnly="True"
                                    SelectionChanged="DgCrews_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Название бригады" Binding="{Binding CrewName}" Width="*"/>
                                    <DataGridTextColumn Header="Бригадир" Binding="{Binding Brigadier.Username}" Width="200"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ModernCardStyle}" Grid.Column="1">
                        <StackPanel>
                            <TextBlock Text="Управление бригадой" Style="{StaticResource SubHeaderTextStyle}"/>

                            <TextBox x:Name="txtCrewName"
                                   Margin="0,0,0,16"/>

                            <ComboBox x:Name="cbBrigadiers"
                                     Margin="0,0,0,24">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Username}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button x:Name="btnAddCrew" Content="ДОБАВИТЬ"
                                          Click="BtnAddCrew_Click"
                                          Style="{StaticResource AppRaisedButton}"
                                          Width="110"
                                          Margin="0,0,8,0"/>
                                    <Button x:Name="btnUpdateCrew" Content="ОБНОВИТЬ"
                                          Click="BtnUpdateCrew_Click"
                                          Style="{StaticResource AppOutlinedButton}"
                                          Width="110"/>
                                </StackPanel>
                                <Button x:Name="btnDeleteCrew" Content="УДАЛИТЬ"
                                      Click="BtnDeleteCrew_Click"
                                      Width="110"
                                      HorizontalAlignment="Left"
                                      Margin="0,0,0,8"
                                      Style="{StaticResource GlassDangerButtonStyle}"/>
                                <Button x:Name="btnCrewMembers" Content="СОСТАВ БРИГАДЫ"
                                      Click="BtnCrewMembers_Click"
                                      Width="170"
                                      HorizontalAlignment="Left"
                                      Style="{StaticResource AppOutlinedButton}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="TasksContent" Visibility="Collapsed" Grid.ColumnSpan="2">
                    <Grid x:Name="StandardTasksPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                    <Border Style="{StaticResource ModernCardStyle}" Grid.Row="0">
                        <WrapPanel>
                            <StackPanel Margin="0,0,12,12">
                                <TextBlock Text="Поиск по названию"
                                           FontSize="11"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="txtTaskSearch"
                                         Width="220"
                                         TextChanged="TaskSearch_TextChanged"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,12">
                                <TextBlock Text="Объект"
                                           FontSize="11"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                           Margin="0,0,0,5"/>
                                <ComboBox x:Name="cbSiteFilter"
                                          Width="180"
                                          SelectionChanged="TaskFilter_Changed">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SiteName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,12">
                                <TextBlock Text="Бригада"
                                           FontSize="11"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                           Margin="0,0,0,5"/>
                                <ComboBox x:Name="cbCrewFilter"
                                          Width="180"
                                          SelectionChanged="TaskFilter_Changed">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CrewName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,12">
                                <TextBlock Text="Статус"
                                           FontSize="11"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                           Margin="0,0,0,5"/>
                                <ComboBox x:Name="cbStatusFilter"
                                          Width="160"
                                          SelectionChanged="TaskFilter_Changed">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TaskStatusName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,12">
                                <TextBlock Text="Приоритет"
                                           FontSize="11"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                           Margin="0,0,0,5"/>
                                <ComboBox x:Name="cbPriorityFilter"
                                          Width="160"
                                          SelectionChanged="TaskFilter_Changed">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PriorityName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,12">
                                <TextBlock Text="Показать"
                                           FontSize="11"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                           Margin="0,0,0,5"/>
                                <ComboBox x:Name="cbTaskScopeFilter"
                                          Width="200"
                                          SelectionChanged="TaskFilter_Changed">
                                    <ComboBoxItem Content="Все задачи" Tag="all" />
                                    <ComboBoxItem Content="Только активные" Tag="active" />
                                    <ComboBoxItem Content="Только завершенные" Tag="completed" />
                                    <ComboBoxItem Content="Только просроченные" Tag="overdue" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,12">
                                <TextBlock Text=" " FontSize="11" Margin="0,0,0,5"/>
                                <Button x:Name="btnResetTaskFilter" Content="СБРОСИТЬ ФИЛЬТРЫ"
                                        Click="BtnResetTaskFilter_Click"
                                        Style="{StaticResource AppOutlinedButton}"/>
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <Border Style="{StaticResource ModernCardStyle}" Grid.Row="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Задачи" Style="{StaticResource SubHeaderTextStyle}"/>
                            <DataGrid x:Name="dgTasks" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                    SelectionChanged="DgTasks_SelectionChanged" SelectionMode="Extended"
                                    MouseDoubleClick="DgTasks_MouseDoubleClick"
                                    ContextMenuOpening="DgTasks_ContextMenuOpening"
                                    ScrollViewer.VerticalScrollBarVisibility="Visible"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    Margin="0,0,0,8">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="DgTasksRow_PreviewMouseRightButtonDown"/>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.ContextMenu>
                                    <ContextMenu Background="{DynamicResource AppSurfaceBrush}"
                                                 BorderBrush="{DynamicResource AppBorderBrush}"
                                                 BorderThickness="1"
                                                 Padding="6"
                                                 HasDropShadow="True">
                                        <ContextMenu.Template>
                                            <ControlTemplate TargetType="{x:Type ContextMenu}">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="8"
                                                        Padding="{TemplateBinding Padding}">
                                                    <StackPanel IsItemsHost="True"
                                                                KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ContextMenu.Template>
                                        <ContextMenu.Resources>
                                            <Style x:Key="CompactTaskMenuItemStyle" TargetType="{x:Type MenuItem}">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                                                <Setter Property="FontSize" Value="13"/>
                                                <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
                                                <Setter Property="Padding" Value="12,7"/>
                                                <Setter Property="Margin" Value="0"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type MenuItem}">
                                                            <Border x:Name="MenuItemBorder"
                                                                    Background="{TemplateBinding Background}"
                                                                    CornerRadius="5"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <ContentPresenter Grid.Column="0"
                                                                                      ContentSource="Icon"
                                                                                      VerticalAlignment="Center"
                                                                                      Margin="0,0,10,0"/>
                                                                    <ContentPresenter Grid.Column="1"
                                                                                      ContentSource="Header"
                                                                                      RecognizesAccessKey="True"
                                                                                      VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsHighlighted" Value="True">
                                                                    <Setter TargetName="MenuItemBorder" Property="Background" Value="{DynamicResource AppSelectionBrush}"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource AppSelectionTextBrush}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter Property="Opacity" Value="0.55"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ContextMenu.Resources>
                                        <MenuItem Style="{StaticResource CompactTaskMenuItemStyle}"
                                                  Click="TaskQrMenuItem_Click">
                                            <MenuItem.Icon>
                                                <Image Source="/Assets/Icons/apple-qr.png"
                                                       Style="{StaticResource GlassIconImageStyle}"
                                                       Width="15"
                                                       Height="15"/>
                                            </MenuItem.Icon>
                                            <MenuItem.Header>
                                                <TextBlock Text="&#x41E;&#x442;&#x43A;&#x440;&#x44B;&#x442;&#x44C; QR-&#x43A;&#x43E;&#x434;"/>
                                            </MenuItem.Header>
                                        </MenuItem>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/>
                                    <DataGridTextColumn Header="Объект" Binding="{Binding Site.SiteName}" Width="150"/>
                                    <DataGridTextColumn Header="Бригада" Binding="{Binding Crew.CrewName}" Width="150"/>
                                    <DataGridTextColumn Header="Приоритет" Binding="{Binding Priority.PriorityName}" Width="100"/>
                                    <DataGridTextColumn Header="Статус" Binding="{Binding TaskStatus.TaskStatusName}" Width="120"/>
                                    <DataGridTextColumn Header="Начало" Binding="{Binding StartDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                                    <DataGridTextColumn Header="Окончание" Binding="{Binding EndDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                                    <DataGridTemplateColumn Header="Действия" Width="200">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding LastNoteText}"
                                                          TextWrapping="Wrap"
                                                          FontSize="11"
                                                          Foreground="{DynamicResource AppMutedTextBrush}"
                                                          Padding="4,2"
                                                          ToolTip="{Binding LastNoteTooltip}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Grid.Row="2" x:Name="txtTaskFilterNoResults"
                                       Text="Подходящих задач не найдено"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                       HorizontalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource ModernCardStyle}" Grid.Row="2">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="btnAddTask" Content="ДОБАВИТЬ ЗАДАЧУ"
                                      Click="BtnAddTask_Click"
                                      Style="{StaticResource AppRaisedButton}"
                                      Width="180"
                                      Margin="0,0,16,0"/>
                                <Button x:Name="btnUpdateTask" Content="РЕДАКТИРОВАТЬ"
                                      Click="BtnUpdateTask_Click"
                                      Style="{StaticResource AppOutlinedButton}"
                                      Width="180"
                                      Margin="0,0,16,0"/>
                                <Button x:Name="btnDuplicateTask" Content="ДУБЛИРОВАТЬ"
                                      Click="BtnDuplicateTask_Click"
                                      Style="{StaticResource AppOutlinedButton}"
                                      Width="160"
                                      Margin="0,0,16,0"/>
                                <Button x:Name="btnDeleteTask" Content="УДАЛИТЬ"
                                      Click="BtnDeleteTask_Click"
                                      Style="{StaticResource GlassDangerButtonStyle}"
                                      Width="110"
                                      Margin="0,0,16,0"/>
                                <Button x:Name="btnUpdateStatus" Content="ИЗМЕНИТЬ СТАТУС"
                                      Click="BtnUpdateStatus_Click"
                                      Width="180"
                                      Margin="0,0,16,0"
                                      Style="{StaticResource AppRaisedButton}"/>
                                <Button x:Name="btnPrintTask" Content="ПЕЧАТЬ"
                                      Click="BtnPrintTask_Click"
                                      Width="120"
                                      Style="{StaticResource AppOutlinedButton}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    </Grid>

                    <Grid x:Name="BrigadierTasksPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource ModernCardStyle}" Grid.Row="0">
                            <StackPanel>
                                <TextBlock Text="Чек-лист бригадира" Style="{StaticResource SubHeaderTextStyle}"/>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Click="BtnBrigadierChecklistPrevDay_Click"
                                            Style="{StaticResource AppOutlinedButton}"
                                            Margin="0,0,12,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M 12 4 L 6 10 L 12 16"
                                                  Width="16"
                                                  Height="16"
                                                  Stretch="Uniform"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Margin="0,0,8,0"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock Text="День" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <DatePicker x:Name="dpBrigadierChecklistDate"
                                                SelectedDateChanged="DpBrigadierChecklistDate_SelectedDateChanged"
                                                Width="160"
                                                Margin="0,0,12,8"/>
                                    <Button Content="Сегодня"
                                            Click="BtnBrigadierChecklistToday_Click"
                                            Style="{StaticResource AppOutlinedButton}"
                                            Margin="0,0,12,8"/>
                                    <Button Click="BtnBrigadierChecklistNextDay_Click"
                                            Style="{StaticResource AppOutlinedButton}"
                                            Margin="0,0,12,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="День" VerticalAlignment="Center"/>
                                            <Path Data="M 6 4 L 12 10 L 6 16"
                                                  Width="16"
                                                  Height="16"
                                                  Stretch="Uniform"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Margin="8,0,0,0"
                                                  VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                                <TextBlock x:Name="txtBrigadierWeekRange"
                                           Margin="0,0,0,4"
                                           Foreground="{DynamicResource AppMutedTextBrush}"/>
                                <TextBlock x:Name="txtBrigadierTaskSummary"
                                           Margin="0,4,0,0"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextBrush}"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock x:Name="txtBrigadierChecklistEmpty"
                                           Text="На выбранную дату задач нет."
                                           Margin="0,0,0,16"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                           Visibility="Collapsed"/>
                                <ItemsControl x:Name="icBrigadierTasks">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ModernCardStyle}" Margin="0,0,0,16">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <StackPanel Grid.Row="0">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="18"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AppTextBrush}"/>
                                                        <TextBlock Text="{Binding DescriptionPreview}"
                                                                   Margin="0,6,0,0"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource AppMutedTextBrush}"/>
                                                    </StackPanel>

                                                    <WrapPanel Grid.Row="1" Margin="0,16,0,0">
                                                        <Border Background="{DynamicResource AppPanelBrush}" CornerRadius="10" Padding="10,6" Margin="0,0,8,8">
                                                            <TextBlock Text="{Binding SiteName}" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <Border Background="{DynamicResource AppPanelBrush}" CornerRadius="10" Padding="10,6" Margin="0,0,8,8">
                                                            <TextBlock Text="{Binding CrewName}" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <Border Background="{DynamicResource AppPanelBrush}" CornerRadius="10" Padding="10,6" Margin="0,0,8,8">
                                                            <TextBlock Text="{Binding PriorityName}" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <Border Background="{DynamicResource AppPanelBrush}" CornerRadius="10" Padding="10,6" Margin="0,0,8,8">
                                                            <TextBlock Text="{Binding DateRangeText}" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <Border CornerRadius="10" Padding="10,6" Margin="0,0,8,8">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource AppPanelBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                            <Setter Property="Background" Value="#F9D3D3"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding ChecklistStatusText}" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <!-- Значок из плана диспетчера -->
                                                        <Border Background="#E3F2FD" CornerRadius="10" Padding="10,6"
                                                                Margin="0,0,8,8"
                                                                Visibility="{Binding PlanOrderBadgeVisibility}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Path Data="M 4 9 L 8 13 L 15 5"
                                                                      Width="14" Height="14"
                                                                      Stretch="Uniform"
                                                                      Stroke="#1565C0"
                                                                      StrokeThickness="2"
                                                                      StrokeStartLineCap="Round"
                                                                      StrokeEndLineCap="Round"
                                                                      StrokeLineJoin="Round"
                                                                      VerticalAlignment="Center"
                                                                      Margin="0,0,4,0"/>
                                                                <TextBlock Text="{Binding PlanOrderText}"
                                                                           Foreground="#1565C0"
                                                                           FontWeight="SemiBold"
                                                                           FontSize="12"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </WrapPanel>

                                                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                                        <!-- Заметка диспетчера из плана -->
                                                        <Border Background="{DynamicResource AppGlassSoftBrush}" CornerRadius="14"
                                                                Padding="10,6" Margin="0,0,0,10"
                                                                Visibility="{Binding PlanNoteVisibility}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Path Data="M 5 3 L 13 3 L 13 11 L 9 15 L 5 11 Z"
                                                                      Width="14" Height="14"
                                                                      Stretch="Uniform"
                                                                      Stroke="#3949AB"
                                                                      StrokeThickness="1.8"
                                                                      StrokeStartLineCap="Round"
                                                                      StrokeEndLineCap="Round"
                                                                      StrokeLineJoin="Round"
                                                                      Fill="Transparent"
                                                                      VerticalAlignment="Center"
                                                                      Margin="0,0,6,0"/>
                                                                <TextBlock Text="{Binding PlanNote}"
                                                                           Foreground="#3949AB"
                                                                           FontSize="12"
                                                                           TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <CheckBox Content="Задача выполнена"
                                                                  IsChecked="{Binding IsMarkedCompleted, Mode=TwoWay}"
                                                                  FontWeight="SemiBold"
                                                                  FontSize="15"
                                                                  Margin="0,0,0,4"/>
                                                        <TextBlock Text="Комментарий обязателен, если задача не выполнена."
                                                                   Margin="0,6,0,8"
                                                                   Foreground="{DynamicResource AppMutedTextBrush}"/>
                                                        <TextBlock Text="Последняя заметка"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AppTextBrush}"/>
                                                        <TextBlock Text="{Binding LastNoteText}"
                                                                   Margin="0,4,0,12"
                                                                   TextWrapping="Wrap"
                                                                   ToolTip="{Binding LastNoteTooltip}"
                                                                   Foreground="{DynamicResource AppMutedTextBrush}"/>
                                                        <TextBox Text="{Binding CompletionComment, UpdateSourceTrigger=PropertyChanged}"
                                                                 AcceptsReturn="True"
                                                                 TextWrapping="Wrap"
                                                                 MinHeight="80"
                                                                 VerticalScrollBarVisibility="Auto"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="3"
                                                                Margin="0,16,0,0"
                                                                Orientation="Horizontal"
                                                                HorizontalAlignment="Right">
                                                        <Button Content="Открыть задачу"
                                                                Tag="{Binding TaskId}"
                                                                Click="BtnBrigadierOpenTask_Click"
                                                                Style="{StaticResource AppOutlinedButton}"
                                                                Margin="0,0,12,0"/>
                                                        <Button Content="Сохранить отметку"
                                                                Tag="{Binding}"
                                                                Click="BtnSaveBrigadierChecklistDecision_Click"
                                                                Style="{StaticResource AppRaisedButton}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <Grid x:Name="CalendarContent" Visibility="Collapsed" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource ModernCardStyle}" Grid.Column="0">
                        <StackPanel>
                            <TextBlock Text="Календарь задач" Style="{StaticResource SubHeaderTextStyle}"/>

                            <Calendar x:Name="TaskCalendar"
                                    Loaded="TaskCalendar_Loaded"
                                    DisplayDateChanged="TaskCalendar_DisplayDateChanged"
                                    SelectedDatesChanged="TaskCalendar_SelectedDatesChanged"
                                    Margin="0,16,0,16"/>

                            <TextBlock Text="Объект"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                       Margin="0,0,0,4"/>
                            <ComboBox x:Name="cbCalendarSiteFilter"
                                     Margin="0,0,0,12"
                                     SelectionChanged="CalendarFilter_Changed">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SiteName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Text="Бригада"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                       Margin="0,0,0,4"/>
                            <ComboBox x:Name="cbCalendarCrewFilter"
                                     Margin="0,0,0,16"
                                     SelectionChanged="CalendarFilter_Changed">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CrewName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Button Content="СБРОСИТЬ ФИЛЬТРЫ"
                                  Click="BtnResetCalendarFilters_Click"
                                  Style="{StaticResource AppOutlinedButton}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ModernCardStyle}" Grid.Column="1">
                        <StackPanel>
                            <TextBlock x:Name="SelectedDateText" Text="Выберите дату"
                                     Style="{StaticResource SubHeaderTextStyle}"/>

                            <DataGrid x:Name="dgCalendarTasks" AutoGenerateColumns="False"
                                    CanUserAddRows="False" Margin="0,16,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/>
                                    <DataGridTextColumn Header="Объект" Binding="{Binding Site.SiteName}" Width="150"/>
                                    <DataGridTextColumn Header="Бригада" Binding="{Binding Crew.CrewName}" Width="150"/>
                                    <DataGridTextColumn Header="Статус" Binding="{Binding TaskStatus.TaskStatusName}" Width="120"/>
                                    <DataGridTextColumn Header="Приоритет" Binding="{Binding Priority.PriorityName}" Width="100"/>
                                    <DataGridTextColumn Header="Начало" Binding="{Binding StartDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                                    <DataGridTextColumn Header="Окончание" Binding="{Binding EndDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="ReportsContent" Visibility="Collapsed" Grid.ColumnSpan="2">
                    <Border Margin="24"
                            Padding="18"
                            CornerRadius="26"
                            Background="{DynamicResource AppSurfaceBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Padding="12,10"
                                    CornerRadius="16"
                                    Background="{StaticResource GlassShellChromeBrush}"
                                    BorderBrush="{StaticResource GlassShellBorderBrush}"
                                    BorderThickness="1">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Image Source="/Assets/Icons/apple-reports.png"
                                           Style="{StaticResource GlassIconImageStyle}"
                                           Width="18"
                                           Height="18"
                                           Margin="0,0,10,0"/>
                                    <TextBlock Text="Аналитика по задачам"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppTextBrush}"/>
                                </StackPanel>
                            </Border>

                            <Grid x:Name="ReportsWorkspaceGrid" Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ReportsSidebarColumn" Width="250"/>
                                    <ColumnDefinition x:Name="ReportsGapColumn" Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="0"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                            <Border x:Name="ReportControlsPanel"
                                    Grid.Column="0"
                                    Padding="24"
                                    CornerRadius="18"
                                    Background="{DynamicResource AppSurfaceAltBrush}"
                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Выбор отчёта"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppTextBrush}"/>
                                        <TextBlock Text="Тип отчёта:"
                                                   Margin="0,16,0,6"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource AppMutedTextBrush}"/>
                                        <ComboBox x:Name="cbReportTypeSelector"
                                                  Height="36"
                                                  SelectedIndex="0"
                                                  Background="{DynamicResource AppInputBackgroundBrush}"
                                                  BorderBrush="{DynamicResource AppBorderBrush}"
                                                  BorderThickness="1"
                                                  Foreground="{DynamicResource AppTextBrush}"
                                                  Padding="8,4">
                                            <ComboBoxItem Content="Общий список задач" Tag="tasks"/>
                                            <ComboBoxItem Content="Задачи по объектам" Tag="tasks_by_site"/>
                                            <ComboBoxItem Content="Выполнение по бригадам" Tag="tasks_by_crew"/>
                                            <ComboBoxItem Content="Просроченные задачи" Tag="overdue_tasks"/>
                                            <ComboBoxItem Content="Задачи по приоритетам" Tag="tasks_by_priority"/>
                                            <ComboBoxItem Content="Заявки на материалы" Tag="material_requests"/>
                                        </ComboBox>

                                        <TextBlock Text="Период"
                                                   Margin="0,14,0,6"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppMutedTextBrush}"/>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <DatePicker x:Name="dpReportFromDate"
                                                        Grid.Column="0"
                                                        SelectedDateChanged="ReportDateFilter_Changed"/>
                                            <DatePicker x:Name="dpReportToDate"
                                                        Grid.Column="2"
                                                        SelectedDateChanged="ReportDateFilter_Changed"/>
                                        </Grid>

                                        <TextBlock Text="Тип диаграммы:"
                                                   Margin="0,14,0,6"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource AppMutedTextBrush}"/>
                                        <ComboBox x:Name="cbReportChartType"
                                                  Height="36"
                                                  SelectedIndex="0"
                                                  Background="{DynamicResource AppInputBackgroundBrush}"
                                                  BorderBrush="{DynamicResource AppBorderBrush}"
                                                  BorderThickness="1"
                                                  Foreground="{DynamicResource AppTextBrush}"
                                                  Padding="8,4">
                                            <ComboBoxItem Content="Гистограмма" Tag="bar"/>
                                            <ComboBoxItem Content="Круговая диаграмма" Tag="pie"/>
                                            <ComboBoxItem Content="Линейный график" Tag="line"/>
                                        </ComboBox>

                                        <Button x:Name="btnGenerateSelectedReport"
                                                Content="Сгенерировать отчёт"
                                                Click="BtnGenerateSelectedReport_Click"
                                                Height="38"
                                                Margin="0,16,0,0"
                                                Style="{StaticResource ModernButtonStyle}"/>
                                    </StackPanel>

                                    <Border Grid.Row="1"
                                            Margin="0,24,0,0"
                                            Padding="16"
                                            CornerRadius="16"
                                            Background="{DynamicResource AppPanelBrush}"
                                            BorderBrush="{DynamicResource AppBorderBrush}"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="Экспорт"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppTextBrush}"/>
                                            <TextBlock Text="Экспортировать как:"
                                                       Margin="0,12,0,6"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource AppMutedTextBrush}"/>
                                            <ComboBox x:Name="cbReportExportFormat"
                                                      Height="36"
                                                      SelectedIndex="0"
                                                      Background="{DynamicResource AppInputBackgroundBrush}"
                                                      BorderBrush="{DynamicResource AppBorderBrush}"
                                                      BorderThickness="1"
                                                      Foreground="{DynamicResource AppTextBrush}"
                                                      Padding="8,4">
                                                <ComboBoxItem Content="PNG" Tag="png"/>
                                                <ComboBoxItem Content="CSV" Tag="csv"/>
                                                <ComboBoxItem Content="Excel" Tag="excel"/>
                                                <ComboBoxItem Content="PDF" Tag="pdf"/>
                                            </ComboBox>

                                            <Button x:Name="btnExportSelectedReport"
                                                    Content="Экспортировать"
                                                    Click="BtnExportSelectedReport_Click"
                                                    Height="38"
                                                    Margin="0,16,0,0"
                                                    Style="{StaticResource ModernOutlinedButtonStyle}"/>

                                            <TextBlock Text="Справа показывается текущий график по выбранному срезу. Экспорт сохраняет именно эту выборку."
                                                       Margin="0,18,0,0"
                                                       TextWrapping="Wrap"
                                                       FontSize="11"
                                                        Foreground="{DynamicResource AppSubtleTextBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border x:Name="ReportChartPanel"
                                    Grid.Column="2"
                                    Padding="20"
                                    CornerRadius="18"
                                    Background="{DynamicResource AppSurfaceAltBrush}"
                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                    BorderThickness="1">
                                <ScrollViewer x:Name="ReportChartScrollViewer"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              PanningMode="VerticalOnly">
                                <Grid MinHeight="560">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*" MinHeight="380"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="0"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock x:Name="ReportTitle"
                                                       Text="Общий список задач"
                                                       HorizontalAlignment="Center"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppTextBrush}"/>
                                            <TextBlock x:Name="ReportSubtitle"
                                                       Margin="0,6,0,0"
                                                       HorizontalAlignment="Center"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                                       Text="Сводка по задачам и текущему состоянию исполнения."/>
                                            <TextBlock x:Name="ReportTableCaption"
                                                       Margin="0,4,0,0"
                                                       HorizontalAlignment="Center"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource AppSubtleTextBrush}"
                                                       Text="Выберите параметры слева и сформируйте отчёт."/>
                                        </StackPanel>

                                        <Button x:Name="btnOpenReportFullscreen"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Height="36"
                                                Padding="14,0"
                                                Click="BtnOpenReportFullscreen_Click"
                                                Style="{StaticResource AppOutlinedButton}"
                                                ToolTip="Открыть график на весь экран">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE740;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           Width="16"
                                                           Height="16"
                                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"/>
                                                <TextBlock Text="На весь экран"
                                                           Foreground="{DynamicResource AppTextBrush}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <Border x:Name="ReportPreviewHost"
                                            Grid.Row="1"
                                            Margin="0,10,0,0"
                                            Padding="10"
                                            MinHeight="220"
                                            CornerRadius="18"
                                            Background="{DynamicResource AppSurfaceBrush}"
                                            BorderBrush="{DynamicResource AppBorderBrush}"
                                            BorderThickness="1"
                                            SizeChanged="ReportPreviewHost_SizeChanged">
                                        <ScrollViewer x:Name="ReportPreviewScrollViewer"
                                                      HorizontalScrollBarVisibility="Auto"
                                                      VerticalScrollBarVisibility="Auto"
                                                      PanningMode="Both">
                                            <Canvas x:Name="ReportPreviewCanvas"/>
                                        </ScrollViewer>
                                    </Border>

                                    <UniformGrid Grid.Row="2" Columns="3" Margin="0,8,0,0">
                                        <Border Margin="0,0,10,0"
                                                Padding="12"
                                                CornerRadius="14"
                                                Background="{DynamicResource AppPanelBrush}"
                                                BorderBrush="{DynamicResource AppBorderBrush}"
                                                BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock x:Name="ReportMetricPrimaryValue" Text="0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}"/>
                                                <TextBlock x:Name="ReportMetricPrimaryLabel" Text="Всего записей" Margin="0,4,0,0" Foreground="{DynamicResource AppMutedTextBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="0,0,10,0"
                                                Padding="12"
                                                CornerRadius="14"
                                                Background="{DynamicResource AppPanelBrush}"
                                                BorderBrush="{DynamicResource AppBorderBrush}"
                                                BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock x:Name="ReportMetricSecondaryValue" Text="0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/>
                                                <TextBlock x:Name="ReportMetricSecondaryLabel" Text="Ключевой показатель" Margin="0,4,0,0" Foreground="{DynamicResource AppMutedTextBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Padding="12"
                                                CornerRadius="14"
                                                Background="{DynamicResource AppPanelBrush}"
                                                BorderBrush="{DynamicResource AppBorderBrush}"
                                                BorderThickness="1">
                                            <StackPanel>
