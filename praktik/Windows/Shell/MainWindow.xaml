                                       Click="BtnMRAddRequest_Click" Style="{StaticResource AppRaisedButton}"
                                       Width="180" Height="40"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" Margin="16,0,16,8">
