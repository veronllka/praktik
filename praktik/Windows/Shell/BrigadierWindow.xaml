<Window x:Class="praktik.BrigadierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:praktik"
        mc:Ignorable="d"
        Title="Планировщик работ бригад - Бригадир"
        Height="800"
        Width="1400"
        MinHeight="520"
        MinWidth="720"
        WindowState="Maximized"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        Background="Transparent"
        Style="{StaticResource GlassWindowStyle}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar"
              Grid.Row="0"
              Height="42"
              VerticalAlignment="Top"
              Background="Transparent"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
              Panel.ZIndex="50">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="18,0,0,0">
                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets"
                           Width="18"
                           Height="18"
                           Foreground="{DynamicResource AppTextBrush}"
                           Opacity="0.9"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <TextBlock Text="Планировщик работ"
                           FontSize="14"
                           FontWeight="Medium"
                           Foreground="{DynamicResource AppTextBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0">
                <Button Click="BtnMinimize_Click"
                        Style="{StaticResource GlassTitleBarButtonStyle}"
                        ToolTip="Свернуть">
                    <TextBlock Text="&#xE738;" FontFamily="Segoe MDL2 Assets"
                               Width="14"
                               Height="14"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <Button Click="BtnMaximize_Click"
                        Style="{StaticResource GlassTitleBarButtonStyle}"
                        ToolTip="Развернуть">
                    <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets"
                               Width="13"
                               Height="13"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <Button Click="BtnClose_Click"
                        Style="{StaticResource GlassCloseTitleBarButtonStyle}"
                        ToolTip="Закрыть">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                               Width="15"
                               Height="15"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
            </StackPanel>
        </Grid>

        <local:MainWindow x:Name="MainView" Grid.Row="1"/>
    </Grid>
</Window>
