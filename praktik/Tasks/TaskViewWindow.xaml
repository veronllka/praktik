<Window x:Class="praktik.TaskViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Информация о задаче" Height="700" Width="600" WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="30,20">
            <StackPanel>
                <TextBlock Text="НАРЯД-ЗАДАЧА" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="#1976D2"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>
                <TextBlock x:Name="txtTitle" 
                           FontSize="18" 
                           FontWeight="SemiBold" 
                           TextWrapping="Wrap"
                           Foreground="#212121"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="White">
            <StackPanel Margin="30,25">
                <TextBlock x:Name="txtTaskId" 
                           FontSize="12" 
                           Foreground="#757575" 
                           Margin="0,0,0,20"
                           HorizontalAlignment="Right"/>

                <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,0,0,15" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="ОБЪЕКТ" 
                                   FontWeight="Bold" 
                                   FontSize="13" 
                                   Margin="0,0,0,8" 
                                   Foreground="#424242"/>
                        <TextBlock x:Name="txtSite" 
                                   FontSize="15" 
                                   TextWrapping="Wrap" 
                                   Foreground="#212121"
                                   LineHeight="22"/>
                    </StackPanel>
                </Border>

                <Border x:Name="pnlPrintJournal"
                        BorderBrush="#E0E0E0"
                        BorderThickness="0,0,0,1"
                        Padding="0,15,0,15"
                        Margin="0,0,0,20"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="ЖУРНАЛ ПЕЧАТИ"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Margin="0,0,0,12"
                                   Foreground="#424242"/>
                        <TextBlock Text="Последняя печать"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Margin="0,0,0,6"
                                   Foreground="#616161"/>
                        <TextBlock x:Name="txtLastPrintedAt"
                                   FontSize="14"
                                   Foreground="#212121"
                                   Margin="0,0,0,14"/>
                        <TextBlock Text="История печати"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Margin="0,0,0,8"
                                   Foreground="#616161"/>
                        <TextBlock x:Name="txtPrintHistoryEmpty"
                                   Text="Печать по задаче еще не выполнялась"
                                   FontSize="13"
                                   Foreground="#757575"
                                   Margin="0,0,0,8"/>
                        <ItemsControl x:Name="icPrintHistory">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E0E0E0"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,0,0,10"
                                            Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock FontSize="14" Foreground="#212121">
                                                <Run Text="{Binding PrintedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/>
                                                <Run Text=" • "/>
                                                <Run Text="{Binding DisplayPrintedByName}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding DisplayTemplateName}"
                                                       FontSize="12"
                                                       Foreground="#757575"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,0,0,15" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="БРИГАДА" 
                                   FontWeight="Bold" 
                                   FontSize="13" 
                                   Margin="0,0,0,8" 
                                   Foreground="#424242"/>
                        <TextBlock x:Name="txtCrew" 
                                   FontSize="15" 
                                   TextWrapping="Wrap" 
                                   Foreground="#212121"
                                   Margin="0,0,0,8"/>
                        <TextBlock x:Name="txtBrigadier" 
                                   FontSize="14" 
                                   TextWrapping="Wrap" 
                                   Foreground="#616161"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,0,0,15" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="ПЕРИОД ВЫПОЛНЕНИЯ" 
                                   FontWeight="Bold" 
                                   FontSize="13" 
                                   Margin="0,0,0,8" 
                                   Foreground="#424242"/>
                        <TextBlock x:Name="txtPeriod" 
                                   FontSize="15" 
                                   Foreground="#212121"/>
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="ПРИОРИТЕТ" 
                                       FontWeight="Bold" 
                                       FontSize="13" 
                                       Margin="0,0,0,8" 
                                       Foreground="#424242"/>
                            <TextBlock x:Name="txtPriority" 
                                       FontSize="15" 
                                       Foreground="#212121"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="СТАТУС" 
                                       FontWeight="Bold" 
                                       FontSize="13" 
                                       Margin="0,0,0,8" 
                                       Foreground="#424242"/>
                            <TextBlock x:Name="txtStatus" 
                                       FontSize="15" 
                                       Foreground="#212121"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,0,0,15" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="ДАТА ПОСЛЕДНЕЙ ПЕЧАТИ"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Margin="0,0,0,8"
                                   Foreground="#424242"/>
                        <TextBlock x:Name="txtLastPrintedSummary"
                                   FontSize="15"
                                   Foreground="#212121"/>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="pnlProgress" Visibility="Collapsed" Margin="0,0,0,20">
                    <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="ПОСЛЕДНИЙ ПРОГРЕСС" 
                                       FontWeight="Bold" 
                                       FontSize="13" 
                                       Margin="0,0,0,8" 
                                       Foreground="#424242"/>
                            <TextBlock x:Name="txtProgress" 
                                       FontSize="15" 
                                       Margin="0,0,0,15" 
                                       Foreground="#212121"/>
                            <TextBlock Text="КОММЕНТАРИЙ" 
                                       FontWeight="Bold" 
                                       FontSize="13" 
                                       Margin="0,0,0,8" 
                                       Foreground="#424242"/>
                            <TextBlock x:Name="txtComment" 
                                       FontSize="15" 
                                       TextWrapping="Wrap" 
                                       Foreground="#212121"
                                       LineHeight="22"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="ОПИСАНИЕ" 
                                   FontWeight="Bold" 
                                   FontSize="13" 
                                   Margin="0,0,0,8" 
                                   Foreground="#424242"/>
                        <TextBlock x:Name="txtDescription" 
                                   FontSize="15" 
                                   TextWrapping="Wrap" 
                                   Foreground="#212121"
                                   LineHeight="22"/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,0,0,15" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="ЗАМЕТКИ" 
                                   FontWeight="Bold" 
                                   FontSize="13" 
                                   Margin="0,0,0,12" 
                                   Foreground="#424242"/>
                        
                        <Border x:Name="pnlAddNote" 
                                BorderBrush="#E0E0E0" 
                                BorderThickness="1" 
                                CornerRadius="4"
                                Padding="12"
                                Background="#F9F9F9"
                                Margin="0,0,0,15">
                            <StackPanel>
                                <TextBox x:Name="txtNewNote" 
                                         FontSize="14" 
                                         Padding="8"
                                         MinHeight="60"
                                         MaxHeight="120"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         Background="White"
                                         BorderBrush="#BDBDBD"
                                         BorderThickness="1"
                                         Foreground="#212121"
                                         TextChanged="TxtNewNote_TextChanged"
                                         Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                                    <TextBlock Text="Прогресс, %"
                                               FontSize="13"
                                               Foreground="#424242"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <TextBox x:Name="txtProgressPercent"
                                             Width="90"
                                             Height="32"
                                             FontSize="14"
                                             Padding="8,0"
                                             MaxLength="3"
                                             VerticalContentAlignment="Center"
                                             Background="White"
                                             BorderBrush="#BDBDBD"
                                             BorderThickness="1"
                                             PreviewTextInput="ProgressTextBox_PreviewTextInput"
                                             DataObject.Pasting="ProgressTextBox_Pasting"/>
                                    <TextBlock Text="Необязательно"
                                               FontSize="12"
                                               Foreground="#757575"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0"/>
                                </StackPanel>
                                <Border BorderBrush="#E0E0E0"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10"
                                        Background="White"
                                        Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="txtSelectedAttachment"
                                                   VerticalAlignment="Center"
                                                   Foreground="#616161"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="1"
                                                Content="РџСЂРёРєСЂРµРїРёС‚СЊ С„Р°Р№Р»"
                                                Click="BtnAttachFile_Click"
                                                Margin="12,0,0,0"
                                                Padding="10,4"/>
                                        <Button x:Name="btnRemoveAttachment"
                                                Grid.Column="2"
                                                Content="РЈРґР°Р»РёС‚СЊ"
                                                Click="BtnRemoveAttachment_Click"
                                                Margin="8,0,0,0"
                                                Padding="10,4"
                                                Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Сохранить" 
                                            x:Name="btnSaveNote"
                                            Click="BtnSaveNote_Click"
                                            Width="120" 
                                            Height="35"
                                            FontSize="14"
                                            FontWeight="Medium"
                                            Margin="0,0,10,0"
                                            Background="#4CAF50"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            IsEnabled="False">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" 
                                                                    CornerRadius="4"
                                                                    Padding="12,8">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter Property="Opacity" Value="1"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.5"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#45A049"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Отмена" 
                                            x:Name="btnCancelNote"
                                            Click="BtnCancelNote_Click"
                                            Width="100" 
                                            Height="35"
                                            FontSize="14"
                                            FontWeight="Medium"
                                            Background="#757575"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" 
                                                                    CornerRadius="4"
                                                                    Padding="12,8">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#616161"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <ItemsControl x:Name="icNotes" Margin="0,0,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E0E0E0" 
                                            BorderThickness="0,0,0,1" 
                                            Padding="0,0,0,10"
                                            Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ReportText}" 
                                                       FontSize="14" 
                                                       TextWrapping="Wrap" 
                                                       Foreground="#212121"
                                                       LineHeight="20"
                                                       Margin="0,0,0,8"/>
                                            <TextBlock FontSize="12" Foreground="#757575">
                                                <Run Text="{Binding ReportedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"/>
                                                <Run Text=" • "/>
                                                <Run Text="{Binding ReporterName}"/>
                                            </TextBlock>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <TextBlock Text="{Binding AttachmentFileName}"
                                                           VerticalAlignment="Center"
                                                           Foreground="#616161">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasAttachment}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Button Content="РћС‚РєСЂС‹С‚СЊ РІР»РѕР¶РµРЅРёРµ"
                                                        Click="BtnOpenAttachment_Click"
                                                        Margin="12,0,0,0"
                                                        Padding="10,3">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasAttachment}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="30,20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="📱 Показать QR-код" 
                        x:Name="btnShowQR"
                        Click="BtnShowQR_Click"
                        Width="180" 
                        Height="40"
                        Background="#4CAF50"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        FontWeight="Medium"
                        Cursor="Hand"
                        Margin="0,0,15,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="4"
                                                Padding="12,10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#45A049"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                
                <Button Content="Закрыть" 
                        Click="BtnClose_Click" 
                        Width="120" 
                        Height="40"
                        Background="#1976D2"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        FontWeight="Medium"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="4"
                                                Padding="12,10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1565C0"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
