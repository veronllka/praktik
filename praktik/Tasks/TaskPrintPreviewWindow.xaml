<Window x:Class="praktik.TaskPrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="РџСЂРµРґРїСЂРѕСЃРјРѕС‚СЂ РїРµС‡Р°С‚Рё Р·Р°РґР°С‡Рё" Height="700" Width="600" WindowStartupLocation="CenterScreen">
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="20">
            <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Background="White" Padding="30" x:Name="PrintContent">
                <StackPanel>
                    <TextBlock x:Name="txtTitle" FontSize="20" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,20"/>
                    
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="РћР±СЉРµРєС‚:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppSubtleTextBrush}"/>
                        <TextBlock x:Name="txtSite" FontSize="14" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Р‘СЂРёРіР°РґР°:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppSubtleTextBrush}"/>
                        <TextBlock x:Name="txtCrew" FontSize="14" Margin="0,2,0,0"/>
                        <TextBlock x:Name="txtBrigadier" FontSize="12" Foreground="{DynamicResource AppSubtleTextBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="РџРµСЂРёРѕРґ РІС‹РїРѕР»РЅРµРЅРёСЏ:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppSubtleTextBrush}"/>
                        <TextBlock x:Name="txtPeriod" FontSize="14" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="РџСЂРёРѕСЂРёС‚РµС‚:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppSubtleTextBrush}"/>
                            <TextBlock x:Name="txtPriority" FontSize="14" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="РЎС‚Р°С‚СѓСЃ:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppSubtleTextBrush}"/>
                            <TextBlock x:Name="txtStatus" FontSize="14" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="pnlProgress" Margin="0,0,0,15" Visibility="Collapsed">
                        <TextBlock Text="РџРѕСЃР»РµРґРЅРёР№ РїСЂРѕРіСЂРµСЃСЃ:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppSubtleTextBrush}"/>
                        <TextBlock x:Name="txtProgress" FontSize="14" Margin="0,2,0,5"/>
                        <TextBlock Text="РљРѕРјРјРµРЅС‚Р°СЂРёР№:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppSubtleTextBrush}" Margin="0,5,0,0"/>
                        <TextBlock x:Name="txtComment" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,10,0,0">
                        <StackPanel>
                            <TextBlock x:Name="txtPrintDate" FontSize="10" Foreground="#999999" TextAlignment="Right"/>
                            <TextBlock x:Name="txtPrintedBy" FontSize="10" Foreground="#999999" TextAlignment="Right" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,10">
            <Button Content="РџРµС‡Р°С‚СЊ" Click="BtnPrint_Click" Width="120" Height="35" Margin="0,0,10,0" FontSize="14"/>
            <Button Content="РћС‚РјРµРЅР°" Click="BtnCancel_Click" Width="120" Height="35" FontSize="14"/>
        </StackPanel>
    </Grid>
</Window>


