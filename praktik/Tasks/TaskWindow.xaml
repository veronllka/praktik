<Window x:Class="praktik.TaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:praktik"
        mc:Ignorable="d"
        Title="Задача" Height="600" Width="700" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Margin="10">
            <TabItem Header="Основная информация">
                <ScrollViewer>
                    <StackPanel Margin="10">
                        <TextBlock Text="Название:" Margin="0,10,0,5"/>
                        <TextBox x:Name="txtTitle" Margin="0,0,0,10"/>

                        <TextBlock Text="Описание:" Margin="0,0,0,5"/>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="РћРїРёСЃР°РЅРёРµ:" VerticalAlignment="Center"/>
                            <Button x:Name="btnGenerateDescription"
                                    Grid.Column="1"
                                    Content="AI-РѕРїРёСЃР°РЅРёРµ"
                                    Click="BtnGenerateDescription_Click"
                                    Padding="12,4"
                                    MinWidth="150"
                                    Margin="10,0,0,0"/>
                        </Grid>
                        <TextBox x:Name="txtDescription" Margin="0,0,0,10" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                        <TextBlock x:Name="txtAiHint"
                                   Text="Р“РµРЅРµСЂР°С†РёСЏ РѕРїРёСЃР°РЅРёСЏ С‡РµСЂРµР· LM Studio РїРѕ РЅР°Р·РІР°РЅРёСЋ Р·Р°РґР°С‡Рё."
                                   Margin="0,-6,0,10"
                                   Foreground="#666666"
                                   FontSize="11"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Дата начала:" Margin="0,0,0,5"/>
                                <DatePicker x:Name="dpStartDate"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Дата окончания:" Margin="0,0,0,5"/>
                                <DatePicker x:Name="dpEndDate"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Объект:" Margin="0,0,0,5"/>
                                <ComboBox x:Name="cbSites" DisplayMemberPath="SiteName"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Бригада:" Margin="0,0,0,5"/>
                                <ComboBox x:Name="cbCrews" DisplayMemberPath="CrewName"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                <TextBlock Text="Приоритет:" Margin="0,0,0,5"/>
                                <ComboBox x:Name="cbPriorities" DisplayMemberPath="PriorityName"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Материалы">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border x:Name="borderAwaitMTS" Grid.Row="0" Background="#FDD835" 
                           Padding="8" Margin="0,0,0,10" CornerRadius="4" Visibility="Collapsed">
                        <TextBlock Text="⏳ Ожидание МТС" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>

                    <DataGrid x:Name="dgMaterialRequests" Grid.Row="1" 
                             AutoGenerateColumns="False" IsReadOnly="True" 
                             SelectionChanged="DgMaterialRequests_SelectionChanged" Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Статус" Binding="{Binding StatusDisplay}" Width="120"/>
                            <DataGridTextColumn Header="Требуется к" Binding="{Binding RequiredDateDisplay}" Width="120"/>
                            <DataGridTextColumn Header="Создана" Binding="{Binding CreatedAtDisplay}" Width="130"/>
                            <DataGridTextColumn Header="Позиций" Binding="{Binding ItemsCount}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnNewRequest" Content="Новая заявка" 
                               Click="BtnNewRequest_Click" Margin="0,0,8,0" Width="140"/>
                        <Button x:Name="btnEditRequest" Content="Редактировать" 
                               Click="BtnEditRequest_Click" Margin="0,0,8,0" Width="150"/>
                        <Button x:Name="btnViewRequestHistory" Content="История" 
                               Click="BtnViewRequestHistory_Click" Width="100"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="События" x:Name="tabEvents">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Последние события" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                            
                            <Border BorderBrush="#E0E0E0" 
                                    BorderThickness="1" 
                                    CornerRadius="4"
                                    Padding="10"
                                    Background="#F5F5F5"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Добавить отчет по задаче" 
                                               FontSize="12" 
                                               FontWeight="SemiBold"
                                               Foreground="#424242"
                                               Margin="0,0,0,8"/>
                                    <TextBox x:Name="txtEventComment"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             FontSize="12"
                                             Background="White"
                                             BorderBrush="#E0E0E0"
                                             Padding="8"
                                             MinHeight="50"
                                             MaxHeight="100"
                                             VerticalScrollBarVisibility="Auto"
                                             Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="Прогресс, %"
                                                   FontSize="12"
                                                   Foreground="#424242"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>
                                        <TextBox x:Name="txtEventProgressPercent"
                                                 Grid.Column="1"
                                                 Height="32"
                                                 FontSize="12"
                                                 Padding="8,0"
                                                 MaxLength="3"
                                                 VerticalContentAlignment="Center"
                                                 Background="White"
                                                 BorderBrush="#E0E0E0"
                                                 BorderThickness="1"
                                                 PreviewTextInput="ProgressTextBox_PreviewTextInput"
                                                 DataObject.Pasting="ProgressTextBox_Pasting"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="Необязательно"
                                                   FontSize="11"
                                                   Foreground="#666666"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,0,0"/>
                                        <Button Grid.Column="3"
                                                Content="Добавить отчет" 
                                                x:Name="btnAddEventComment"
                                                Click="BtnAddEventComment_Click"
                                                Width="130" 
                                                Height="32"
                                                HorizontalAlignment="Left"
                                                Margin="10,0,0,0"
                                                Padding="8,0"
                                                FontSize="12"/>
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="txtEventAttachment"
                                                   VerticalAlignment="Center"
                                                   Foreground="#666666"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="1"
                                                Content="Прикрепить файл"
                                                Click="BtnAttachEventFile_Click"
                                                Padding="10,4"
                                                Margin="12,0,0,0"/>
                                        <Button x:Name="btnRemoveEventAttachment"
                                                Grid.Column="2"
                                                Content="Удалить"
                                                Click="BtnRemoveEventAttachment_Click"
                                                Padding="10,4"
                                                Margin="8,0,0,0"
                                                Visibility="Collapsed"/>
                                    </Grid>
                                    <TextBlock Text="Файл будет сохранен после кнопки «Добавить отчет» и появится ниже в списке вложений."
                                               FontSize="11"
                                               Foreground="#777777"
                                               Margin="0,6,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            
                            <StackPanel x:Name="pnlQuickNote" Visibility="Collapsed" Margin="0,5,0,0">
                                <TextBox x:Name="txtQuickNote" 
                                        Width="350" 
                                        Height="32" 
                                        Margin="0,0,0,8"
                                        TextChanged="TxtQuickNote_TextChanged"
                                        KeyDown="TxtQuickNote_KeyDown"
                                        VerticalContentAlignment="Center"
                                        FontSize="13"
                                        Padding="8,0">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="ToolTip" Value="Короткая пометка…"/>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Прогресс, %"
                                               FontSize="12"
                                               Foreground="#424242"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <TextBox x:Name="txtQuickNoteProgressPercent"
                                             Width="70"
                                             Height="32"
                                             Margin="0,0,12,0"
                                             FontSize="12"
                                             Padding="8,0"
                                             MaxLength="3"
                                             VerticalContentAlignment="Center"
                                             TextChanged="TxtQuickNoteProgressPercent_TextChanged"
                                             PreviewTextInput="ProgressTextBox_PreviewTextInput"
                                             DataObject.Pasting="ProgressTextBox_Pasting"/>
                                    <TextBlock Text="Необязательно"
                                               FontSize="11"
                                               Foreground="#666666"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"/>
                                    <Button x:Name="btnSaveNote" 
                                           Content="Сохранить" 
                                           Click="BtnSaveNote_Click" 
                                           Width="100" 
                                           Height="32"
                                           Margin="0,0,8,0"
                                           IsEnabled="False"
                                           Padding="8,0"
                                           FontSize="13"/>
                                    <Button x:Name="btnCancelNote" 
                                           Content="Отмена" 
                                           Click="BtnCancelNote_Click" 
                                           Width="90" 
                                           Height="32"
                                           Padding="8,0"
                                           FontSize="13"/>
                                </StackPanel>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="txtQuickNoteAttachment"
                                               VerticalAlignment="Center"
                                               Foreground="#666666"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="1"
                                            Content="Прикрепить файл"
                                            Click="BtnAttachQuickNoteFile_Click"
                                            Padding="10,4"
                                            Margin="12,0,0,0"/>
                                    <Button x:Name="btnRemoveQuickNoteAttachment"
                                            Grid.Column="2"
                                            Content="Удалить"
                                            Click="BtnRemoveQuickNoteAttachment_Click"
                                            Padding="10,4"
                                            Margin="8,0,0,0"
                                            Visibility="Collapsed"/>
                                </Grid>
                            </StackPanel>
                            <Button x:Name="btnAddQuickNote" 
                                   Content="+ заметка" 
                                   Click="BtnAddQuickNote_Click" 
                                   MinWidth="130" 
                                   Padding="10,0"
                                   Height="30"
                                   HorizontalAlignment="Left"
                                   Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                CornerRadius="4"
                                Background="#FAFAFA"
                                Padding="10"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Вложения задачи"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Foreground="#424242"
                                           Margin="0,0,0,8"/>
                                <TextBlock x:Name="txtNoTaskAttachments"
                                           Text="Пока нет сохраненных вложений."
                                           FontSize="12"
                                           Foreground="#777777"/>
                                <ItemsControl x:Name="icTaskAttachments">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E6E6E6"
                                                    BorderThickness="0,1,0,0"
                                                    Padding="0,8,0,0"
                                                    Margin="0,8,0,0">
                                                <DockPanel LastChildFill="False">
                                                    <StackPanel DockPanel.Dock="Left" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding FileName}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#333333"/>
                                                        <TextBlock Text="{Binding MetaText}"
                                                                   FontSize="11"
                                                                   Foreground="#777777"
                                                                   Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Button DockPanel.Dock="Right"
                                                            Content="Открыть"
                                                            Click="BtnOpenTaskAttachmentFromList_Click"
                                                            Padding="10,3"
                                                            VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <ListBox x:Name="lbEvents"
                                Grid.Row="1"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,8,0,8" Margin="0,0,0,5">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" FontSize="13"/>
                                            <TextBlock Text="{Binding TimeInfo}" FontSize="11" Foreground="#666666" Margin="0,4,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding AttachmentFileName}"
                                                           VerticalAlignment="Center"
                                                           Foreground="#666666">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasAttachment}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Button Content="Открыть вложение"
                                                        Click="BtnOpenEventAttachment_Click"
                                                        Margin="12,0,0,0"
                                                        Padding="10,3">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasAttachment}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
            <Button x:Name="btnPrint" Content="Печать" Click="BtnPrint_Click" Width="100" Margin="0,0,20,0" Visibility="Collapsed"/>
            <Button x:Name="btnSave" Content="Сохранить" Click="BtnSave_Click" Width="100" Margin="0,0,20,0"/>
            <Button x:Name="btnCancel" Content="Отмена" Click="BtnCancel_Click" Width="100"/>
        </StackPanel>
    </Grid>
</Window>
