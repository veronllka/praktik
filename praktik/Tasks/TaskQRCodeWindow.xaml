<Window x:Class="praktik.TaskQRCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="QR-РєРѕРґ Р·Р°РґР°С‡Рё" Height="650" Width="550" 
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Р—Р°РіРѕР»РѕРІРѕРє -->
        <Border Grid.Row="0" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="30,20">
            <StackPanel>
                <TextBlock Text="QR-РљРћР” Р—РђР”РђР§Р" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource AppAccentBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>
                <TextBlock x:Name="txtTitle" 
                           FontSize="16" 
                           FontWeight="SemiBold" 
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource AppTextBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- РћСЃРЅРѕРІРЅРѕРµ СЃРѕРґРµСЂР¶РёРјРѕРµ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="{DynamicResource AppSurfaceBrush}">
            <StackPanel Margin="30,25" HorizontalAlignment="Center">
                
                <!-- QR-РєРѕРґ -->
                <Border BorderBrush="{DynamicResource AppBorderBrush}" 
                        BorderThickness="2" 
                        CornerRadius="8"
                        Padding="20"
                        Background="{DynamicResource AppSurfaceBrush}"
                        Margin="0,0,0,25">
                    <StackPanel HorizontalAlignment="Center">
                        <Image x:Name="imgQRCode"
                               Width="280"
                               Height="280"
                               Stretch="Uniform"
                               Margin="0,0,0,15"/>
                        <TextBlock Text="РћС‚СЃРєР°РЅРёСЂСѓР№С‚Рµ РґР»СЏ Р±С‹СЃС‚СЂРѕРіРѕ РґРѕСЃС‚СѓРїР° Рє Р·Р°РґР°С‡Рµ"
                                   FontSize="12"
                                   Foreground="{DynamicResource AppSubtleTextBrush}"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- РРЅС„РѕСЂРјР°С†РёСЏ Рѕ Р·Р°РґР°С‡Рµ -->
                <Border BorderBrush="{DynamicResource AppBorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="4"
                        Padding="20"
                        Background="{DynamicResource AppSurfaceAltBrush}"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="РРќР¤РћР РњРђР¦РРЇ Рћ Р—РђР”РђР§Р•" 
                                   FontWeight="Bold" 
                                   FontSize="13" 
                                   Margin="0,0,0,15" 
                                   Foreground="{DynamicResource AppMutedTextBrush}"/>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ID Р·Р°РґР°С‡Рё:" FontSize="13" Foreground="{DynamicResource AppMutedTextBrush}"/>
                            <TextBlock x:Name="txtTaskId" Grid.Column="1" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="РћР±СЉРµРєС‚:" FontSize="13" Foreground="{DynamicResource AppMutedTextBrush}"/>
                            <TextBlock x:Name="txtSite" Grid.Column="1" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource AppTextBrush}"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Р‘СЂРёРіР°РґР°:" FontSize="13" Foreground="{DynamicResource AppMutedTextBrush}"/>
                            <TextBlock x:Name="txtCrew" Grid.Column="1" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource AppTextBrush}"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="РџСЂРёРѕСЂРёС‚РµС‚:" FontSize="13" Foreground="{DynamicResource AppMutedTextBrush}"/>
                            <TextBlock x:Name="txtPriority" Grid.Column="1" FontSize="13" Foreground="{DynamicResource AppTextBrush}"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="РџРµСЂРёРѕРґ:" FontSize="13" Foreground="{DynamicResource AppMutedTextBrush}"/>
                            <TextBlock x:Name="txtPeriod" Grid.Column="1" FontSize="13" Foreground="{DynamicResource AppTextBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- РўРµРєСЃС‚РѕРІС‹Рµ РґР°РЅРЅС‹Рµ QR-РєРѕРґР° -->
                <Border BorderBrush="{DynamicResource AppBorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="4"
                        Padding="15"
                        Background="{DynamicResource AppSurfaceBrush}">
                    <StackPanel>
                        <TextBlock Text="Р”Р°РЅРЅС‹Рµ QR-РєРѕРґР° (РґР»СЏ РєРѕРїРёСЂРѕРІР°РЅРёСЏ)" 
                                   FontSize="11" 
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                   Margin="0,0,0,8"/>
                        <TextBox x:Name="txtQRData"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 FontSize="10"
                                 FontFamily="Consolas"
                                 Background="{DynamicResource AppBackgroundBrush}"
                                 BorderBrush="{DynamicResource AppBorderBrush}"
                                 Padding="8"
                                 MaxHeight="80"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- РљРЅРѕРїРєРё -->
        <Border Grid.Row="2" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="30,20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="рџ’ѕ РЎРѕС…СЂР°РЅРёС‚СЊ РєР°Рє РёР·РѕР±СЂР°Р¶РµРЅРёРµ" 
                        x:Name="btnSaveImage"
                        Click="BtnSaveImage_Click"
                        Width="220" 
                        Height="40"
                        FontSize="14"
                        FontWeight="Medium"
                        Margin="0,0,15,0"
                        Style="{StaticResource ModernButtonStyle}"/>
                
                <Button Content="Р—Р°РєСЂС‹С‚СЊ" 
                        Click="BtnClose_Click" 
                        Width="120" 
                        Height="40"
                        FontSize="14"
                        FontWeight="Medium"
                        Style="{StaticResource ModernOutlinedButtonStyle}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

