<Window x:Class="praktik.TaskQRCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="QR-код задачи" Height="650" Width="550" 
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="30,20">
            <StackPanel>
                <TextBlock Text="QR-КОД ЗАДАЧИ" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="#1976D2"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>
                <TextBlock x:Name="txtTitle" 
                           FontSize="16" 
                           FontWeight="SemiBold" 
                           TextWrapping="Wrap"
                           Foreground="#212121"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Основное содержимое -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="White">
            <StackPanel Margin="30,25" HorizontalAlignment="Center">
                
                <!-- QR-код -->
                <Border BorderBrush="#E0E0E0" 
                        BorderThickness="2" 
                        CornerRadius="8"
                        Padding="20"
                        Background="White"
                        Margin="0,0,0,25">
                    <StackPanel HorizontalAlignment="Center">
                        <Image x:Name="imgQRCode"
                               Width="280"
                               Height="280"
                               Stretch="Uniform"
                               Margin="0,0,0,15"/>
                        <TextBlock Text="Отсканируйте для быстрого доступа к задаче"
                                   FontSize="12"
                                   Foreground="#757575"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Информация о задаче -->
                <Border BorderBrush="#E0E0E0" 
                        BorderThickness="1" 
                        CornerRadius="4"
                        Padding="20"
                        Background="#FAFAFA"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="ИНФОРМАЦИЯ О ЗАДАЧЕ" 
                                   FontWeight="Bold" 
                                   FontSize="13" 
                                   Margin="0,0,0,15" 
                                   Foreground="#424242"/>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ID задачи:" FontSize="13" Foreground="#616161"/>
                            <TextBlock x:Name="txtTaskId" Grid.Column="1" FontSize="13" FontWeight="SemiBold" Foreground="#212121"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Объект:" FontSize="13" Foreground="#616161"/>
                            <TextBlock x:Name="txtSite" Grid.Column="1" FontSize="13" TextWrapping="Wrap" Foreground="#212121"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Бригада:" FontSize="13" Foreground="#616161"/>
                            <TextBlock x:Name="txtCrew" Grid.Column="1" FontSize="13" TextWrapping="Wrap" Foreground="#212121"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Приоритет:" FontSize="13" Foreground="#616161"/>
                            <TextBlock x:Name="txtPriority" Grid.Column="1" FontSize="13" Foreground="#212121"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Период:" FontSize="13" Foreground="#616161"/>
                            <TextBlock x:Name="txtPeriod" Grid.Column="1" FontSize="13" Foreground="#212121"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Текстовые данные QR-кода -->
                <Border BorderBrush="#E0E0E0" 
                        BorderThickness="1" 
                        CornerRadius="4"
                        Padding="15"
                        Background="#FFFFFF">
                    <StackPanel>
                        <TextBlock Text="Данные QR-кода (для копирования)" 
                                   FontSize="11" 
                                   FontWeight="SemiBold"
                                   Foreground="#616161"
                                   Margin="0,0,0,8"/>
                        <TextBox x:Name="txtQRData"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 FontSize="10"
                                 FontFamily="Consolas"
                                 Background="#F5F5F5"
                                 BorderBrush="#E0E0E0"
                                 Padding="8"
                                 MaxHeight="80"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="30,20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="💾 Сохранить как изображение" 
                        x:Name="btnSaveImage"
                        Click="BtnSaveImage_Click"
                        Width="220" 
                        Height="40"
                        Background="#4CAF50"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        FontWeight="Medium"
                        Cursor="Hand"
                        Margin="0,0,15,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="4"
                                                Padding="12,10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#45A049"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                
                <Button Content="Закрыть" 
                        Click="BtnClose_Click" 
                        Width="120" 
                        Height="40"
                        Background="#757575"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        FontWeight="Medium"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="4"
                                                Padding="12,10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#616161"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
