<Window x:Class="praktik.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:praktik"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Регистрация пользователя" Width="460"
        SizeToContent="Height"
        MinHeight="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4A5568"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <Border.Effect>
                                <DropShadowEffect Color="#40000000" Direction="270" ShadowDepth="2" BlurRadius="4" Opacity="0.3"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5A6578"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#3A4558"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#4A5568"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F7FAFC"/>
                    <Setter Property="BorderBrush" Value="#CBD5E0"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#EDF2F7"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#F7FAFC"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        Margin="{TemplateBinding Padding}"
                                        VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#718096"/>
                    <Setter Property="Background" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#CBD5E0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="ModernPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="#F7FAFC"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        Margin="{TemplateBinding Padding}"
                                        VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#718096"/>
                    <Setter Property="Background" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#CBD5E0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#F7FAFC"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#718096"/>
                    <Setter Property="Background" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#CBD5E0"/>
                </Trigger>
            </Style.Triggers>
            <Style.Resources>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Padding" Value="16,12"/>
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="#2D3748"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F7FAFC"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#EDF2F7"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Style.Resources>
        </Style>
    </Window.Resources>
    
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Border Margin="16"
                Padding="20"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
            <StackPanel>
                <TextBlock x:Name="txtHeaderTitle"
                           Text="Регистрация пользователя"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextBrush}"
                           Visibility="Collapsed"/>

                <TextBlock x:Name="txtHeaderSubtitle"
                           Text="Заполните данные новой учетной записи."
                           Margin="0,6,0,18"
                           Foreground="{DynamicResource AppMutedTextBrush}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Логин"
                               Margin="0,0,0,6"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextBrush}"/>
                    <TextBox x:Name="txtUsername"
                             Height="34"
                             Padding="8,4"
                             KeyDown="InputField_KeyDown"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Пароль"
                               Margin="0,0,0,6"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextBrush}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <PasswordBox x:Name="txtPassword"
                                     Height="34"
                                     Padding="8,4"
                                     KeyDown="InputField_KeyDown"
                                     PasswordChanged="TxtPassword_PasswordChanged"/>
                        <TextBox x:Name="txtPasswordVisible"
                                 Height="34"
                                 Padding="8,4"
                                 KeyDown="InputField_KeyDown"
                                 TextChanged="TxtPasswordVisible_TextChanged"
                                 Visibility="Collapsed"/>
                        <Button x:Name="btnTogglePassword"
                                Grid.Column="1"
                                Width="90"
                                Margin="8,0,0,0"
                                Content="Показать"
                                Click="BtnTogglePassword_Click"/>
                    </Grid>
                </StackPanel>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Полное имя"
                               Margin="0,0,0,6"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextBrush}"/>
                    <TextBox x:Name="txtFullName"
                             Height="34"
                             Padding="8,4"
                             KeyDown="InputField_KeyDown"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Роль"
                               Margin="0,0,0,6"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextBrush}"/>
                    <ComboBox x:Name="cbRoles"
                              Height="34"
                              Padding="6,2"
                              DisplayMemberPath="RoleName"/>
                </StackPanel>

                <TextBlock x:Name="txtRoleHint"
                           Margin="0,0,0,10"
                           Foreground="{DynamicResource AppMutedTextBrush}"
                           TextWrapping="Wrap"/>

                <TextBlock x:Name="txtError"
                           Margin="0,0,0,12"
                           Foreground="{DynamicResource AppDangerBrush}"
                           TextWrapping="Wrap"
                           MinHeight="18"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnRegister"
                            Content="Зарегистрироваться"
                            Click="BtnRegister_Click"
                            MinWidth="180"
                            Height="34"
                            Margin="0,0,10,0"
                            Style="{StaticResource ModernButtonStyle}"/>

                    <Button x:Name="btnCancel"
                            Content="Отмена"
                            Click="BtnCancel_Click"
                            MinWidth="110"
                            Height="34"
                            Style="{StaticResource ModernOutlinedButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>

