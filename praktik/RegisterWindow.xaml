<Window x:Class="praktik.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:praktik"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Регистрация пользователя" Height="820" Width="420" 
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4A5568"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <Border.Effect>
                                <DropShadowEffect Color="#40000000" Direction="270" ShadowDepth="2" BlurRadius="4" Opacity="0.3"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5A6578"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#3A4558"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#4A5568"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F7FAFC"/>
                    <Setter Property="BorderBrush" Value="#CBD5E0"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#EDF2F7"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#F7FAFC"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        Margin="{TemplateBinding Padding}"
                                        VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#718096"/>
                    <Setter Property="Background" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#CBD5E0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="ModernPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="#F7FAFC"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        Margin="{TemplateBinding Padding}"
                                        VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#718096"/>
                    <Setter Property="Background" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#CBD5E0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#F7FAFC"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#718096"/>
                    <Setter Property="Background" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#CBD5E0"/>
                </Trigger>
            </Style.Triggers>
            <Style.Resources>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Padding" Value="16,12"/>
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="#2D3748"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F7FAFC"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#EDF2F7"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Style.Resources>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F7FAFC" Offset="0"/>
                <GradientStop Color="#EDF2F7" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        
        <Grid>
            <Ellipse Width="300" Height="300" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-100,-100,0,0" Opacity="0.3">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#CBD5E0" Offset="0"/>
                        <GradientStop Color="#00CBD5E0" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            
            <Ellipse Width="250" Height="250" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-80,-80" Opacity="0.25">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#A0AEC0" Offset="0"/>
                        <GradientStop Color="#00A0AEC0" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>
        
        <Border Width="380" 
                VerticalAlignment="Center" 
                HorizontalAlignment="Center"
                Background="White"
                CornerRadius="12"
                BorderThickness="1"
                BorderBrush="#E2E8F0">
            <Border.Effect>
                <DropShadowEffect Color="#40000000" Direction="270" ShadowDepth="8" BlurRadius="20" Opacity="0.15"/>
            </Border.Effect>
            
            <StackPanel Margin="40,40,40,40">
                    <Grid Margin="0,0,0,30">
                        <Ellipse Width="70" Height="70" HorizontalAlignment="Center" Margin="0,0,0,15">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#E2E8F0" Offset="0"/>
                                    <GradientStop Color="#CBD5E0" Offset="1"/>
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="👷" FontSize="35" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    </Grid>
                    
                    <TextBlock Text="Регистрация" 
                              HorizontalAlignment="Center" 
                              FontSize="22"
                              FontWeight="SemiBold"
                              Foreground="#2D3748"
                              Margin="0,0,0,6"/>
                    
                    <TextBlock Text="Создайте новый аккаунт" 
                              HorizontalAlignment="Center" 
                              FontSize="13"
                              Foreground="#718096"
                              Margin="0,0,0,30"/>
                    
                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="Логин" 
                                  FontSize="12" 
                                  FontWeight="SemiBold"
                                  Foreground="#4A5568"
                                  Margin="0,0,0,8"/>
                        <TextBox x:Name="txtUsername" 
                                Style="{StaticResource ModernTextBoxStyle}"
                                Height="45"
                                KeyDown="InputField_KeyDown"/>
                    </StackPanel>
                    
                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="Пароль" 
                                  FontSize="12" 
                                  FontWeight="SemiBold"
                                  Foreground="#4A5568"
                                  Margin="0,0,0,8"/>
                    <Grid>
                        <PasswordBox x:Name="txtPassword" 
                                    Style="{StaticResource ModernPasswordBoxStyle}"
                                    Height="45"
                                    KeyDown="InputField_KeyDown"
                                    PasswordChanged="TxtPassword_PasswordChanged"
                                    Visibility="Visible"
                                    Padding="12,0,40,0"/>
                        <TextBox x:Name="txtPasswordVisible"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Height="45"
                                 KeyDown="InputField_KeyDown"
                                 TextChanged="TxtPasswordVisible_TextChanged"
                                 Visibility="Collapsed"
                                 Padding="12,0,40,0"/>
                        <Button x:Name="btnTogglePassword"
                                Width="32" Height="32"
                                Panel.ZIndex="10"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"
                                Click="BtnTogglePassword_Click"
                                Style="{x:Null}"
                                Background="Transparent"
                                BorderBrush="{x:Null}"
                                BorderThickness="0"
                                Cursor="Hand">
                            <materialDesign:PackIcon x:Name="IconPasswordEye" Kind="EyeOff" Width="20" Height="20" Foreground="#4A5568"/>
                        </Button>
                    </Grid>
                    </StackPanel>
                    
                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="Полное имя" 
                                  FontSize="12" 
                                  FontWeight="SemiBold"
                                  Foreground="#4A5568"
                                  Margin="0,0,0,8"/>
                        <TextBox x:Name="txtFullName" 
                                Style="{StaticResource ModernTextBoxStyle}"
                                Height="45"
                                KeyDown="InputField_KeyDown"/>
                    </StackPanel>
                    
                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="Роль" 
                                  FontSize="12" 
                                  FontWeight="SemiBold"
                                  Foreground="#4A5568"
                                  Margin="0,0,0,8"/>
                        <ComboBox x:Name="cbRoles" 
                                 Style="{StaticResource ModernComboBoxStyle}"
                                 DisplayMemberPath="RoleName"
                                 Height="45"/>
                        <TextBlock x:Name="txtRoleHint"
                                  Margin="0,8,0,0"
                                  FontSize="12"
                                  Foreground="#718096"
                                  TextWrapping="Wrap"/>
                    </StackPanel>
                    
                    <Button x:Name="btnRegister" 
                           Content="Зарегистрироваться" 
                           Click="BtnRegister_Click" 
                           Style="{StaticResource PrimaryButtonStyle}"
                           Height="45"
                           Margin="0,0,0,12"/>
                    
                    <Button x:Name="btnCancel" 
                           Content="Отмена" 
                           Click="BtnCancel_Click" 
                           Style="{StaticResource SecondaryButtonStyle}"
                           Height="45"
                           Margin="0,0,0,16"/>
                    
                    <TextBlock x:Name="txtError" 
                              Foreground="#E53E3E" 
                              HorizontalAlignment="Center"
                              TextWrapping="Wrap"
                              FontSize="13"
                              TextAlignment="Center"
                              MinHeight="20"
                              Margin="0,0,0,10"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
