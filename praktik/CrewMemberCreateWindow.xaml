<Window x:Class="praktik.CrewMemberCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Новый сотрудник"
        Height="360"
        Width="560"
        MinHeight="340"
        MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Border CornerRadius="8"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                Background="{DynamicResource AppSurfaceBrush}"
                Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Добавление сотрудника"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Margin="0,0,0,14"/>

                <TextBox x:Name="txtFullName"
                         Grid.Row="1"
                         materialDesign:HintAssist.Hint="ФИО сотрудника"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         Margin="0,0,0,12"/>

                <DatePicker x:Name="dpJoinedAt"
                            Grid.Row="2"
                            materialDesign:HintAssist.Hint="Дата включения в бригаду"
                            Style="{StaticResource MaterialDesignFloatingHintDatePicker}"
                            Margin="0,0,0,12"/>

                <TextBlock Grid.Row="3"
                           Text="Логин и пароль для сотрудника создаются автоматически."
                           Foreground="{DynamicResource AppMutedTextBrush}"
                           FontSize="13"
                           VerticalAlignment="Top"/>

                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,16,0,0">
                    <Button Content="Отмена"
                            Width="130"
                            Height="38"
                            Margin="0,0,10,0"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            IsCancel="True"/>
                    <Button Content="Сохранить"
                            Width="130"
                            Height="38"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Click="BtnSave_Click"
                            IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

