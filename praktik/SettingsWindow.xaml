<Window x:Class="praktik.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:appControls="clr-namespace:praktik.Controls"
        mc:Ignorable="d"
        Title="Настройки"
        Width="700"
        Height="860"
        MinWidth="660"
        MinHeight="820"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="SettingsCardBorderStyle" TargetType="Border" BasedOn="{StaticResource AppleCard}">
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppSubtleTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="AccentOptionStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="AccentBorder"
                                Width="160" Padding="14" CornerRadius="14"
                                BorderThickness="1.5"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                Background="{DynamicResource AppSurfaceAltBrush}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="AccentBorder" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
                                <Setter TargetName="AccentBorder" Property="Background" Value="{DynamicResource AppAccentSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="AccentBorder" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Row style for settings items with toggle -->
        <Style x:Key="SettingsRowStyle" TargetType="Border">
            <Setter Property="Padding" Value="0,10"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="SettingsRowLastStyle" TargetType="Border">
            <Setter Property="Padding" Value="10,0"/>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Apple-style header -->
        <Border Grid.Row="0"
                Background="{DynamicResource AppNavigationBrush}"
                Padding="24,20">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="2" Opacity="0.2" Direction="270"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Настройки"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource AppTextBrush}"/>
                <TextBlock Text="Смена пароля, внешний вид, анимации и производительность."
                           Margin="0,6,0,0" FontSize="13"
                           Foreground="{DynamicResource AppMutedTextBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,8">
                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountCircleOutline"
                                                     Width="22" Height="22"
                                                     Margin="0,0,10,0"
                                                     Foreground="{DynamicResource AppAccentBrush}"
                                                     VerticalAlignment="Center"/>
                            <TextBlock Text="Текущий пользователь"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Padding="14"
                                    CornerRadius="12"
                                    Background="{DynamicResource MaterialDesignPaper}"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Имя"
                                               Foreground="{DynamicResource MaterialDesignBody}"/>
                                    <TextBlock x:Name="txtCurrentFullName"
                                               Margin="0,6,0,0"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Padding="14"
                                    CornerRadius="12"
                                    Background="{DynamicResource MaterialDesignPaper}"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Логин"
                                               Foreground="{DynamicResource MaterialDesignBody}"/>
                                    <TextBlock x:Name="txtCurrentLogin"
                                               Margin="0,6,0,0"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4"
                                    Padding="14"
                                    CornerRadius="12"
                                    Background="{DynamicResource MaterialDesignPaper}"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Роль"
                                               Foreground="{DynamicResource MaterialDesignBody}"/>
                                    <TextBlock x:Name="txtCurrentRole"
                                               Margin="0,6,0,0"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PaletteOutline"
                                                     Width="22" Height="22"
                                                     Margin="0,0,10,0"
                                                     Foreground="{DynamicResource AppAccentBrush}"
                                                     VerticalAlignment="Center"/>
                            <TextBlock Text="Внешний вид"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="Тема приложения"
                                       FontWeight="SemiBold"/>
                            <WrapPanel Margin="0,12,0,0">
                                <RadioButton x:Name="rbLightTheme"
                                             GroupName="BaseThemeGroup"
                                             Checked="BaseTheme_Checked"
                                             Margin="0,0,18,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="WhiteBalanceSunny"
                                                                 Width="20"
                                                                 Height="20"
                                                                 Margin="0,0,8,0"/>
                                        <TextBlock Text="Светлая"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="rbDarkTheme"
                                             GroupName="BaseThemeGroup"
                                             Checked="BaseTheme_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="WeatherNight"
                                                                 Width="20"
                                                                 Height="20"
                                                                 Margin="0,0,8,0"/>
                                        <TextBlock Text="Тёмная"/>
                                    </StackPanel>
                                </RadioButton>
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="4">
                            <TextBlock Text="Цветовая гамма"
                                       FontWeight="SemiBold"/>
                            <WrapPanel Margin="0,12,0,0">
                                <RadioButton x:Name="rbAccentBrown"
                                             GroupName="AccentPaletteGroup"
                                             Tag="Brown"
                                             Checked="AccentOption_Checked"
                                             Style="{StaticResource AccentOptionStyle}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="20" Height="20" Fill="#8D6E63"/>
                                            <Ellipse Width="20" Height="20" Fill="#FFD54F" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="Коричневый"
                                                   Margin="0,12,0,0"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="rbAccentPink"
                                             GroupName="AccentPaletteGroup"
                                             Tag="Pink"
                                             Checked="AccentOption_Checked"
                                             Style="{StaticResource AccentOptionStyle}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="20" Height="20" Fill="#EC407A"/>
                                            <Ellipse Width="20" Height="20" Fill="#F8BBD0" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="Розовый"
                                                   Margin="0,12,0,0"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="rbAccentLightBlue"
                                             GroupName="AccentPaletteGroup"
                                             Tag="LightBlue"
                                             Checked="AccentOption_Checked"
                                             Style="{StaticResource AccentOptionStyle}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="20" Height="20" Fill="#03A9F4"/>
                                            <Ellipse Width="20" Height="20" Fill="#80DEEA" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="Голубой"
                                                   Margin="0,12,0,0"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </RadioButton>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="LockReset"
                                                     Width="22" Height="22"
                                                     Margin="0,0,10,0"
                                                     Foreground="{DynamicResource AppAccentBrush}"
                                                     VerticalAlignment="Center"/>
                            <TextBlock Text="Смена пароля"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="Новый пароль"
                                       FontWeight="SemiBold"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>

                                <PasswordBox x:Name="txtNewPassword"
                                             Height="36"
                                             Padding="10,6"
                                             PasswordChanged="PasswordFields_Changed"/>
                                <materialDesign:PackIcon x:Name="iconNewPasswordStatus"
                                                         Grid.Column="1"
                                                         Width="22"
                                                         Height="22"
                                                         Margin="10,0,0,0"
                                                         VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="txtNewPasswordHint"
                                       Margin="0,8,0,0"
                                       Foreground="{DynamicResource MaterialDesignBody}"
                                       Text="Оставьте поле пустым, если пароль менять не нужно."
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4">
                            <TextBlock Text="Подтверждение пароля"
                                       FontWeight="SemiBold"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>

                                <PasswordBox x:Name="txtConfirmPassword"
                                             Height="36"
                                             Padding="10,6"
                                             PasswordChanged="PasswordFields_Changed"/>
                                <materialDesign:PackIcon x:Name="iconConfirmPasswordStatus"
                                                         Grid.Column="1"
                                                         Width="22"
                                                         Height="22"
                                                         Margin="10,0,0,0"
                                                         VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="txtConfirmPasswordHint"
                                       Margin="0,8,0,0"
                                       Foreground="{DynamicResource MaterialDesignBody}"
                                       Text="Повторите новый пароль для проверки совпадения."
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <TextBlock x:Name="txtPasswordError"
                                   Grid.Row="6"
                                   Foreground="{DynamicResource AppDangerBrush}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <!-- ═══ ANIMATION & PERFORMANCE PANEL ═════════════════════ -->
                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <StackPanel>
                        <!-- Header row -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <materialDesign:PackIcon Kind="LightningBolt"
                                                     Width="22" Height="22"
                                                     Margin="0,0,10,0"
                                                     Foreground="{DynamicResource AppAccentBrush}"
                                                     VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="Анимации и производительность"
                                           FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Анимации автоматически отключаются при высокой нагрузке."
                                           FontSize="12" Margin="0,3,0,0"
                                           Foreground="{DynamicResource AppMutedTextBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Main toggle -->
                        <Border Style="{StaticResource SettingsRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Включить анимации" FontWeight="Medium"/>
                                    <TextBlock Text="Плавные переходы между страницами и анимированные иконки."
                                               FontSize="12" Foreground="{DynamicResource AppMutedTextBrush}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="chkAnimationsEnabled"
                                          Grid.Column="1"
                                          Style="{StaticResource AppleToggleSwitch}"
                                          VerticalAlignment="Center"
                                          Checked="AnimationSettings_Changed"
                                          Unchecked="AnimationSettings_Changed"/>
                            </Grid>
                        </Border>

                        <!-- CPU auto-disable -->
                        <Border Style="{StaticResource SettingsRowStyle}" x:Name="pnlCpuSettings">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Авто-откл. при высокой нагрузке CPU"
                                                   FontWeight="Medium"/>
                                        <TextBlock Text="Анимации отключатся, когда процессор превысит порог."
                                                   FontSize="12" Foreground="{DynamicResource AppMutedTextBrush}"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="chkAutoDisableCpu"
                                              Grid.Column="1"
                                              Style="{StaticResource AppleToggleSwitch}"
                                              VerticalAlignment="Center"
                                              Checked="AnimationSettings_Changed"
                                              Unchecked="AnimationSettings_Changed"/>
                                </Grid>
                                <!-- CPU threshold slider -->
                                <Grid x:Name="pnlCpuThreshold" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontSize="12" Foreground="{DynamicResource AppSubtleTextBrush}"
                                                   Margin="0,0,0,6">
                                            <Run Text="Порог CPU: "/>
                                            <Run x:Name="runCpuThreshold" Text="80"/>
                                            <Run Text="%"/>
                                        </TextBlock>
                                        <Slider x:Name="sliderCpuThreshold"
                                                Style="{StaticResource AppleSlider}"
                                                Minimum="50" Maximum="95" Value="80"
                                                SmallChange="5" LargeChange="10"
                                                TickFrequency="5" IsSnapToTickEnabled="True"
                                                ValueChanged="SliderCpuThreshold_Changed"/>
                                    </StackPanel>
                                    <!-- Live CPU indicator -->
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right"
                                                VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock Text="сейчас" FontSize="10"
                                                   Foreground="{DynamicResource AppSubtleTextBrush}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="txtLiveCpu" Text="—%"
                                                   FontSize="13" FontWeight="Bold"
                                                   Foreground="{DynamicResource AppAccentBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Battery auto-disable -->
                        <Border x:Name="pnlBatterySettings" Padding="0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Авто-откл. при низком заряде батареи"
                                                   FontWeight="Medium"/>
                                        <TextBlock Text="Экономит энергию при работе от аккумулятора."
                                                   FontSize="12" Foreground="{DynamicResource AppMutedTextBrush}"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="chkAutoDisableBattery"
                                              Grid.Column="1"
                                              Style="{StaticResource AppleToggleSwitch}"
                                              VerticalAlignment="Center"
                                              Checked="AnimationSettings_Changed"
                                              Unchecked="AnimationSettings_Changed"/>
                                </Grid>
                                <!-- Battery threshold slider -->
                                <Grid x:Name="pnlBatteryThreshold">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontSize="12" Foreground="{DynamicResource AppSubtleTextBrush}"
                                                   Margin="0,0,0,6">
                                            <Run Text="Порог заряда: "/>
                                            <Run x:Name="runBatteryThreshold" Text="20"/>
                                            <Run Text="%"/>
                                        </TextBlock>
                                        <Slider x:Name="sliderBatteryThreshold"
                                                Style="{StaticResource AppleSlider}"
                                                Minimum="5" Maximum="50" Value="20"
                                                SmallChange="5" LargeChange="10"
                                                TickFrequency="5" IsSnapToTickEnabled="True"
                                                ValueChanged="SliderBatteryThreshold_Changed"/>
                                    </StackPanel>
                                    <!-- Live battery indicator -->
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right"
                                                VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock Text="сейчас" FontSize="10"
                                                   Foreground="{DynamicResource AppSubtleTextBrush}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="txtLiveBattery" Text="—%"
                                                   FontSize="13" FontWeight="Bold"
                                                   Foreground="{DynamicResource AppSuccessBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Live status row -->
                        <Border Background="{DynamicResource AppSurfaceAltBrush}"
                                CornerRadius="10" Padding="14,10" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="dotAnimStatus"
                                             Style="{StaticResource StatusDotGreen}"
                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="txtAnimStatus"
                                               Text="Анимации включены"
                                               FontSize="12" FontWeight="Medium"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <appControls:AnimatedSpinner x:Name="perfSpinner"
                                                              Grid.Column="2"
                                                              Width="16" Height="16"
                                                              Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Padding="20,14"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource AppBorderBrush}"
                Background="{DynamicResource AppNavigationBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена"
                        Width="110" Height="38" Margin="0,0,10,0"
                        Style="{StaticResource AppleGhostButton}"
                        Click="BtnCancel_Click"/>
                <Button x:Name="btnSave"
                        Content="Сохранить изменения"
                        Width="210" Height="38"
                        Style="{StaticResource ApplePrimaryButton}"
                        Click="BtnSave_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
