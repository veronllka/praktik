<Window x:Class="praktik.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Настройки"
        Width="680"
        Height="760"
        MinWidth="640"
        MinHeight="700"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}">
    <Window.Resources>
        <Style x:Key="SettingsCardBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
            <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}"/>
        </Style>

        <Style x:Key="AccentOptionStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="AccentBorder"
                                Width="170"
                                Padding="14"
                                CornerRadius="14"
                                BorderThickness="1.5"
                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                Background="{DynamicResource MaterialDesignPaper}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="AccentBorder" Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}" />
                                <Setter TargetName="AccentBorder" Property="Background" Value="{DynamicResource PrimaryHueLightBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="AccentBorder" Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource MaterialDesignPaper}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <materialDesign:ColorZone Grid.Row="0"
                                  Mode="PrimaryMid"
                                  Padding="24">
            <StackPanel>
                <TextBlock Text="Настройки"
                           Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                           Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"/>
                <TextBlock Text="Смена пароля, выбор темы и цветовой гаммы для текущего пользователя."
                           Margin="0,8,0,0"
                           Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </materialDesign:ColorZone>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,8">
                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountCircleOutline"
                                                     Width="26"
                                                     Height="26"
                                                     Margin="0,0,10,0"
                                                     VerticalAlignment="Center"/>
                            <TextBlock Text="Текущий пользователь"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Padding="14"
                                    CornerRadius="12"
                                    Background="{DynamicResource MaterialDesignPaper}"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Имя"
                                               Foreground="{DynamicResource MaterialDesignBody}"/>
                                    <TextBlock x:Name="txtCurrentFullName"
                                               Margin="0,6,0,0"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Padding="14"
                                    CornerRadius="12"
                                    Background="{DynamicResource MaterialDesignPaper}"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Логин"
                                               Foreground="{DynamicResource MaterialDesignBody}"/>
                                    <TextBlock x:Name="txtCurrentLogin"
                                               Margin="0,6,0,0"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4"
                                    Padding="14"
                                    CornerRadius="12"
                                    Background="{DynamicResource MaterialDesignPaper}"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Роль"
                                               Foreground="{DynamicResource MaterialDesignBody}"/>
                                    <TextBlock x:Name="txtCurrentRole"
                                               Margin="0,6,0,0"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PaletteOutline"
                                                     Width="24"
                                                     Height="24"
                                                     Margin="0,0,10,0"
                                                     VerticalAlignment="Center"/>
                            <TextBlock Text="Внешний вид"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="Тема приложения"
                                       FontWeight="SemiBold"/>
                            <WrapPanel Margin="0,12,0,0">
                                <RadioButton x:Name="rbLightTheme"
                                             GroupName="BaseThemeGroup"
                                             Checked="BaseTheme_Checked"
                                             Margin="0,0,18,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="WhiteBalanceSunny"
                                                                 Width="20"
                                                                 Height="20"
                                                                 Margin="0,0,8,0"/>
                                        <TextBlock Text="Светлая"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="rbDarkTheme"
                                             GroupName="BaseThemeGroup"
                                             Checked="BaseTheme_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="WeatherNight"
                                                                 Width="20"
                                                                 Height="20"
                                                                 Margin="0,0,8,0"/>
                                        <TextBlock Text="Тёмная"/>
                                    </StackPanel>
                                </RadioButton>
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="4">
                            <TextBlock Text="Цветовая гамма"
                                       FontWeight="SemiBold"/>
                            <WrapPanel Margin="0,12,0,0">
                                <RadioButton x:Name="rbAccentBrown"
                                             GroupName="AccentPaletteGroup"
                                             Tag="Brown"
                                             Checked="AccentOption_Checked"
                                             Style="{StaticResource AccentOptionStyle}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="20" Height="20" Fill="#8D6E63"/>
                                            <Ellipse Width="20" Height="20" Fill="#FFD54F" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="Коричневый"
                                                   Margin="0,12,0,0"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="rbAccentPink"
                                             GroupName="AccentPaletteGroup"
                                             Tag="Pink"
                                             Checked="AccentOption_Checked"
                                             Style="{StaticResource AccentOptionStyle}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="20" Height="20" Fill="#EC407A"/>
                                            <Ellipse Width="20" Height="20" Fill="#F8BBD0" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="Розовый"
                                                   Margin="0,12,0,0"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="rbAccentLightBlue"
                                             GroupName="AccentPaletteGroup"
                                             Tag="LightBlue"
                                             Checked="AccentOption_Checked"
                                             Style="{StaticResource AccentOptionStyle}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="20" Height="20" Fill="#03A9F4"/>
                                            <Ellipse Width="20" Height="20" Fill="#80DEEA" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="Голубой"
                                                   Margin="0,12,0,0"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </RadioButton>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="LockReset"
                                                     Width="24"
                                                     Height="24"
                                                     Margin="0,0,10,0"
                                                     VerticalAlignment="Center"/>
                            <TextBlock Text="Смена пароля"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="Новый пароль"
                                       FontWeight="SemiBold"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>

                                <PasswordBox x:Name="txtNewPassword"
                                             Height="36"
                                             Padding="10,6"
                                             PasswordChanged="PasswordFields_Changed"/>
                                <materialDesign:PackIcon x:Name="iconNewPasswordStatus"
                                                         Grid.Column="1"
                                                         Width="22"
                                                         Height="22"
                                                         Margin="10,0,0,0"
                                                         VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="txtNewPasswordHint"
                                       Margin="0,8,0,0"
                                       Foreground="{DynamicResource MaterialDesignBody}"
                                       Text="Оставьте поле пустым, если пароль менять не нужно."
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4">
                            <TextBlock Text="Подтверждение пароля"
                                       FontWeight="SemiBold"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>

                                <PasswordBox x:Name="txtConfirmPassword"
                                             Height="36"
                                             Padding="10,6"
                                             PasswordChanged="PasswordFields_Changed"/>
                                <materialDesign:PackIcon x:Name="iconConfirmPasswordStatus"
                                                         Grid.Column="1"
                                                         Width="22"
                                                         Height="22"
                                                         Margin="10,0,0,0"
                                                         VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="txtConfirmPasswordHint"
                                       Margin="0,8,0,0"
                                       Foreground="{DynamicResource MaterialDesignBody}"
                                       Text="Повторите новый пароль для проверки совпадения."
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <TextBlock x:Name="txtPasswordError"
                                   Grid.Row="6"
                                   Foreground="#D32F2F"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Padding="20,16"
                BorderThickness="1,1,0,0"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                Background="{DynamicResource MaterialDesignPaper}">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Отмена"
                        Width="120"
                        Height="38"
                        Margin="0,0,12,0"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Click="BtnCancel_Click"/>
                <Button x:Name="btnSave"
                        Content="Сохранить изменения"
                        Width="220"
                        Height="38"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="BtnSave_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
