<UserControl x:Class="praktik.Controls.AnimatedHamburgerIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="22" Height="22">
    <Grid>
        <!-- Top bar — rotates to form top part of X -->
        <Rectangle x:Name="TopBar"
                   Width="18" Height="2" VerticalAlignment="Center"
                   Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   RadiusX="1" RadiusY="1"
                   Margin="0,-6,0,0"
                   RenderTransformOrigin="0.5,0.5">
            <Rectangle.RenderTransform>
                <RotateTransform x:Name="TopBarRotation"/>
            </Rectangle.RenderTransform>
        </Rectangle>

        <!-- Middle bar — fades out when open -->
        <Rectangle x:Name="MidBar"
                   Width="18" Height="2" VerticalAlignment="Center"
                   Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   RadiusX="1" RadiusY="1">
            <Rectangle.RenderTransform>
                <ScaleTransform x:Name="MidBarScale" CenterX="9"/>
            </Rectangle.RenderTransform>
        </Rectangle>

        <!-- Bottom bar — rotates to form bottom part of X -->
        <Rectangle x:Name="BottomBar"
                   Width="18" Height="2" VerticalAlignment="Center"
                   Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   RadiusX="1" RadiusY="1"
                   Margin="0,6,0,0"
                   RenderTransformOrigin="0.5,0.5">
            <Rectangle.RenderTransform>
                <RotateTransform x:Name="BottomBarRotation"/>
            </Rectangle.RenderTransform>
        </Rectangle>
    </Grid>
</UserControl>
