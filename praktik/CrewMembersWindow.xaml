<Window x:Class="praktik.CrewMembersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Состав бригады"
        Height="620"
        Width="980"
        MinHeight="520"
        MinWidth="860"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="16" Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtTitle"
                   Grid.Row="0"
                   Text="Состав бригады"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16"/>

        <Border Grid.Row="1"
                Padding="12"
                Margin="0,0,0,12"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <DatePicker x:Name="dpJoinedAt"
                            Grid.Column="0"
                            Height="34"
                            Width="240"
                            materialDesign:HintAssist.Hint="Дата включения"
                            Style="{StaticResource MaterialDesignFloatingHintDatePicker}"
                            VerticalAlignment="Center"/>

                <Button x:Name="btnCreateMember"
                        Grid.Column="1"
                        Content="Добавить сотрудника"
                        Margin="12,0,0,0"
                        Padding="18,6"
                        Height="34"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="BtnAddMember_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <DataGrid x:Name="dgCrewMembers"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionChanged="DgCrewMembers_SelectionChanged"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Сотрудник" Binding="{Binding EmployeeName}" Width="2.6*"/>
                    <DataGridTextColumn Header="Дата включения" Binding="{Binding JoinedAtDisplay}" Width="1.2*"/>
                    <DataGridTextColumn Header="Дата выбытия" Binding="{Binding LeftAtDisplay}" Width="1.2*"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding MemberState}" Width="1*"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="txtNoData"
                       Text="Подходящих участников не найдено"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="15"
                       Foreground="{DynamicResource AppMutedTextBrush}"
                       Visibility="Collapsed"/>
        </Grid>

        <Border Grid.Row="3"
                Padding="12"
                Margin="0,12,0,0"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <DatePicker x:Name="dpLeftAt"
                            Grid.Column="0"
                            Width="180"
                            Height="34"
                            VerticalAlignment="Center"/>

                <Button x:Name="btnRemoveMember"
                        Grid.Column="1"
                        Content="Исключить из бригады"
                        Margin="12,0,0,0"
                        Padding="18,6"
                        Height="34"
                        Click="BtnRemoveMember_Click"/>

                <CheckBox x:Name="chkShowHistory"
                          Grid.Column="2"
                          Content="Показывать историю (выбывших)"
                          Margin="18,0,0,0"
                          VerticalAlignment="Center"
                          Checked="ChkShowHistory_Changed"
                          Unchecked="ChkShowHistory_Changed"/>

                <Button Grid.Column="3"
                        Content="Закрыть"
                        Padding="18,6"
                        Height="34"
                        IsCancel="True"/>
            </Grid>
        </Border>
    </Grid>
</Window>
