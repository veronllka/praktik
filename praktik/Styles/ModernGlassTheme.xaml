<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <LinearGradientBrush x:Key="AppBackgroundGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D8EEFF" Offset="0"/>
        <GradientStop Color="#C8DAFF" Offset="0.48"/>
        <GradientStop Color="#D8D0FF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassPrimaryGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#78A2F4" Offset="0"/>
        <GradientStop Color="#9588EA" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassPrimaryHoverBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#6C97EC" Offset="0"/>
        <GradientStop Color="#8678DD" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#DFF0FF"/>
    <SolidColorBrush x:Key="AppNavigationBrush" Color="#A0D0F0FF"/>
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#68EEF4FF"/>
    <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="#54E0F0FF"/>
    <SolidColorBrush x:Key="AppPanelBrush" Color="#48D4EEFF"/>
    <SolidColorBrush x:Key="AppGlassBrush" Color="#54D8F0FF"/>
    <SolidColorBrush x:Key="AppGlassStrongBrush" Color="#68EEF4FF"/>
    <SolidColorBrush x:Key="AppGlassSoftBrush" Color="#36D4ECFF"/>
    <SolidColorBrush x:Key="AppGlassBorderBrush" Color="#90FFFFFF"/>
    <SolidColorBrush x:Key="AppBorderBrush" Color="#90FFFFFF"/>
    <SolidColorBrush x:Key="AppInputBackgroundBrush" Color="#3CFFFFFF"/>
    <SolidColorBrush x:Key="AppTextBrush" Color="#18223A"/>
    <SolidColorBrush x:Key="AppMutedTextBrush" Color="#4A5878"/>
    <SolidColorBrush x:Key="AppSubtleTextBrush" Color="#6B7899"/>
    <SolidColorBrush x:Key="AppAccentBrush" Color="#6D96F4"/>
    <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#8678DD"/>
    <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#D7E5FF"/>
    <SolidColorBrush x:Key="AppSelectionBrush" Color="#DDEAFF"/>
    <SolidColorBrush x:Key="AppSelectionTextBrush" Color="#253044"/>
    <SolidColorBrush x:Key="AppDangerBrush" Color="#D9485C"/>
    <SolidColorBrush x:Key="AppDangerSoftBrush" Color="#26D9485C"/>

    <LinearGradientBrush x:Key="GlassShellPanelBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#72D8F0FF" Offset="0"/>
        <GradientStop Color="#5AC8E8FF" Offset="0.55"/>
        <GradientStop Color="#4EC4EAFF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassCardBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#78EEF4FF" Offset="0"/>
        <GradientStop Color="#58E6EFFF" Offset="0.58"/>
        <GradientStop Color="#50E2DCFF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassIconTileBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#70D8EEFF" Offset="0"/>
        <GradientStop Color="#48CCDFFF" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="GlassShellChromeBrush" Color="#52D8F0FF"/>
    <SolidColorBrush x:Key="GlassShellChromeHoverBrush" Color="#72DEEEFF"/>
    <SolidColorBrush x:Key="GlassShellBorderBrush" Color="#98FFFFFF"/>
    <SolidColorBrush x:Key="GlassTableRowBrush" Color="#18FFFFFF"/>
    <SolidColorBrush x:Key="GlassTableRowHoverBrush" Color="#30FFFFFF"/>
    <SolidColorBrush x:Key="GlassTableSelectedBrush" Color="#38DCEBFF"/>

    <Style x:Key="GlassWindowStyle" TargetType="{x:Type Window}">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundGradientBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="GlassWindowRootStyle" TargetType="{x:Type Grid}">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundGradientBrush}"/>
        <Setter Property="Margin" Value="18"/>
    </Style>

    <Style x:Key="ModernCardStyle" TargetType="{x:Type Border}">
        <Setter Property="Margin" Value="8"/>
        <Setter Property="Padding" Value="24"/>
        <Setter Property="Background" Value="{StaticResource GlassCardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassShellBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="24"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="42" ShadowDepth="14" Opacity="0.18" Color="#6D86AD"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource ModernCardStyle}"/>

    <Style x:Key="GlassDialogCardStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource ModernCardStyle}">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="24"/>
        <Setter Property="CornerRadius" Value="24"/>
    </Style>

    <Style x:Key="GlassToolbarStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource ModernCardStyle}">
        <Setter Property="Margin" Value="0,0,0,14"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="CornerRadius" Value="24"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.12" Color="#7B91B2"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassFooterBarStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource ModernCardStyle}">
        <Setter Property="Margin" Value="0,14,0,0"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="CornerRadius" Value="24"/>
    </Style>

    <Style x:Key="GlassHeaderBarStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource ModernCardStyle}">
        <Setter Property="Margin" Value="0,0,0,16"/>
        <Setter Property="Padding" Value="24,20"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.10" Color="#8EA7C8"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassDataGridHostStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource ModernCardStyle}">
        <Setter Property="Margin" Value="0,0,0,16"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="24"/>
    </Style>

    <Style x:Key="GlassPrintPaperStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#FFFFFFFF"/>
        <Setter Property="BorderBrush" Value="#DDE6F0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="30"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.13" Color="#8EA7C8"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernHeaderTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
    </Style>

    <Style x:Key="HeaderTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ModernHeaderTextStyle}"/>

    <Style x:Key="ModernSubHeaderTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
    </Style>

    <Style x:Key="SubHeaderTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ModernSubHeaderTextStyle}"/>

    <Style x:Key="GlassFieldLabelStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/>
        <Setter Property="Margin" Value="2,0,0,7"/>
    </Style>

    <Style x:Key="ModernButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource GlassPrimaryGradientBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#66FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="18,8"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource GlassPrimaryHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <EventTrigger RoutedEvent="PreviewMouseDown">
                <BeginStoryboard Storyboard="{StaticResource ButtonPressDown}"/>
            </EventTrigger>
            <EventTrigger RoutedEvent="PreviewMouseUp">
                <BeginStoryboard Storyboard="{StaticResource ButtonPressUp}"/>
            </EventTrigger>
            <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard Storyboard="{StaticResource ButtonPressUp}"/>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GlassIconButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="48"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="MinWidth" Value="48"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="{StaticResource GlassShellChromeBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassShellBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="17"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource GlassShellChromeHoverBrush}"/>
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#A8FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.86"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <EventTrigger RoutedEvent="PreviewMouseDown">
                <BeginStoryboard Storyboard="{StaticResource ButtonPressDown}"/>
            </EventTrigger>
            <EventTrigger RoutedEvent="PreviewMouseUp">
                <BeginStoryboard Storyboard="{StaticResource ButtonPressUp}"/>
            </EventTrigger>
            <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard Storyboard="{StaticResource ButtonPressUp}"/>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GlassIconImageStyle" TargetType="{x:Type Image}">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Opacity" Value="0.9"/>
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="GlassNavIconImageStyle" TargetType="{x:Type Image}" BasedOn="{StaticResource GlassIconImageStyle}">
        <Setter Property="Width" Value="19"/>
        <Setter Property="Height" Value="19"/>
        <Setter Property="Opacity" Value="0.82"/>
    </Style>

    <Style x:Key="GlassAnimatedIconImageStyle" TargetType="{x:Type Image}" BasedOn="{StaticResource GlassIconImageStyle}">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                         To="1.08" Duration="0:0:1.8">
                            <DoubleAnimation.EasingFunction>
                                <SineEase EasingMode="EaseInOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                         To="1.08" Duration="0:0:1.8">
                            <DoubleAnimation.EasingFunction>
                                <SineEase EasingMode="EaseInOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ModernOutlinedButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#30FFFFFF"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppGlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#52FFFFFF"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ModernTextButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="GlassDangerButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ModernOutlinedButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource AppDangerSoftBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}"/>
        <Setter Property="BorderBrush" Value="#66D9485C"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#38D9485C"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AppDangerBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AppRaisedButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ModernButtonStyle}"/>
    <Style x:Key="AppOutlinedButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ModernOutlinedButtonStyle}"/>
    <Style x:Key="AppTextButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ModernTextButtonStyle}"/>

    <Style x:Key="AppAttachmentButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ModernOutlinedButtonStyle}">
        <Setter Property="MinWidth" Value="150"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="GlassNavigationListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="16,13"/>
        <Setter Property="Margin" Value="18,0,18,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="MinHeight" Value="52"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid>
                        <Border x:Name="SelectedGlow"
                                Background="{StaticResource GlassPrimaryGradientBrush}"
                                CornerRadius="19"
                                Opacity="0"
                                Margin="0,5,0,-5"/>
                        <Border x:Name="ListBoxItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ListBoxItemBorder" Property="Background" Value="{StaticResource GlassShellChromeHoverBrush}"/>
                            <Setter TargetName="ListBoxItemBorder" Property="BorderBrush" Value="{StaticResource GlassShellBorderBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ListBoxItemBorder" Property="Background" Value="{StaticResource GlassPrimaryGradientBrush}"/>
                            <Setter TargetName="ListBoxItemBorder" Property="BorderBrush" Value="#66FFFFFF"/>
                            <Setter TargetName="SelectedGlow" Property="Opacity" Value="0.28"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                         To="1.018" Duration="0:0:0.16"/>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                         To="1.018" Duration="0:0:0.16"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                         To="1" Duration="0:0:0.18"/>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                         To="1" Duration="0:0:0.18"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="CheckMarkBox"
                                Width="19"
                                Height="19"
                                CornerRadius="5"
                                Background="#24FFFFFF"
                                BorderBrush="{DynamicResource AppGlassBorderBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="CheckGlyph"
                                       Text="&#xE73E;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Opacity="0"/>
                        </Border>
                        <ContentPresenter Margin="10,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckMarkBox" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMarkBox" Property="Background" Value="{StaticResource GlassPrimaryGradientBrush}"/>
                            <Setter TargetName="CheckGlyph" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type GroupBox}">
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassShellBorderBrush}"/>
        <Setter Property="Background" Value="{StaticResource GlassCardBrush}"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <ContentPresenter ContentSource="Header"
                                              DockPanel.Dock="Top"
                                              Margin="0,0,0,12"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{DynamicResource AppMutedTextBrush}"
                                              TextElement.FontWeight="SemiBold"/>
                            <ContentPresenter/>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppDataGridColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="#16FFFFFF"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        <Setter Property="BorderBrush" Value="#2CFFFFFF"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppDataGridCellStyle" TargetType="{x:Type DataGridCell}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="#20FFFFFF"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridCell}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource GlassTableSelectedBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AppDataGridRowStyle" TargetType="{x:Type DataGridRow}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Style.Triggers>
            <Trigger Property="AlternationIndex" Value="1">
                <Setter Property="Background" Value="{StaticResource GlassTableRowBrush}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource GlassTableRowHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource GlassTableSelectedBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AppDataGridRowHeaderStyle" TargetType="{x:Type DataGridRowHeader}">
        <Setter Property="Width" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style TargetType="{x:Type DataGrid}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="#70FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#24FFFFFF"/>
        <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="AlternationCount" Value="2"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeight" Value="44"/>
        <Setter Property="ColumnHeaderHeight" Value="46"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="RowStyle" Value="{StaticResource AppDataGridRowStyle}"/>
        <Setter Property="CellStyle" Value="{StaticResource AppDataGridCellStyle}"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource AppDataGridColumnHeaderStyle}"/>
        <Setter Property="RowHeaderStyle" Value="{StaticResource AppDataGridRowHeaderStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGrid}">
                    <Border x:Name="DataGridBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="18"
                            ClipToBounds="True"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="DG_ScrollViewer" Focusable="False">
                            <ScrollViewer.Template>
                                <ControlTemplate TargetType="{x:Type ScrollViewer}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Button Command="{x:Static DataGrid.SelectAllCommand}"
                                                Focusable="False"
                                                Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.All}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                Width="{Binding CellsPanelHorizontalOffset, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"/>
                                        <DataGridColumnHeadersPresenter Grid.Column="1"
                                                                        Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.Column}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"/>
                                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                                Grid.Row="1"
                                                                Grid.ColumnSpan="2"
                                                                CanContentScroll="{TemplateBinding CanContentScroll}"/>
                                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                                   Grid.Row="1"
                                                   Grid.Column="2"
                                                   Maximum="{TemplateBinding ScrollableHeight}"
                                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                                   Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                                        <ScrollBar x:Name="PART_HorizontalScrollBar"
                                                   Grid.Row="2"
                                                   Grid.Column="1"
                                                   Maximum="{TemplateBinding ScrollableWidth}"
                                                   Orientation="Horizontal"
                                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                                   Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                                    </Grid>
                                </ControlTemplate>
                            </ScrollViewer.Template>
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource AppDataGridColumnHeaderStyle}"/>
    <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource AppDataGridCellStyle}"/>
    <Style TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource AppDataGridRowStyle}"/>
    <Style TargetType="{x:Type DataGridRowHeader}" BasedOn="{StaticResource AppDataGridRowHeaderStyle}"/>

    <!-- ═══════════════════════════════════════════════════════════════
         APPLE-STYLE COMPONENT STYLES (used by SettingsWindow and others)
    ═══════════════════════════════════════════════════════════════════ -->

    <!-- AppleCard: glass card panel (like GlassDialogCardStyle but with margin) -->
    <Style x:Key="AppleCard" TargetType="{x:Type Border}" BasedOn="{StaticResource ModernCardStyle}">
        <Setter Property="Margin" Value="0,0,0,14"/>
        <Setter Property="Padding" Value="22"/>
        <Setter Property="CornerRadius" Value="20"/>
    </Style>

    <!-- AppleStatsCard: compact metric tile -->
    <Style x:Key="AppleStatsCard" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource GlassCardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassShellBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.10" Color="#7B91B2"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- AppleBadge: small pill/chip indicator -->
    <Style x:Key="AppleBadge" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="10,4"/>
    </Style>

    <!-- StatusDotGreen: glowing green status indicator for Ellipse -->
    <Style x:Key="StatusDotGreen" TargetType="{x:Type Ellipse}">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="Fill" Value="#2ECC71"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.7" Color="#2ECC71"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- AppleSegmentedRoot: background container for segmented tab control -->
    <Style x:Key="AppleSegmentedRoot" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#24FFFFFF"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassShellBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="4"/>
    </Style>

    <!-- AppleSegmentedItem: RadioButton styled as an iOS-style segmented tab -->
    <Style x:Key="AppleSegmentedItem" TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border x:Name="SegBorder"
                            Background="Transparent"
                            CornerRadius="11"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SegBorder" Property="Background" Value="#28FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SegBorder" Property="Background" Value="{StaticResource GlassPrimaryGradientBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- AppleToggleSwitch: CheckBox styled as iOS-style toggle switch -->
    <Style x:Key="AppleToggleSwitch" TargetType="{x:Type CheckBox}">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Border x:Name="TrackBorder"
                            Width="46"
                            Height="26"
                            CornerRadius="13"
                            Background="#50FFFFFF"
                            BorderBrush="{StaticResource GlassShellBorderBrush}"
                            BorderThickness="1">
                        <Border x:Name="Thumb"
                                Width="20"
                                Height="20"
                                CornerRadius="10"
                                Background="White"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="2,0,0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.25" Color="#000000"/>
                            </Border.Effect>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="TrackBorder" Property="Background" Value="{StaticResource GlassPrimaryGradientBrush}"/>
                            <Setter TargetName="TrackBorder" Property="BorderBrush" Value="Transparent"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- AppleStepperRoot: container for +/- stepper control -->
    <Style x:Key="AppleStepperRoot" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#24FFFFFF"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassShellBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="4"/>
    </Style>

    <!-- AppleStepperButton: +/- stepper button -->
    <Style x:Key="AppleStepperButton" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Background" Value="{StaticResource GlassShellChromeBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassShellBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="StepBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="9">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="StepBorder" Property="Background" Value="{StaticResource GlassShellChromeHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="StepBorder" Property="Opacity" Value="0.82"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="StepBorder" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- AppleGhostButton: transparent outlined ghost button -->
    <Style x:Key="AppleGhostButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassShellBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="GhostBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="GhostBorder" Property="Background" Value="{StaticResource GlassShellChromeBrush}"/>
                            <Setter TargetName="GhostBorder" Property="BorderBrush" Value="{StaticResource GlassShellChromeHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="GhostBorder" Property="Opacity" Value="0.82"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="GhostBorder" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ApplePrimaryButton: full-width gradient primary button -->
    <Style x:Key="ApplePrimaryButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource GlassPrimaryGradientBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#5AFFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="18,8"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="PrimaryBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PrimaryBorder" Property="Background" Value="{StaticResource GlassPrimaryHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PrimaryBorder" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PrimaryBorder" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


</ResourceDictionary>
