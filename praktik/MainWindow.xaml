<UserControl x:Class="praktik.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:praktik"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Background="{DynamicResource AppBackgroundBrush}">
    <materialDesign:DrawerHost IsLeftDrawerOpen="{Binding ElementName=MenuToggleButton, Path=IsChecked}"
                      IsRightDrawerOpen="{Binding ElementName=HelpButton, Path=IsChecked}">
        <materialDesign:DrawerHost.RightDrawerContent>
            <DockPanel Width="350" Margin="16">
                <TextBlock Text="Справка по функциям" Style="{StaticResource HeaderTextStyle}" DockPanel.Dock="Top"/>
                <Button x:Name="btnCloseHelp" Content="ЗАКРЫТЬ" 
                      Click="BtnCloseHelp_Click"
                      Style="{StaticResource MaterialDesignRaisedButton}"
                      Margin="0,16,0,0"
                      DockPanel.Dock="Bottom"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,16">
                    <StackPanel x:Name="HelpContent">
                        <Expander x:Name="HelpHomeExpander" Header="Главная" IsExpanded="False" Margin="0,0,0,8">
                            <TextBlock TextWrapping="Wrap">
                                Главная страница приложения, показывающая общую статистику:<LineBreak/>
                                • Общее количество задач<LineBreak/>
                                • Количество завершенных задач<LineBreak/>
                                • Количество просроченных задач<LineBreak/>
                                • Количество активных бригад<LineBreak/>
                                • Последние отчеты по задачам
                            </TextBlock>
                        </Expander>

                        <Expander x:Name="HelpSitesExpander" Header="Стройплощадки" IsExpanded="False" Margin="0,0,0,8">
                            <TextBlock TextWrapping="Wrap">
                                Управление объектами строительства:<LineBreak/>
                                • Просмотр списка стройплощадок<LineBreak/>
                                • Добавление новых объектов<LineBreak/>
                                • Редактирование существующих объектов<LineBreak/>
                                • Удаление объектов
                            </TextBlock>
                        </Expander>

                        <Expander x:Name="HelpCrewsExpander" Header="Бригады" IsExpanded="False" Margin="0,0,0,8">
                            <TextBlock TextWrapping="Wrap">
                                Управление строительными бригадами:<LineBreak/>
                                • Просмотр списка бригад<LineBreak/>
                                • Добавление новых бригад<LineBreak/>
                                • Назначение бригадира<LineBreak/>
                                • Редактирование информации о бригаде<LineBreak/>
                                • Удаление бригады
                            </TextBlock>
                        </Expander>

                        <Expander x:Name="HelpTasksExpander" Header="Задачи" IsExpanded="False" Margin="0,0,0,8">
                            <TextBlock TextWrapping="Wrap">
                                Управление задачами для бригад:<LineBreak/>
                                • Просмотр списка всех задач<LineBreak/>
                                • Фильтрация задач по объекту и бригаде<LineBreak/>
                                • Добавление новых задач<LineBreak/>
                                • Редактирование задач<LineBreak/>
                                • Изменение статуса задачи<LineBreak/>
                                • Удаление задач<LineBreak/><LineBreak/>
                                
                                Кнопка "Сбросить фильтр" очищает все примененные фильтры и показывает все задачи.
                            </TextBlock>
                        </Expander>

                        <Expander x:Name="HelpCalendarExpander" Header="Календарь" IsExpanded="False" Margin="0,0,0,8">
                            <TextBlock TextWrapping="Wrap">
                                Календарный вид задач:<LineBreak/>
                                • Выбор даты для просмотра задач<LineBreak/>
                                • Фильтрация задач по объекту и бригаде<LineBreak/>
                                • Просмотр задач на выбранную дату<LineBreak/>
                                • Визуальное представление графика работ
                            </TextBlock>
                        </Expander>

                        <Expander x:Name="HelpReportsExpander" Header="Отчеты" IsExpanded="False" Margin="0,0,0,8">
                            <TextBlock TextWrapping="Wrap">
                                Формирование и экспорт отчетов:<LineBreak/>
                                • Отчет "Задачи по объектам" - статистика задач в разрезе объектов<LineBreak/>
                                • Отчет "Выполнение по бригадам" - статистика выполнения задач бригадами<LineBreak/>
                                • Отчет "Просроченные задачи" - список просроченных задач<LineBreak/><LineBreak/>
                                
                                Экспорт отчетов:<LineBreak/>
                                • CSV - экспорт в формате с разделителями для Excel<LineBreak/>
                                • Excel - экспорт в табличный формат<LineBreak/>
                                • PDF - экспорт в текстовый формат<LineBreak/><LineBreak/>
                                
                                При экспорте сохраняется текущий выбранный тип отчета.
                            </TextBlock>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </materialDesign:DrawerHost.RightDrawerContent>

        <materialDesign:DrawerHost.LeftDrawerContent>
            <DockPanel MinWidth="220" Background="{DynamicResource AppNavigationBrush}">
                <ToggleButton Style="{StaticResource MaterialDesignHamburgerToggleButton}" 
                            DockPanel.Dock="Top"
                            HorizontalAlignment="Right" Margin="16"
                            IsChecked="{Binding ElementName=MenuToggleButton, Path=IsChecked, Mode=TwoWay}" />

                <ListBox x:Name="NavigationListBox" SelectionChanged="NavigationListBox_SelectionChanged" Margin="0,16,0,16">
                    <ListBoxItem x:Name="DashboardMenuItem">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ViewDashboard" Width="24" Height="24" VerticalAlignment="Center"/>
                            <TextBlock Text="Главная" Margin="16,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="SitesMenuItem">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Domain" Width="24" Height="24" VerticalAlignment="Center"/>
                            <TextBlock Text="Стройплощадки" Margin="16,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="CrewsMenuItem">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountGroup" Width="24" Height="24" VerticalAlignment="Center"/>
                            <TextBlock Text="Бригады" Margin="16,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="TasksMenuItem">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ClipboardList" Width="24" Height="24" VerticalAlignment="Center"/>
                            <TextBlock Text="Задачи" Margin="16,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="CalendarMenuItem">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Calendar" Width="24" Height="24" VerticalAlignment="Center"/>
                            <TextBlock Text="Календарь" Margin="16,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="ReportsMenuItem">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileDocument" Width="24" Height="24" VerticalAlignment="Center"/>
                            <TextBlock Text="Отчёты" Margin="16,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="MaterialRequestsMenuItem">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PackageVariant" Width="24" Height="24" VerticalAlignment="Center"/>
                            <TextBlock Text="Заявки на материалы" Margin="16,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="RolesMenuItem">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ShieldAccount" Width="24" Height="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="Управление пользователями" Margin="16,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="DailyPlanMenuItem">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CalendarCheck" Width="24" Height="24" VerticalAlignment="Center"/>
                            <TextBlock Text="План на день" Margin="16,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </materialDesign:DrawerHost.LeftDrawerContent>

        <DockPanel>
            <materialDesign:ColorZone Padding="16" materialDesign:ElevationAssist.Elevation="Dp4"
                                    Mode="PrimaryMid" DockPanel.Dock="Top">
                <DockPanel>
                    <ToggleButton x:Name="MenuToggleButton"
                                Style="{StaticResource MaterialDesignHamburgerToggleButton}" />

                    <TextBlock x:Name="PageTitle" Text="Главная" 
                             Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                             VerticalAlignment="Center" Margin="16,0"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border Background="{DynamicResource PrimaryHueDarkBrush}" CornerRadius="4" Margin="0,0,16,0" Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Account" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="White"/>
                                <TextBlock x:Name="UserInfo" Text="Загрузка..." 
                                         VerticalAlignment="Center" Foreground="White" Margin="0,0,8,0"/>
                                <Button x:Name="LogoutBtn" 
                                      Style="{StaticResource MaterialDesignFlatButton}"
                                      Height="24" Padding="4,0"
                                      ToolTip="Выйти из аккаунта"
                                      Foreground="White">
                                    <materialDesign:PackIcon Kind="Logout" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <Button x:Name="btnQuickThemeToggle"
                                ToolTip="Быстрое переключение темы"
                                Margin="0,0,16,0"
                                Click="BtnQuickThemeToggle_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="8">
                            <materialDesign:PackIcon x:Name="QuickThemeToggleIcon" Kind="WeatherNight" />
                        </Button>

                        <Button x:Name="btnOpenSettings"
                                ToolTip="Настройки"
                                Margin="0,0,16,0"
                                Click="BtnOpenSettings_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="8">
                            <materialDesign:PackIcon Kind="CogOutline" />
                        </Button>

                        <Button x:Name="btnScanQR" 
                                ToolTip="Сканировать QR-код"
                                Margin="0,0,16,0"
                                Click="BtnScanQR_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="8">
                            <materialDesign:PackIcon Kind="QrcodeScan" />
                        </Button>
                        <ToggleButton x:Name="HelpButton" 
                                    Style="{StaticResource MaterialDesignActionToggleButton}"
                                    ToolTip="Справка по функциям"
                                    Margin="0,0,16,0">
                            <materialDesign:PackIcon Kind="HelpCircleOutline" />
                        </ToggleButton>
                        <Button Content="ЗАКРЫТЬ" Click="MenuExit_Click" 
                              Style="{StaticResource MaterialDesignOutlinedButton}"/>
                    </StackPanel>
                </DockPanel>
            </materialDesign:ColorZone>

            <Grid x:Name="MainContent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="43*"/>
                    <ColumnDefinition Width="1357*"/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="DashboardContent" Visibility="Visible" Grid.ColumnSpan="2">
                    <ScrollViewer>
                        <StackPanel Margin="24">
                            <TextBlock Text="Обзор системы" Style="{StaticResource HeaderTextStyle}"/>

                            <UniformGrid Columns="4" Margin="0,16">
                                <materialDesign:Card Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="ClipboardList" Width="48" Height="48" 
                                                               Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                        <TextBlock x:Name="TotalTasksCount" Text="0" FontSize="32" FontWeight="Bold" 
                                                 HorizontalAlignment="Center"/>
                                        <TextBlock Text="Всего задач" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </materialDesign:Card>

                                <materialDesign:Card Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="CheckCircle" Width="48" Height="48" 
                                                               Foreground="Green"/>
                                        <TextBlock x:Name="CompletedTasksCount" Text="0" FontSize="32" FontWeight="Bold" 
                                                 HorizontalAlignment="Center"/>
                                        <TextBlock Text="Завершено" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </materialDesign:Card>

                                <materialDesign:Card Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="AlertCircle" Width="48" Height="48" 
                                                               Foreground="Orange"/>
                                        <TextBlock x:Name="OverdueTasksCount" Text="0" FontSize="32" FontWeight="Bold" 
                                                 HorizontalAlignment="Center"/>
                                        <TextBlock Text="Просрочено" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </materialDesign:Card>

                                <materialDesign:Card Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="AccountGroup" Width="48" Height="48" 
                                                               Foreground="{DynamicResource SecondaryHueMidBrush}"/>
                                        <TextBlock x:Name="ActiveCrewsCount" Text="0" FontSize="32" FontWeight="Bold" 
                                                 HorizontalAlignment="Center"/>
                                        <TextBlock Text="Активных бригад" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </materialDesign:Card>
                            </UniformGrid>

                            <materialDesign:Card Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="Последние отчёты" Style="{StaticResource SubHeaderTextStyle}"/>
                                    <DataGrid x:Name="RecentReportsGrid" AutoGenerateColumns="False" 
                                            CanUserAddRows="False" MaxHeight="300">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Задача" Binding="{Binding TaskTitle}" Width="*"/>
                                            <DataGridTextColumn Header="Автор" Binding="{Binding ReporterName}" Width="150"/>
                                            <DataGridTextColumn Header="Дата" Binding="{Binding ReportedAt, StringFormat=dd.MM.yyyy HH:mm}" Width="130"/>
                                            <DataGridTextColumn Header="Комментарий" Binding="{Binding ReportText}" Width="*"/>
                                            <DataGridTemplateColumn Header="Вложение" Width="200" MinWidth="200">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="Открыть вложение"
                                                                Click="BtnOpenTaskReportAttachment_Click"
                                                                HorizontalAlignment="Center">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource AppAttachmentButtonStyle}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasAttachment}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </materialDesign:Card>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="SitesContent" Visibility="Collapsed" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="350"/>
                    </Grid.ColumnDefinitions>

                    <materialDesign:Card Style="{StaticResource CardStyle}" Grid.Column="0">
                        <StackPanel>
                            <TextBlock Text="Стройплощадки" Style="{StaticResource SubHeaderTextStyle}"/>
                            <DataGrid x:Name="dgSites" AutoGenerateColumns="False" IsReadOnly="True" 
                                    SelectionChanged="DgSites_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Название" Binding="{Binding SiteName}" Width="*"/>
                                    <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Style="{StaticResource CardStyle}" Grid.Column="1">
                        <StackPanel>
                            <TextBlock Text="Управление стройплощадкой" Style="{StaticResource SubHeaderTextStyle}"/>

                            <TextBox x:Name="txtSiteName" 
                                   materialDesign:HintAssist.Hint="Название стройплощадки"
                                   Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                   Margin="0,0,0,16"/>

                            <TextBox x:Name="txtSiteAddress" 
                                   materialDesign:HintAssist.Hint="Адрес"
                                   Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                   Margin="0,0,0,24"/>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button x:Name="btnAddSite" Content="ДОБАВИТЬ" 
                                          Click="BtnAddSite_Click" 
                                          Style="{StaticResource MaterialDesignRaisedButton}"
                                          Width="110"
                                          Margin="0,0,8,0"/>
                                    <Button x:Name="btnUpdateSite" Content="ОБНОВИТЬ" 
                                          Click="BtnUpdateSite_Click" 
                                          Style="{StaticResource MaterialDesignOutlinedButton}"
                                          Width="110"/>
                                </StackPanel>
                                <Button x:Name="btnDeleteSite" Content="УДАЛИТЬ" 
                                      Click="BtnDeleteSite_Click" 
                                      Width="110"
                                      HorizontalAlignment="Left"
                                      Style="{StaticResource MaterialDesignOutlinedButton}"/>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>

                <Grid x:Name="CrewsContent" Visibility="Collapsed" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="350"/>
                    </Grid.ColumnDefinitions>

                    <materialDesign:Card Style="{StaticResource CardStyle}" Grid.Column="0">
                        <StackPanel>
                            <TextBlock Text="Бригады" Style="{StaticResource SubHeaderTextStyle}"/>
                            <DataGrid x:Name="dgCrews" AutoGenerateColumns="False" IsReadOnly="True" 
                                    SelectionChanged="DgCrews_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Название бригады" Binding="{Binding CrewName}" Width="*"/>
                                    <DataGridTextColumn Header="Бригадир" Binding="{Binding Brigadier.Username}" Width="200"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Style="{StaticResource CardStyle}" Grid.Column="1">
                        <StackPanel>
                            <TextBlock Text="Управление бригадой" Style="{StaticResource SubHeaderTextStyle}"/>

                            <TextBox x:Name="txtCrewName" 
                                   materialDesign:HintAssist.Hint="Название бригады"
                                   Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                   Margin="0,0,0,16"/>

                            <ComboBox x:Name="cbBrigadiers" 
                                     materialDesign:HintAssist.Hint="Бригадир"
                                     Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                     DisplayMemberPath="Username"
                                     Margin="0,0,0,24"/>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button x:Name="btnAddCrew" Content="ДОБАВИТЬ" 
                                          Click="BtnAddCrew_Click" 
                                          Style="{StaticResource MaterialDesignRaisedButton}"
                                          Width="110"
                                          Margin="0,0,8,0"/>
                                    <Button x:Name="btnUpdateCrew" Content="ОБНОВИТЬ" 
                                          Click="BtnUpdateCrew_Click" 
                                          Style="{StaticResource MaterialDesignOutlinedButton}"
                                          Width="110"/>
                                </StackPanel>
                                <Button x:Name="btnDeleteCrew" Content="УДАЛИТЬ" 
                                      Click="BtnDeleteCrew_Click" 
                                      Width="110"
                                      HorizontalAlignment="Left"
                                      Margin="0,0,0,8"
                                      Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                <Button x:Name="btnCrewMembers" Content="СОСТАВ БРИГАДЫ"
                                      Click="BtnCrewMembers_Click"
                                      Width="170"
                                      HorizontalAlignment="Left"
                                      Style="{StaticResource MaterialDesignOutlinedButton}"/>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>

                <Grid x:Name="TasksContent" Visibility="Collapsed" Grid.ColumnSpan="2">
                    <Grid x:Name="StandardTasksPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                    <materialDesign:Card Style="{StaticResource CardStyle}" Grid.Row="0">
                        <WrapPanel>
                            <TextBox x:Name="txtTaskSearch"
                                     materialDesign:HintAssist.Hint="Поиск по названию"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Width="220"
                                     Margin="0,0,12,12"
                                     TextChanged="TaskSearch_TextChanged"/>
                            <ComboBox x:Name="cbSiteFilter" 
                                      materialDesign:HintAssist.Hint="Объект"
                                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                      DisplayMemberPath="SiteName"
                                      Width="180"
                                      Margin="0,0,12,12"
                                      SelectionChanged="TaskFilter_Changed"/>
                            <ComboBox x:Name="cbCrewFilter" 
                                      materialDesign:HintAssist.Hint="Бригада"
                                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                      DisplayMemberPath="CrewName"
                                      Width="180"
                                      Margin="0,0,12,12"
                                      SelectionChanged="TaskFilter_Changed"/>
                            <ComboBox x:Name="cbStatusFilter" 
                                      materialDesign:HintAssist.Hint="Статус"
                                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                      DisplayMemberPath="TaskStatusName"
                                      Width="160"
                                      Margin="0,0,12,12"
                                      SelectionChanged="TaskFilter_Changed"/>
                            <ComboBox x:Name="cbPriorityFilter" 
                                      materialDesign:HintAssist.Hint="Приоритет"
                                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                      DisplayMemberPath="PriorityName"
                                      Width="160"
                                      Margin="0,0,12,12"
                                      SelectionChanged="TaskFilter_Changed"/>
                            <ComboBox x:Name="cbTaskScopeFilter"
                                      materialDesign:HintAssist.Hint="Тип списка"
                                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                      Width="200"
                                      Margin="0,0,12,12"
                                      SelectionChanged="TaskFilter_Changed">
                                <ComboBoxItem Content="Все задачи" Tag="all" />
                                <ComboBoxItem Content="Только активные" Tag="active" />
                                <ComboBoxItem Content="Только завершенные" Tag="completed" />
                                <ComboBoxItem Content="Только просроченные" Tag="overdue" />
                            </ComboBox>
                            <Button x:Name="btnResetTaskFilter" Content="СБРОСИТЬ ФИЛЬТРЫ" 
                                    Click="BtnResetTaskFilter_Click" 
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Margin="0,4,0,12"/>
                        </WrapPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Style="{StaticResource CardStyle}" Grid.Row="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Задачи" Style="{StaticResource SubHeaderTextStyle}"/>
                            <DataGrid x:Name="dgTasks" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                    SelectionChanged="DgTasks_SelectionChanged" SelectionMode="Extended"
                                    MouseDoubleClick="DgTasks_MouseDoubleClick"
                                    ContextMenuOpening="DgTasks_ContextMenuOpening"
                                    ScrollViewer.VerticalScrollBarVisibility="Visible"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    Margin="0,0,0,8">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="DgTasksRow_PreviewMouseRightButtonDown"/>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.ContextMenu>
                                    <ContextMenu Background="{DynamicResource AppSurfaceBrush}"
                                                 BorderBrush="{DynamicResource AppBorderBrush}"
                                                 BorderThickness="1"
                                                 Padding="6"
                                                 HasDropShadow="True">
                                        <ContextMenu.Template>
                                            <ControlTemplate TargetType="{x:Type ContextMenu}">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="8"
                                                        Padding="{TemplateBinding Padding}">
                                                    <StackPanel IsItemsHost="True"
                                                                KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ContextMenu.Template>
                                        <ContextMenu.Resources>
                                            <Style x:Key="CompactTaskMenuItemStyle" TargetType="{x:Type MenuItem}">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                                                <Setter Property="FontSize" Value="13"/>
                                                <Setter Property="FontFamily" Value="Segoe UI"/>
                                                <Setter Property="Padding" Value="12,7"/>
                                                <Setter Property="Margin" Value="0"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type MenuItem}">
                                                            <Border x:Name="MenuItemBorder"
                                                                    Background="{TemplateBinding Background}"
                                                                    CornerRadius="5"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <ContentPresenter Grid.Column="0"
                                                                                      ContentSource="Icon"
                                                                                      VerticalAlignment="Center"
                                                                                      Margin="0,0,10,0"/>
                                                                    <ContentPresenter Grid.Column="1"
                                                                                      ContentSource="Header"
                                                                                      RecognizesAccessKey="True"
                                                                                      VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsHighlighted" Value="True">
                                                                    <Setter TargetName="MenuItemBorder" Property="Background" Value="{DynamicResource AppSelectionBrush}"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource AppSelectionTextBrush}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter Property="Opacity" Value="0.55"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ContextMenu.Resources>
                                        <MenuItem Style="{StaticResource CompactTaskMenuItemStyle}"
                                                  Click="TaskQrMenuItem_Click">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="Qrcode"
                                                                         Width="15"
                                                                         Height="15"
                                                                         Foreground="{DynamicResource AppMutedTextBrush}"/>
                                            </MenuItem.Icon>
                                            <MenuItem.Header>
                                                <TextBlock Text="&#x41E;&#x442;&#x43A;&#x440;&#x44B;&#x442;&#x44C; QR-&#x43A;&#x43E;&#x434;"/>
                                            </MenuItem.Header>
                                        </MenuItem>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/>
                                    <DataGridTextColumn Header="Объект" Binding="{Binding Site.SiteName}" Width="150"/>
                                    <DataGridTextColumn Header="Бригада" Binding="{Binding Crew.CrewName}" Width="150"/>
                                    <DataGridTextColumn Header="Приоритет" Binding="{Binding Priority.PriorityName}" Width="100"/>
                                    <DataGridTextColumn Header="Статус" Binding="{Binding TaskStatus.TaskStatusName}" Width="120"/>
                                    <DataGridTextColumn Header="Начало" Binding="{Binding StartDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                                    <DataGridTextColumn Header="Окончание" Binding="{Binding EndDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                                    <DataGridTemplateColumn Header="Действия" Width="200">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding LastNoteText}" 
                                                          TextWrapping="Wrap" 
                                                          FontSize="11"
                                                          Foreground="{DynamicResource AppMutedTextBrush}"
                                                          Padding="4,2"
                                                          ToolTip="{Binding LastNoteTooltip}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Grid.Row="2" x:Name="txtTaskFilterNoResults"
                                       Text="Подходящих задач не найдено"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                       HorizontalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </materialDesign:Card>

                    <materialDesign:Card Style="{StaticResource CardStyle}" Grid.Row="2">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="btnAddTask" Content="ДОБАВИТЬ ЗАДАЧУ" 
                                      Click="BtnAddTask_Click" 
                                      Style="{StaticResource MaterialDesignRaisedButton}"
                                      Width="180"
                                      Margin="0,0,16,0"/>
                                <Button x:Name="btnUpdateTask" Content="РЕДАКТИРОВАТЬ" 
                                      Click="BtnUpdateTask_Click" 
                                      Style="{StaticResource MaterialDesignOutlinedButton}"
                                      Width="180"
                                      Margin="0,0,16,0"/>
                                <Button x:Name="btnDuplicateTask" Content="ДУБЛИРОВАТЬ" 
                                      Click="BtnDuplicateTask_Click" 
                                      Style="{StaticResource MaterialDesignOutlinedButton}"
                                      Width="160"
                                      Margin="0,0,16,0"/>
                                <Button x:Name="btnDeleteTask" Content="УДАЛИТЬ" 
                                      Click="BtnDeleteTask_Click" 
                                      Style="{StaticResource MaterialDesignOutlinedButton}"
                                      Width="110"
                                      Margin="0,0,16,0"/>
                                <Button x:Name="btnUpdateStatus" Content="ИЗМЕНИТЬ СТАТУС" 
                                      Click="BtnUpdateStatus_Click" 
                                      Width="180"
                                      Margin="0,0,16,0"
                                      Style="{StaticResource MaterialDesignRaisedButton}"/>
                                <Button x:Name="btnPrintTask" Content="ПЕЧАТЬ" 
                                      Click="BtnPrintTask_Click" 
                                      Width="120"
                                      Style="{StaticResource MaterialDesignOutlinedButton}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </materialDesign:Card>

                    </Grid>

                    <Grid x:Name="BrigadierTasksPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <materialDesign:Card Style="{StaticResource CardStyle}" Grid.Row="0">
                            <StackPanel>
                                <TextBlock Text="Чек-лист бригадира" Style="{StaticResource SubHeaderTextStyle}"/>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="← День"
                                            Click="BtnBrigadierChecklistPrevDay_Click"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Margin="0,0,12,8"/>
                                    <DatePicker x:Name="dpBrigadierChecklistDate"
                                                SelectedDateChanged="DpBrigadierChecklistDate_SelectedDateChanged"
                                                Width="160"
                                                Margin="0,0,12,8"/>
                                    <Button Content="Сегодня"
                                            Click="BtnBrigadierChecklistToday_Click"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Margin="0,0,12,8"/>
                                    <Button Content="День →"
                                            Click="BtnBrigadierChecklistNextDay_Click"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Margin="0,0,12,8"/>
                                </WrapPanel>
                                <TextBlock x:Name="txtBrigadierWeekRange"
                                           Margin="0,0,0,4"
                                           Foreground="{DynamicResource AppMutedTextBrush}"/>
                                <TextBlock x:Name="txtBrigadierTaskSummary"
                                           Margin="0,4,0,0"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextBrush}"/>
                            </StackPanel>
                        </materialDesign:Card>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock x:Name="txtBrigadierChecklistEmpty"
                                           Text="На выбранную дату задач нет."
                                           Margin="0,0,0,16"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                           Visibility="Collapsed"/>
                                <ItemsControl x:Name="icBrigadierTasks">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <materialDesign:Card Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <StackPanel Grid.Row="0">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="18"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AppTextBrush}"/>
                                                        <TextBlock Text="{Binding DescriptionPreview}"
                                                                   Margin="0,6,0,0"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource AppMutedTextBrush}"/>
                                                    </StackPanel>

                                                    <WrapPanel Grid.Row="1" Margin="0,16,0,0">
                                                        <Border Background="{DynamicResource AppPanelBrush}" CornerRadius="10" Padding="10,6" Margin="0,0,8,8">
                                                            <TextBlock Text="{Binding SiteName}" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <Border Background="{DynamicResource AppPanelBrush}" CornerRadius="10" Padding="10,6" Margin="0,0,8,8">
                                                            <TextBlock Text="{Binding CrewName}" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <Border Background="{DynamicResource AppPanelBrush}" CornerRadius="10" Padding="10,6" Margin="0,0,8,8">
                                                            <TextBlock Text="{Binding PriorityName}" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <Border Background="{DynamicResource AppPanelBrush}" CornerRadius="10" Padding="10,6" Margin="0,0,8,8">
                                                            <TextBlock Text="{Binding DateRangeText}" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <Border CornerRadius="10" Padding="10,6" Margin="0,0,8,8">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource AppPanelBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                            <Setter Property="Background" Value="#F9D3D3"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding ChecklistStatusText}" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <!-- Значок из плана диспетчера -->
                                                        <Border Background="#E3F2FD" CornerRadius="10" Padding="10,6"
                                                                Margin="0,0,8,8"
                                                                Visibility="{Binding PlanOrderBadgeVisibility}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="CalendarCheck"
                                                                                         Width="14" Height="14"
                                                                                         Foreground="#1565C0"
                                                                                         VerticalAlignment="Center"
                                                                                         Margin="0,0,4,0"/>
                                                                <TextBlock Text="{Binding PlanOrderText}"
                                                                           Foreground="#1565C0"
                                                                           FontWeight="SemiBold"
                                                                           FontSize="12"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </WrapPanel>

                                                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                                        <!-- Заметка диспетчера из плана -->
                                                        <Border Background="#EEF4FF" CornerRadius="6"
                                                                Padding="10,6" Margin="0,0,0,10"
                                                                Visibility="{Binding PlanNoteVisibility}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="NoteText" Width="14" Height="14"
                                                                                         Foreground="#3949AB"
                                                                                         VerticalAlignment="Center"
                                                                                         Margin="0,0,6,0"/>
                                                                <TextBlock Text="{Binding PlanNote}"
                                                                           Foreground="#3949AB"
                                                                           FontSize="12"
                                                                           TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <CheckBox Content="Задача выполнена"
                                                                  IsChecked="{Binding IsMarkedCompleted, Mode=TwoWay}"
                                                                  FontWeight="SemiBold"
                                                                  FontSize="15"
                                                                  Margin="0,0,0,4"/>
                                                        <TextBlock Text="Комментарий обязателен, если задача не выполнена."
                                                                   Margin="0,6,0,8"
                                                                   Foreground="{DynamicResource AppMutedTextBrush}"/>
                                                        <TextBlock Text="Последняя заметка"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AppTextBrush}"/>
                                                        <TextBlock Text="{Binding LastNoteText}"
                                                                   Margin="0,4,0,12"
                                                                   TextWrapping="Wrap"
                                                                   ToolTip="{Binding LastNoteTooltip}"
                                                                   Foreground="{DynamicResource AppMutedTextBrush}"/>
                                                        <TextBox Text="{Binding CompletionComment, UpdateSourceTrigger=PropertyChanged}"
                                                                 AcceptsReturn="True"
                                                                 TextWrapping="Wrap"
                                                                 MinHeight="80"
                                                                 VerticalScrollBarVisibility="Auto"
                                                                 materialDesign:HintAssist.Hint="Комментарий / причина переноса"
                                                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="3"
                                                                Margin="0,16,0,0"
                                                                Orientation="Horizontal"
                                                                HorizontalAlignment="Right">
                                                        <Button Content="Открыть задачу"
                                                                Tag="{Binding TaskId}"
                                                                Click="BtnBrigadierOpenTask_Click"
                                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                                Margin="0,0,12,0"/>
                                                        <Button Content="Сохранить отметку"
                                                                Tag="{Binding}"
                                                                Click="BtnSaveBrigadierChecklistDecision_Click"
                                                                Style="{StaticResource MaterialDesignRaisedButton}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </materialDesign:Card>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <Grid x:Name="CalendarContent" Visibility="Collapsed" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <materialDesign:Card Style="{StaticResource CardStyle}" Grid.Column="0">
                        <StackPanel>
                            <TextBlock Text="Календарь задач" Style="{StaticResource SubHeaderTextStyle}"/>

                            <Calendar x:Name="TaskCalendar" 
                                    Loaded="TaskCalendar_Loaded"
                                    DisplayDateChanged="TaskCalendar_DisplayDateChanged"
                                    SelectedDatesChanged="TaskCalendar_SelectedDatesChanged"
                                    Margin="0,16,0,16"/>

                            <ComboBox x:Name="cbCalendarSiteFilter" 
                                     materialDesign:HintAssist.Hint="Фильтр по объекту"
                                     Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                     DisplayMemberPath="SiteName" 
                                     Margin="0,0,0,16"
                                     SelectionChanged="CalendarFilter_Changed"/>

                            <ComboBox x:Name="cbCalendarCrewFilter" 
                                     materialDesign:HintAssist.Hint="Фильтр по бригаде"
                                     Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                     DisplayMemberPath="CrewName" 
                                     Margin="0,0,0,16"
                                     SelectionChanged="CalendarFilter_Changed"/>

                            <Button Content="СБРОСИТЬ ФИЛЬТРЫ" 
                                  Click="BtnResetCalendarFilters_Click"
                                  Style="{StaticResource MaterialDesignOutlinedButton}"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Style="{StaticResource CardStyle}" Grid.Column="1">
                        <StackPanel>
                            <TextBlock x:Name="SelectedDateText" Text="Выберите дату" 
                                     Style="{StaticResource SubHeaderTextStyle}"/>

                            <DataGrid x:Name="dgCalendarTasks" AutoGenerateColumns="False" 
                                    CanUserAddRows="False" Margin="0,16,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/>
                                    <DataGridTextColumn Header="Объект" Binding="{Binding Site.SiteName}" Width="150"/>
                                    <DataGridTextColumn Header="Бригада" Binding="{Binding Crew.CrewName}" Width="150"/>
                                    <DataGridTextColumn Header="Статус" Binding="{Binding TaskStatus.TaskStatusName}" Width="120"/>
                                    <DataGridTextColumn Header="Приоритет" Binding="{Binding Priority.PriorityName}" Width="100"/>
                                    <DataGridTextColumn Header="Начало" Binding="{Binding StartDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                                    <DataGridTextColumn Header="Окончание" Binding="{Binding EndDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>

                <Grid x:Name="ReportsContent" Visibility="Collapsed" Grid.ColumnSpan="2">
                    <Border Margin="24"
                            Padding="18"
                            CornerRadius="26"
                            Background="{DynamicResource AppSurfaceBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Padding="12,10"
                                    CornerRadius="16"
                                    Background="{DynamicResource AppPanelBrush}"
                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                    BorderThickness="1">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="ChartBar" Width="18" Height="18" Margin="0,0,10,0" Foreground="{DynamicResource AppAccentBrush}"/>
                                    <TextBlock Text="Аналитика по задачам"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppTextBrush}"/>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="250"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Padding="24"
                                    CornerRadius="18"
                                    Background="{DynamicResource AppSurfaceAltBrush}"
                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Выбор отчёта"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppTextBrush}"/>
                                        <TextBlock Text="Тип отчёта:"
                                                   Margin="0,16,0,6"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource AppMutedTextBrush}"/>
                                        <ComboBox x:Name="cbReportTypeSelector"
                                                  Height="36"
                                                  SelectedIndex="0"
                                                  Background="{DynamicResource AppInputBackgroundBrush}"
                                                  BorderBrush="{DynamicResource AppBorderBrush}"
                                                  BorderThickness="1"
                                                  Foreground="{DynamicResource AppTextBrush}"
                                                  Padding="8,4">
                                            <ComboBoxItem Content="Общий список задач" Tag="tasks"/>
                                            <ComboBoxItem Content="Задачи по объектам" Tag="tasks_by_site"/>
                                            <ComboBoxItem Content="Выполнение по бригадам" Tag="tasks_by_crew"/>
                                            <ComboBoxItem Content="Просроченные задачи" Tag="overdue_tasks"/>
                                        </ComboBox>

                                        <TextBlock Text="Тип диаграммы:"
                                                   Margin="0,14,0,6"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource AppMutedTextBrush}"/>
                                        <ComboBox x:Name="cbReportChartType"
                                                  Height="36"
                                                  SelectedIndex="0"
                                                  Background="{DynamicResource AppInputBackgroundBrush}"
                                                  BorderBrush="{DynamicResource AppBorderBrush}"
                                                  BorderThickness="1"
                                                  Foreground="{DynamicResource AppTextBrush}"
                                                  Padding="8,4">
                                            <ComboBoxItem Content="Гистограмма" Tag="bar"/>
                                            <ComboBoxItem Content="Круговая диаграмма" Tag="pie"/>
                                            <ComboBoxItem Content="Линейный график" Tag="line"/>
                                        </ComboBox>

                                        <Button x:Name="btnGenerateSelectedReport"
                                                Content="Сгенерировать отчёт"
                                                Click="BtnGenerateSelectedReport_Click"
                                                Height="38"
                                                Margin="0,16,0,0"
                                                Style="{StaticResource ModernButtonStyle}"/>
                                    </StackPanel>

                                    <Border Grid.Row="1"
                                            Margin="0,24,0,0"
                                            Padding="16"
                                            CornerRadius="16"
                                            Background="{DynamicResource AppPanelBrush}"
                                            BorderBrush="{DynamicResource AppBorderBrush}"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="Экспорт"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppTextBrush}"/>
                                            <TextBlock Text="Экспортировать как:"
                                                       Margin="0,12,0,6"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource AppMutedTextBrush}"/>
                                            <ComboBox x:Name="cbReportExportFormat"
                                                      Height="36"
                                                      SelectedIndex="0"
                                                      Background="{DynamicResource AppInputBackgroundBrush}"
                                                      BorderBrush="{DynamicResource AppBorderBrush}"
                                                      BorderThickness="1"
                                                      Foreground="{DynamicResource AppTextBrush}"
                                                      Padding="8,4">
                                                <ComboBoxItem Content="PNG" Tag="png"/>
                                                <ComboBoxItem Content="CSV" Tag="csv"/>
                                                <ComboBoxItem Content="Excel" Tag="excel"/>
                                                <ComboBoxItem Content="PDF" Tag="pdf"/>
                                            </ComboBox>

                                            <Button x:Name="btnExportSelectedReport"
                                                    Content="Экспортировать"
                                                    Click="BtnExportSelectedReport_Click"
                                                    Height="38"
                                                    Margin="0,16,0,0"
                                                    Style="{StaticResource ModernOutlinedButtonStyle}"/>

                                            <TextBlock Text="Справа показывается текущий график по выбранному срезу. Экспорт сохраняет именно эту выборку."
                                                       Margin="0,18,0,0"
                                                       TextWrapping="Wrap"
                                                       FontSize="11"
                                                        Foreground="{DynamicResource AppSubtleTextBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2"
                                    Padding="20"
                                    CornerRadius="18"
                                    Background="{DynamicResource AppSurfaceAltBrush}"
                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="0"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock x:Name="ReportTitle"
                                               Text="Общий список задач"
                                               HorizontalAlignment="Center"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppTextBrush}"/>
                                    <TextBlock x:Name="ReportSubtitle"
                                               Grid.Row="1"
                                               Margin="0,6,0,0"
                                               HorizontalAlignment="Center"
                                               FontSize="12"
                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                               Text="Сводка по задачам и текущему состоянию исполнения."/>
                                    <TextBlock x:Name="ReportTableCaption"
                                               Grid.Row="2"
                                               Margin="0,8,0,0"
                                               HorizontalAlignment="Center"
                                               FontSize="11"
                                               Foreground="{DynamicResource AppSubtleTextBrush}"
                                               Text="Выберите параметры слева и сформируйте отчёт."/>

                                    <Border x:Name="ReportPreviewHost"
                                            Grid.Row="3"
                                            Margin="0,18,0,0"
                                            Padding="14"
                                            MinHeight="320"
                                            CornerRadius="18"
                                            Background="{DynamicResource AppSurfaceBrush}"
                                            BorderBrush="{DynamicResource AppBorderBrush}"
                                            BorderThickness="1"
                                            SizeChanged="ReportPreviewHost_SizeChanged">
                                        <Canvas x:Name="ReportPreviewCanvas"/>
                                    </Border>

                                    <UniformGrid Grid.Row="4" Columns="3" Margin="0,18,0,0">
                                        <Border Margin="0,0,10,0"
                                                Padding="12"
                                                CornerRadius="14"
                                                Background="{DynamicResource AppPanelBrush}"
                                                BorderBrush="{DynamicResource AppBorderBrush}"
                                                BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock x:Name="ReportMetricPrimaryValue" Text="0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}"/>
                                                <TextBlock x:Name="ReportMetricPrimaryLabel" Text="Всего записей" Margin="0,4,0,0" Foreground="{DynamicResource AppMutedTextBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="0,0,10,0"
                                                Padding="12"
                                                CornerRadius="14"
                                                Background="{DynamicResource AppPanelBrush}"
                                                BorderBrush="{DynamicResource AppBorderBrush}"
                                                BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock x:Name="ReportMetricSecondaryValue" Text="0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/>
                                                <TextBlock x:Name="ReportMetricSecondaryLabel" Text="Ключевой показатель" Margin="0,4,0,0" Foreground="{DynamicResource AppMutedTextBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Padding="12"
                                                CornerRadius="14"
                                                Background="{DynamicResource AppPanelBrush}"
                                                BorderBrush="{DynamicResource AppBorderBrush}"
                                                BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock x:Name="ReportMetricTertiaryValue" Text="0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}"/>
                                                <TextBlock x:Name="ReportMetricTertiaryLabel" Text="Доп. показатель" Margin="0,4,0,0" Foreground="{DynamicResource AppMutedTextBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <WrapPanel x:Name="ReportLegendPanel" Grid.Row="5" Margin="0,18,0,0">
                                        <Border x:Name="ReportLegendRow1"
                                                Margin="0,0,10,10"
                                                Padding="10,6"
                                                CornerRadius="14"
                                                Background="{DynamicResource AppPanelBrush}"
                                                BorderBrush="{DynamicResource AppBorderBrush}"
                                                BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <Border x:Name="ReportLegendSwatch1" Width="10" Height="10" CornerRadius="5" Background="#B47A4F" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="ReportLegendLabel1" Text="Сегмент 1" Foreground="{DynamicResource AppMutedTextBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="  "/>
                                                <TextBlock x:Name="ReportLegendValue1" Text="0" Foreground="{DynamicResource AppTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="ReportLegendRow2"
                                                Margin="0,0,10,10"
                                                Padding="10,6"
                                                CornerRadius="14"
                                                Background="{DynamicResource AppPanelBrush}"
                                                BorderBrush="{DynamicResource AppBorderBrush}"
                                                BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <Border x:Name="ReportLegendSwatch2" Width="10" Height="10" CornerRadius="5" Background="#D1A16A" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="ReportLegendLabel2" Text="Сегмент 2" Foreground="{DynamicResource AppMutedTextBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="  "/>
                                                <TextBlock x:Name="ReportLegendValue2" Text="0" Foreground="{DynamicResource AppTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="ReportLegendRow3"
                                                Margin="0,0,10,10"
                                                Padding="10,6"
                                                CornerRadius="14"
                                                Background="{DynamicResource AppPanelBrush}"
                                                BorderBrush="{DynamicResource AppBorderBrush}"
                                                BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <Border x:Name="ReportLegendSwatch3" Width="10" Height="10" CornerRadius="5" Background="#8B5C43" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="ReportLegendLabel3" Text="Сегмент 3" Foreground="{DynamicResource AppMutedTextBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="  "/>
                                                <TextBlock x:Name="ReportLegendValue3" Text="0" Foreground="{DynamicResource AppTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>

                                    <DataGrid Grid.Row="6"
                                              x:Name="dgReports"
                                              Visibility="Collapsed"
                                              AutoGenerateColumns="True"
                                              AutoGeneratedColumns="DgReports_AutoGeneratedColumns"
                                              CanUserAddRows="False"
                                              CanUserResizeRows="False"
                                              CanUserReorderColumns="False"
                                              IsReadOnly="True"
                                              HeadersVisibility="Column"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="MaterialRequestsContent" Visibility="Collapsed" Grid.ColumnSpan="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*" MinHeight="200"/>
                        <RowDefinition Height="Auto" MinHeight="350" MaxHeight="400"/>
                    </Grid.RowDefinitions>

                            <materialDesign:Card Margin="0,0,0,12">
                        <StackPanel Margin="16">
                            <TextBlock Text="Фильтры" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="cbMRStatusFilter" Grid.Column="0" 
                                          materialDesign:HintAssist.Hint="Статус"
                                          Margin="0,0,8,0" SelectionChanged="MRFilter_Changed">
                                    <ComboBoxItem Content="Все" IsSelected="True"/>
                                    <ComboBoxItem Content="Отправлена" Tag="Submitted"/>
                                    <ComboBoxItem Content="Согласована" Tag="Approved"/>
                                    <ComboBoxItem Content="Отклонена" Tag="Rejected"/>
                                    <ComboBoxItem Content="Выдана" Tag="Issued"/>
                                    <ComboBoxItem Content="Доставлена" Tag="Delivered"/>
                                    <ComboBoxItem Content="Закрыта" Tag="Closed"/>
                                </ComboBox>
                                <ComboBox x:Name="cbMRSiteFilter" Grid.Column="1" 
                                          materialDesign:HintAssist.Hint="Объект"
                                          DisplayMemberPath="SiteName" Margin="0,0,8,0" SelectionChanged="MRFilter_Changed"/>
                                <ComboBox x:Name="cbMRCrewFilter" Grid.Column="2" 
                                          materialDesign:HintAssist.Hint="Бригада"
                                          DisplayMemberPath="CrewName" Margin="0,0,8,0" SelectionChanged="MRFilter_Changed"/>
                                <DatePicker x:Name="dpMRRequiredDateFilter" Grid.Column="3" 
                                          materialDesign:HintAssist.Hint="Требуется к (от)"
                                          Margin="0,0,8,0" SelectedDateChanged="MRFilter_Changed"/>
                                <Button x:Name="btnMRResetFilter" Grid.Column="4" Content="Сбросить" 
                                       Click="BtnMRResetFilter_Click" Style="{StaticResource MaterialDesignOutlinedButton}"
                                       Margin="0,0,8,0" Width="120" Height="40"/>
                                <Button x:Name="btnMRAddRequest" Grid.Column="5" Content="Добавить заявку" 
                                       Click="BtnMRAddRequest_Click" Style="{StaticResource MaterialDesignRaisedButton}"
                                       Width="180" Height="40"/>
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>

                    <Grid Grid.Row="1" Margin="16,0,16,8">
                        <DataGrid x:Name="dgMaterialRequests" AutoGenerateColumns="False" IsReadOnly="True" 
                                 SelectionChanged="DgMaterialRequests_SelectionChanged" 
                                 MouseDoubleClick="DgMaterialRequests_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding RequestId}" Width="60"/>
                                <DataGridTextColumn Header="Задача" Binding="{Binding TaskTitle}" Width="*"/>
                                <DataGridTextColumn Header="Объект" Binding="{Binding SiteName}" Width="150"/>
                                <DataGridTextColumn Header="Бригада" Binding="{Binding CrewName}" Width="150"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding StatusDisplay}" Width="120"/>
                                <DataGridTextColumn Header="Требуется к" Binding="{Binding RequiredDateDisplay}" Width="120"/>
                                <DataGridTextColumn Header="Создана" Binding="{Binding CreatedAtDisplay}" Width="130"/>
                                <DataGridTextColumn Header="Позиций" Binding="{Binding ItemsCount}" Width="80"/>
                                <DataGridTemplateColumn Header="Индикатор" Width="230" MinWidth="230">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="4,2">
                                                <Border Background="{Binding IndicatorColor}" Padding="16,6" CornerRadius="2" 
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                        Width="160">
                                                    <TextBlock Text="{Binding IndicatorText}" Foreground="White" FontWeight="Bold" 
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                              FontSize="11" TextWrapping="NoWrap"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                    </DataGridTemplateColumn.CellStyle>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border x:Name="MaterialRequestsPlaceholder" Background="{DynamicResource AppSurfaceAltBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8"
                                Padding="24" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="HardHat" Width="64" Height="64" Foreground="{DynamicResource AppAccentBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Здесь пока нет заявок" Margin="0,12,0,4" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Создайте заявку, и бригадир проверит её здесь" FontSize="13" Foreground="{DynamicResource AppMutedTextBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="280"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <materialDesign:Card x:Name="cardMRDetailsPanel" Grid.Row="2" Margin="16,0,16,16" Visibility="Collapsed">
                        <Grid Margin="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock x:Name="txtMRSelectedInfo" Text="Выберите заявку для просмотра деталей" 
                                          TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <DataGrid x:Name="dgMRItems" AutoGenerateColumns="False" IsReadOnly="True" 
                                         MaxHeight="80" Visibility="Collapsed">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Материал" Binding="{Binding Material.Name}" Width="*"/>
                                        <DataGridTextColumn Header="Ед. изм." Binding="{Binding Material.Unit}" Width="80"/>
                                        <DataGridTextColumn Header="Количество" Binding="{Binding Qty}" Width="100"/>
                                        <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Vertical">
                                <Button x:Name="btnMRApprove" Content="Согласовать" 
                                       Click="BtnMRApprove_Click" Style="{StaticResource MaterialDesignRaisedButton}"
                                       Margin="0,0,0,8" Width="200" Height="40"/>
                                <Button x:Name="btnMRReject" Content="Отклонить" 
                                       Click="BtnMRReject_Click" Style="{StaticResource MaterialDesignOutlinedButton}"
                                       Margin="0,0,0,8" Width="200" Height="40"/>
                                <Button x:Name="btnMRIssue" Content="Отметить выдачу" 
                                       Click="BtnMRIssue_Click" Style="{StaticResource MaterialDesignRaisedButton}"
                                       Margin="0,0,0,8" Width="200" Height="40"/>
                                <Button x:Name="btnMRDeliver" Content="Отметить доставку" 
                                       Click="BtnMRDeliver_Click" Style="{StaticResource MaterialDesignRaisedButton}"
                                       Margin="0,0,0,8" Width="200" Height="40"/>
                                <Button x:Name="btnMRClose" Content="Закрыть заявку" 
                                       Click="BtnMRClose_Click" Style="{StaticResource MaterialDesignOutlinedButton}"
                                       Margin="0,0,0,8" Width="200" Height="40"/>
                                <Button x:Name="btnMREdit" Content="Редактировать" 
                                       Click="BtnMREdit_Click" Style="{StaticResource MaterialDesignOutlinedButton}"
                                       Margin="0,0,0,8" Width="200" Height="40"/>
                                <Button x:Name="btnMRExport" Content="Экспорт" 
                                       Click="BtnMRExport_Click" Style="{StaticResource MaterialDesignRaisedButton}"
                                       Width="200" Height="40"/>
                            </StackPanel>
                        </Grid>
                    </materialDesign:Card>
                </Grid>

                <Grid x:Name="RolesContent" Visibility="Collapsed" Grid.ColumnSpan="2" Background="{DynamicResource AppBackgroundBrush}">
                    <Grid Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="btnRoleAssignmentsView"
                                    Content="Пользователи"
                                    Click="BtnRoleAssignmentsView_Click"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Width="160"
                                    Height="38"
                                    Margin="0,0,12,0"/>
                            <Button x:Name="btnRolePermissionsView"
                                    Content="Права доступа"
                                    Click="BtnRolePermissionsView_Click"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Width="170"
                                    Height="38"/>
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <Grid x:Name="RoleAssignmentsPanel">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="1.35*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
                                    <Grid>
                                        <DataGrid
                                                  x:Name="dgRoleUsers"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  SelectionChanged="DgRoleUsers_SelectionChanged"
                                                  SelectionMode="Single"
                                                  CanUserResizeRows="False"
                                                  AlternatingRowBackground="{DynamicResource AppSurfaceAltBrush}"
                                                  GridLinesVisibility="Horizontal">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                                                <DataGridTextColumn Header="Логин" Binding="{Binding Username}" Width="170"/>
                                                <DataGridTextColumn Header="Текущая роль" Binding="{Binding Role}" Width="190"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="10"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="14"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="16"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="Действия" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}"/>
                                            <TextBlock Grid.Row="2"
                                                       x:Name="txtRoleAssignmentSummary"
                                                       Text="Выберите пользователя в таблице"
                                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Grid.Row="4"
                                                       x:Name="txtSelectedRoleUserInfo"
                                                       Text="Добавьте нового пользователя или выберите пользователя слева для редактирования или удаления."
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource AppSubtleTextBrush}"/>
                                            <Grid Grid.Row="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Column="0"
                                                        x:Name="btnAddManagedUser"
                                                        Content="Добавить"
                                                        Click="BtnAddManagedUser_Click"
                                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                                        Width="120"
                                                        Height="38"/>
                                                <Button Grid.Column="2"
                                                        x:Name="btnEditManagedUser"
                                                        Content="Редактировать"
                                                        Click="BtnEditManagedUser_Click"
                                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                                        Width="140"
                                                        Height="38"
                                                        IsEnabled="False"/>
                                                <Button Grid.Column="4"
                                                        x:Name="btnDeleteManagedUser"
                                                        Content="Удалить"
                                                        Click="BtnDeleteManagedUser_Click"
                                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                                        Width="120"
                                                        Height="38"
                                                        IsEnabled="False"/>
                                            </Grid>
                                        </Grid>
                                </Border>
                            </Grid>

                            <Grid x:Name="RolePermissionsPanel" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="12"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="Роли" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}"/>
                                        <TextBlock Grid.Row="2"
                                                   x:Name="txtRoleCatalogSummary"
                                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                                   Visibility="Collapsed"/>
                                        <DataGrid Grid.Row="4"
                                                  x:Name="dgRoles"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  SelectionChanged="DgRoles_SelectionChanged"
                                                  SelectionMode="Single"
                                                  CanUserResizeRows="False"
                                                  AlternatingRowBackground="{DynamicResource AppSurfaceAltBrush}"
                                                  GridLinesVisibility="Horizontal">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="ID" Binding="{Binding RoleId}" Width="60"/>
                                                <DataGridTextColumn Header="Название роли" Binding="{Binding RoleName}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="12"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="16"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock x:Name="txtSelectedRoleInfo"
                                                   Text="Права роли"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppTextBrush}"/>

                                        <StackPanel Grid.Row="2" Visibility="Collapsed">
                                            <TextBlock x:Name="txtRolePermissionSummary"
                                                       Text="Выберите роль слева, чтобы посмотреть и изменить ее права."
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource AppMutedTextBrush}"/>
                                        </StackPanel>

                                        <DataGrid Grid.Row="4"
                                                  x:Name="dgRolePermissions"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  HeadersVisibility="Column"
                                                  CanUserResizeRows="False"
                                                  AlternatingRowBackground="{DynamicResource AppSurfaceAltBrush}"
                                                  GridLinesVisibility="Horizontal"
                                                  CurrentCellChanged="DgRolePermissions_CurrentCellChanged">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="150" IsReadOnly="True"/>
                                                <DataGridTextColumn Header="Разрешение" Binding="{Binding DisplayName}" Width="220" IsReadOnly="True"/>
                                                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*" IsReadOnly="True"/>
                                                <DataGridCheckBoxColumn Header="Доступ" Binding="{Binding IsGranted, Mode=TwoWay}" Width="90"/>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <StackPanel Grid.Row="6" Orientation="Horizontal">
                                            <Button x:Name="btnSaveRolePermissions"
                                                    Content="Сохранить права"
                                                    Click="BtnSaveRolePermissions_Click"
                                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                                    Width="180"
                                                    Height="38"
                                                    Margin="0,0,12,0"
                                                    IsEnabled="False"/>
                                            <Button x:Name="btnReloadRoleManagement"
                                                    Content="Обновить"
                                                    Click="BtnReloadRoleManagement_Click"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    Width="140"
                                                    Height="38"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>

                        <Grid Visibility="Collapsed">
                            <TextBlock x:Name="txtRoleUsersSummary"/>
                            <TextBlock x:Name="txtRoleAccessOverview"/>
                            <TextBlock x:Name="txtRoleCreationInfo"/>
                            <ComboBox x:Name="cbRoleAssignment" SelectionChanged="CbRoleAssignment_SelectionChanged"/>
                            <Button x:Name="btnApplyUserRole" Click="BtnApplyUserRole_Click"/>
                            <TextBox x:Name="txtNewRoleName" TextChanged="TxtNewRoleName_TextChanged"/>
                            <Button x:Name="btnCreateRole" Click="BtnCreateRole_Click"/>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ===== ПЛАН НА ДЕНЬ (Диспетчер) ===== -->
                <Grid x:Name="DailyPlanContent" Visibility="Collapsed" Grid.ColumnSpan="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Шапка: выбор даты + статус плана -->
                    <materialDesign:Card Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Margin="16">
                            <WrapPanel>
                                <Button Content="← Пред."
                                        Click="BtnDailyPlanPrevDay_Click"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Margin="0,0,8,8"/>
                                <DatePicker x:Name="dpDailyPlanDate"
                                            SelectedDateChanged="DpDailyPlanDate_SelectedDateChanged"
                                            Width="160" Margin="0,0,8,8"/>
                                <Button Content="Сегодня"
                                        Click="BtnDailyPlanToday_Click"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Margin="0,0,8,8"/>
                                <Button Content="След. →"
                                        Click="BtnDailyPlanNextDay_Click"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Margin="0,0,24,8"/>
                                <Border x:Name="bdDailyPlanStatus" CornerRadius="4" Padding="12,4"
                                        Background="{DynamicResource AppPanelBrush}"
                                        VerticalAlignment="Center" Margin="0,0,0,8">
                                    <TextBlock x:Name="txtDailyPlanStatus" Text="Нет плана"
                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Border>
                            </WrapPanel>
                            <TextBlock x:Name="txtDailyPlanInfo"
                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                       FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Основная область: левая панель задач + правая панель плана -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ЛЕВАЯ: доступные задачи -->
                        <Grid Grid.Column="0" Margin="0,0,8,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <materialDesign:Card Grid.Row="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Margin="16,16,16,8">
                                        <TextBlock Text="Доступные задачи"
                                                   Style="{StaticResource SubHeaderTextStyle}"/>
                                        <TextBlock Text="Нажмите «Выбрать» на задаче, чтобы добавить её в план."
                                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                                   FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                                  Margin="8,0,8,8">
                                        <StackPanel>
                                            <TextBlock x:Name="txtNoAvailableTasks"
                                                       Text="На выбранную дату задач нет."
                                                       Margin="8,8,0,0"
                                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                                       Visibility="Collapsed"/>
                                            <ItemsControl x:Name="icAvailablePlanTasks">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <materialDesign:Card Margin="0,0,0,8" Padding="12">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>

                                                                <TextBlock Grid.Row="0"
                                                                           Text="{Binding Title}"
                                                                           FontWeight="SemiBold"
                                                                           FontSize="14"
                                                                           TextWrapping="Wrap"
                                                                           Foreground="{DynamicResource AppTextBrush}"/>

                                                                <WrapPanel Grid.Row="1" Margin="0,6,0,0">
                                                                    <Border Background="{DynamicResource AppPanelBrush}"
                                                                            CornerRadius="8" Padding="8,3" Margin="0,0,6,4">
                                                                        <TextBlock Text="{Binding SiteName}" FontSize="11"/>
                                                                    </Border>
                                                                    <Border Background="{DynamicResource AppPanelBrush}"
                                                                            CornerRadius="8" Padding="8,3" Margin="0,0,6,4">
                                                                        <TextBlock Text="{Binding PriorityName}" FontSize="11"/>
                                                                    </Border>
                                                                    <Border Background="{DynamicResource AppPanelBrush}"
                                                                            CornerRadius="8" Padding="8,3" Margin="0,0,6,4">
                                                                        <TextBlock Text="{Binding StatusName}" FontSize="11"/>
                                                                    </Border>
                                                                    <Border Background="{DynamicResource AppPanelBrush}"
                                                                            CornerRadius="8" Padding="8,3" Margin="0,0,0,4">
                                                                        <TextBlock Text="{Binding DateRange}" FontSize="11"/>
                                                                    </Border>
                                                                </WrapPanel>

                                                                <Border Grid.Row="2"
                                                                        Background="#FFF3CD"
                                                                        CornerRadius="4"
                                                                        Padding="8,4"
                                                                        Margin="0,4,0,0"
                                                                        Visibility="{Binding MaterialWarningVisibility}">
                                                                    <TextBlock Text="⚠ Материалы не готовы"
                                                                               FontSize="11"
                                                                               Foreground="#856404"/>
                                                                </Border>

                                                                <Grid Grid.Row="3" Margin="0,8,0,0">
                                                                    <Button Content="Выбрать →"
                                                                            Tag="{Binding TaskId}"
                                                                            Click="BtnSelectPlanTask_Click"
                                                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                                                            Height="28" FontSize="12"
                                                                            HorizontalAlignment="Left"
                                                                            Visibility="{Binding NotInPlanVisibility}"/>
                                                                    <StackPanel Orientation="Horizontal"
                                                                                Visibility="{Binding InPlanVisibility}"
                                                                                VerticalAlignment="Center">
                                                                        <materialDesign:PackIcon Kind="CheckCircle"
                                                                                                 Foreground="Green"
                                                                                                 Width="16" Height="16"
                                                                                                 VerticalAlignment="Center"/>
                                                                        <TextBlock Text="В плане"
                                                                                   Foreground="Green"
                                                                                   Margin="4,0"
                                                                                   VerticalAlignment="Center"
                                                                                   FontWeight="SemiBold"
                                                                                   FontSize="12"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Grid>
                                                        </materialDesign:Card>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </materialDesign:Card>

                            <!-- Панель добавления задачи в план -->
                            <materialDesign:Card Grid.Row="1"
                                                 x:Name="pnlAddToPlan"
                                                 Visibility="Collapsed"
                                                 Margin="0,8,0,0">
                                <StackPanel Margin="16">
                                    <TextBlock Text="Добавить в план"
                                               Style="{StaticResource SubHeaderTextStyle}"
                                               Margin="0,0,0,8"/>
                                    <TextBlock x:Name="txtAddToPlanTaskName"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,12"
                                               Foreground="{DynamicResource AppTextBrush}"/>
                                    <ComboBox x:Name="cbPlanCrewSelect"
                                              materialDesign:HintAssist.Hint="Бригада *"
                                              Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                              DisplayMemberPath="CrewName"
                                              Margin="0,0,0,12"/>
                                    <TextBox x:Name="txtPlanItemNote"
                                             materialDesign:HintAssist.Hint="Заметка (необязательно)"
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             Margin="0,0,0,12"/>
                                    <CheckBox x:Name="chkPlanItemMaterials"
                                              Content="Материалы готовы"
                                              IsChecked="True"
                                              Margin="0,0,0,12"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="btnConfirmAddToPlan"
                                                Content="ДОБАВИТЬ"
                                                Click="BtnConfirmAddToPlan_Click"
                                                Style="{StaticResource MaterialDesignRaisedButton}"
                                                Margin="0,0,8,0"/>
                                        <Button Content="ОТМЕНА"
                                                Click="BtnCancelAddToPlan_Click"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                    </StackPanel>
                                </StackPanel>
                            </materialDesign:Card>
                        </Grid>

                        <!-- ПРАВАЯ: план бригад -->
                        <materialDesign:Card Grid.Column="1" Margin="8,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Text="План бригад на день"
                                           Style="{StaticResource SubHeaderTextStyle}"
                                           Margin="16,16,16,8"/>
                                <ScrollViewer Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              Margin="12,0,12,12">
                                    <StackPanel>
                                        <TextBlock x:Name="txtNoPlanItems"
                                                   Text="Добавьте задачи из левой панели, чтобы сформировать план."
                                                   HorizontalAlignment="Center"
                                                   Margin="24"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                                   Visibility="Visible"/>
                                        <ItemsControl x:Name="icDailyPlanCrews">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,16"
                                                            BorderBrush="{DynamicResource AppBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8">
                                                        <StackPanel>
                                                            <!-- Заголовок бригады -->
                                                            <Border Background="{DynamicResource PrimaryHueMidBrush}"
                                                                    CornerRadius="7,7,0,0"
                                                                    Padding="16,10">
                                                                <TextBlock Text="{Binding CrewName}"
                                                                           FontWeight="Bold"
                                                                           Foreground="White"
                                                                           FontSize="14"/>
                                                            </Border>
                                                            <!-- Задачи бригады -->
                                                            <ItemsControl ItemsSource="{Binding Items}"
                                                                          Margin="8,8,8,8">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Margin="0,0,0,6"
                                                                                Background="{DynamicResource AppSurfaceBrush}"
                                                                                CornerRadius="6"
                                                                                Padding="10,8">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="32"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="150"/>
                                                                                    <ColumnDefinition Width="32"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>

                                                                                <TextBlock Grid.Column="0"
                                                                                           Text="{Binding SortOrderText}"
                                                                                           FontWeight="Bold"
                                                                                           FontSize="14"
                                                                                           Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                                                           VerticalAlignment="Center"
                                                                                           HorizontalAlignment="Center"/>

                                                                                <StackPanel Grid.Column="1" Margin="6,0">
                                                                                    <TextBlock Text="{Binding Title}"
                                                                                               FontWeight="SemiBold"
                                                                                               FontSize="13"
                                                                                               TextWrapping="Wrap"/>
                                                                                    <TextBlock Text="{Binding SiteName}"
                                                                                               FontSize="11"
                                                                                               Foreground="{DynamicResource AppMutedTextBrush}"/>
                                                                                </StackPanel>

                                                                                <TextBox Grid.Column="2"
                                                                                         Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                         materialDesign:HintAssist.Hint="Заметка"
                                                                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                                                         FontSize="11"
                                                                                         Margin="4,0"
                                                                                         VerticalAlignment="Center"/>

                                                                                <CheckBox Grid.Column="3"
                                                                                          IsChecked="{Binding MaterialsReady, Mode=TwoWay}"
                                                                                          ToolTip="Материалы готовы"
                                                                                          VerticalAlignment="Center"
                                                                                          HorizontalAlignment="Center"/>

                                                                                <StackPanel Grid.Column="4"
                                                                                            Orientation="Horizontal"
                                                                                            VerticalAlignment="Center">
                                                                                    <Button Content="↑"
                                                                                            Tag="{Binding}"
                                                                                            Click="BtnPlanItemMoveUp_Click"
                                                                                            Style="{StaticResource MaterialDesignFlatButton}"
                                                                                            Width="28" Height="28"
                                                                                            Padding="0" MinWidth="0"/>
                                                                                    <Button Content="↓"
                                                                                            Tag="{Binding}"
                                                                                            Click="BtnPlanItemMoveDown_Click"
                                                                                            Style="{StaticResource MaterialDesignFlatButton}"
                                                                                            Width="28" Height="28"
                                                                                            Padding="0" MinWidth="0"/>
                                                                                    <Button Content="✕"
                                                                                            Tag="{Binding}"
                                                                                            Click="BtnPlanItemRemove_Click"
                                                                                            Style="{StaticResource MaterialDesignFlatButton}"
                                                                                            Width="28" Height="28"
                                                                                            Padding="0" MinWidth="0"
                                                                                            Foreground="#E53935"/>
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </materialDesign:Card>
                    </Grid>

                    <!-- Нижняя панель: сохранить / утвердить -->
                    <materialDesign:Card Grid.Row="2" Margin="0,12,0,0">
                        <StackPanel Margin="16" Orientation="Horizontal">
                            <Button x:Name="btnSaveDailyPlan"
                                    Content="СОХРАНИТЬ ЧЕРНОВИК"
                                    Click="BtnSaveDailyPlan_Click"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Margin="0,0,12,0"/>
                            <Button x:Name="btnApproveDailyPlan"
                                    Content="УТВЕРДИТЬ ПЛАН"
                                    Click="BtnApproveDailyPlan_Click"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Margin="0,0,24,0"/>
                            <TextBlock x:Name="txtDailyPlanSaveStatus"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                       FontSize="12"/>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>
                <!-- ===== КОНЕЦ ПЛАНА НА ДЕНЬ ===== -->

            </Grid>
        </DockPanel>
    </materialDesign:DrawerHost>
</UserControl>
