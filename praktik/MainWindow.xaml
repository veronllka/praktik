                                Padding="24" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="HardHat" Width="64" Height="64" Foreground="#B08968" HorizontalAlignment="Center"/>
                                <TextBlock Text="Здесь пока нет заявок" Margin="0,12,0,4" FontSize="16" FontWeight="SemiBold" Foreground="#6D5E4F" HorizontalAlignment="Center"/>
                                <TextBlock Text="Создайте заявку, и бригадир проверит её здесь" FontSize="13" Foreground="#8C7A68" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="280"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <materialDesign:Card x:Name="cardMRDetailsPanel" Grid.Row="2" Margin="16,0,16,16" Visibility="Collapsed">
                        <Grid Margin="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock x:Name="txtMRSelectedInfo" Text="Выберите заявку для просмотра деталей" 
                                          TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <DataGrid x:Name="dgMRItems" AutoGenerateColumns="False" IsReadOnly="True" 
                                         MaxHeight="80" Visibility="Collapsed">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Материал" Binding="{Binding Material.Name}" Width="*"/>
                                        <DataGridTextColumn Header="Ед. изм." Binding="{Binding Material.Unit}" Width="80"/>
                                        <DataGridTextColumn Header="Количество" Binding="{Binding Qty}" Width="100"/>
                                        <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Vertical">
                                <Button x:Name="btnMRApprove" Content="Согласовать" 
                                       Click="BtnMRApprove_Click" Style="{StaticResource MaterialDesignRaisedButton}"
                                       Margin="0,0,0,8" Width="200" Height="40"/>
                                <Button x:Name="btnMRReject" Content="Отклонить" 
                                       Click="BtnMRReject_Click" Style="{StaticResource MaterialDesignOutlinedButton}"
                                       Margin="0,0,0,8" Width="200" Height="40"/>
                                <Button x:Name="btnMRIssue" Content="Отметить выдачу" 
                                       Click="BtnMRIssue_Click" Style="{StaticResource MaterialDesignRaisedButton}"
                                       Margin="0,0,0,8" Width="200" Height="40"/>
                                <Button x:Name="btnMRDeliver" Content="Отметить доставку" 
                                       Click="BtnMRDeliver_Click" Style="{StaticResource MaterialDesignRaisedButton}"
                                       Margin="0,0,0,8" Width="200" Height="40"/>
                                <Button x:Name="btnMRClose" Content="Закрыть заявку" 
                                       Click="BtnMRClose_Click" Style="{StaticResource MaterialDesignOutlinedButton}"
                                       Margin="0,0,0,8" Width="200" Height="40"/>
                                <Button x:Name="btnMREdit" Content="Редактировать" 
                                       Click="BtnMREdit_Click" Style="{StaticResource MaterialDesignOutlinedButton}"
                                       Margin="0,0,0,8" Width="200" Height="40"/>
                                <Button x:Name="btnMRExport" Content="Экспорт" 
                                       Click="BtnMRExport_Click" Style="{StaticResource MaterialDesignRaisedButton}"
                                       Width="200" Height="40"/>
                            </StackPanel>
                        </Grid>
                    </materialDesign:Card>
                </Grid>

                <Grid x:Name="RolesContent" Visibility="Collapsed" Grid.ColumnSpan="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <materialDesign:Card Grid.Row="0" Margin="16,16,16,8">
                        <Grid Margin="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Пользователи" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="0,0,0,12"/>
                                <DataGrid x:Name="dgRoleUsers"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          SelectionChanged="DgRoleUsers_SelectionChanged"
                                          Height="260">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                                        <DataGridTextColumn Header="Логин" Binding="{Binding Username}" Width="160"/>
                                        <DataGridTextColumn Header="Текущая роль" Binding="{Binding Role}" Width="170"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Назначение роли" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="0,0,0,12"/>
                                <TextBlock x:Name="txtSelectedRoleUserInfo"
                                           Text="Выберите пользователя для смены роли"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12"/>
                                <ComboBox x:Name="cbRoleAssignment"
                                          DisplayMemberPath="RoleName"
                                          materialDesign:HintAssist.Hint="Новая роль"
                                          Margin="0,0,0,12"/>
                                <Button x:Name="btnApplyUserRole"
                                        Content="Назначить роль"
                                        Click="BtnApplyUserRole_Click"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Width="180"
                                        Height="40"
                                        HorizontalAlignment="Left"/>
                                <Separator Margin="0,16,0,16"/>
                                <TextBlock Text="Создание роли" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="0,0,0,12"/>
                                <TextBox x:Name="txtNewRoleName"
                                         materialDesign:HintAssist.Hint="Название роли"
                                         Margin="0,0,0,12"/>
                                <TextBlock Text="Новая роль создается с текущим набором отмеченных разрешений."
                                           TextWrapping="Wrap"
                                           Foreground="#666666"
                                           Margin="0,0,0,12"/>
                                <Button x:Name="btnCreateRole"
                                        Content="Создать роль"
                                        Click="BtnCreateRole_Click"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Width="180"
                                        Height="40"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Grid>
                    </materialDesign:Card>

                    <materialDesign:Card Grid.Row="1" Margin="16,0,16,16">
                        <Grid Margin="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Роли" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="0,0,0,12"/>
                                <DataGrid x:Name="dgRoles"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          SelectionChanged="DgRoles_SelectionChanged"
                                          Height="360">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Binding="{Binding RoleId}" Width="60"/>
                                        <DataGridTextColumn Header="Название" Binding="{Binding RoleName}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="txtSelectedRoleInfo"
                                           Text="Выберите роль для настройки прав"
                                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                           Margin="0,0,0,12"/>
                                <DataGrid x:Name="dgRolePermissions"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          HeadersVisibility="Column"
                                          Height="360">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="140" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Разрешение" Binding="{Binding DisplayName}" Width="220" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*" IsReadOnly="True"/>
                                        <DataGridCheckBoxColumn Header="Разрешено" Binding="{Binding IsGranted, Mode=TwoWay}" Width="100"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button x:Name="btnSaveRolePermissions"
                                            Content="Сохранить права"
                                            Click="BtnSaveRolePermissions_Click"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Width="180"
                                            Height="40"
                                            Margin="0,0,12,0"/>
                                    <Button x:Name="btnReloadRoleManagement"
                                            Content="Обновить"
                                            Click="BtnReloadRoleManagement_Click"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Width="140"
                                            Height="40"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </Grid>
        </DockPanel>
    </materialDesign:DrawerHost>
</UserControl>
