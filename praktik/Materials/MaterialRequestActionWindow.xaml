<Window x:Class="praktik.MaterialRequestActionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Действие с заявкой"
        Height="320"
        Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="btnOk"
                    Content="Подтвердить"
                    Click="BtnOk_Click"
                    Width="140"
                    Height="40"
                    Margin="0,0,8,0"
                    FontSize="14"
                    FontWeight="Medium"
                    Style="{StaticResource ModernButtonStyle}"/>
            <Button x:Name="btnCancel"
                    Content="Отмена"
                    Click="BtnCancel_Click"
                    Width="140"
                    Height="40"
                    FontSize="14"
                    FontWeight="Medium"
                    Style="{StaticResource ModernOutlinedButtonStyle}"/>
        </StackPanel>

        <StackPanel>
            <TextBlock x:Name="txtTitle"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,0,16"/>

            <TextBlock x:Name="lblDocNumber"
                       Text="Номер документа:"
                       Margin="0,0,0,5"/>
            <TextBox x:Name="txtDocNumber"
                     Margin="0,0,0,16"
                     Height="30"/>

            <TextBlock x:Name="lblNote"
                       Text="Примечание:"
                       Margin="0,0,0,5"/>
            <TextBox x:Name="txtNote"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     Height="60"/>
        </StackPanel>
    </DockPanel>
</Window>
