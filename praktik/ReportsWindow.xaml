<Window x:Class="praktik.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Отчёты" Height="600" Width="900" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#F7F4EF" BorderBrush="#E4DCCF" BorderThickness="0,0,1,0">
            <StackPanel Margin="16">
                <TextBlock Text="Выбор отчёта" FontSize="18" FontWeight="SemiBold" Foreground="#6D5E4F" Margin="0,0,0,12"/>

                <TextBlock Text="Тип отчёта" FontSize="13" Foreground="#7C746A"/>
                <ComboBox x:Name="cbReportType" SelectedIndex="0" Margin="0,4,0,12">
                    <ComboBoxItem Content="Пользователи по ролям"/>
                    <ComboBoxItem Content="Задачи по объектам"/>
                    <ComboBoxItem Content="Задачи по бригадам"/>
                    <ComboBoxItem Content="Просроченные задачи"/>
                </ComboBox>

                <TextBlock Text="Тип диаграммы" FontSize="13" Foreground="#7C746A"/>
                <ComboBox x:Name="cbChartType" SelectedIndex="0" Margin="0,4,0,16">
                    <ComboBoxItem Content="Гистограмма (горизонтальная)"/>
                    <ComboBoxItem Content="Гистограмма (вертикальная)"/>
                    <ComboBoxItem Content="Круговая"/>
                </ComboBox>

                <Button Content="Сгенерировать" Click="Generate_Click" Style="{StaticResource ModernButtonStyle}" Height="40" Margin="0,0,0,12"/>

                <TextBlock Text="Экспортировать как" FontSize="13" Foreground="#7C746A"/>
                <ComboBox x:Name="cbExportFormat" SelectedIndex="0" Margin="0,4,0,12">
                    <ComboBoxItem Content="PNG"/>
                    <ComboBoxItem Content="JPEG"/>
                    <ComboBoxItem Content="CSV"/>
                </ComboBox>

                <Button Content="Экспортировать" Click="Export_Click" Style="{StaticResource ModernOutlinedButtonStyle}" Height="40"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Background="#FDFBF7">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="txtTitle" Text="Отображение отчёта" FontSize="20" FontWeight="SemiBold" Foreground="#6D5E4F"
                       Margin="16,12,16,8"/>

            <Border Grid.Row="1" x:Name="ChartBorder" Margin="16" Padding="24"
                    Background="White" BorderBrush="#E4DCCF" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Canvas x:Name="ChartCanvas"/>
                    <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="HardHat" Width="64" Height="64" Foreground="#B08968" HorizontalAlignment="Center"/>
                        <TextBlock Text="Нет данных для отображения" FontSize="16" FontWeight="SemiBold" Foreground="#6D5E4F" HorizontalAlignment="Center" Margin="0,8,0,4"/>
                        <TextBlock Text="Добавьте данные или выберите другой отчёт" Foreground="#8C7A68" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
